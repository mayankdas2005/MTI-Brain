<https://lpp.example/id/card-type/CREDIT>      a lpp:CardType ; skos:prefLabel "Credit" .
<https://lpp.example/id/card-type/DEBIT>       a lpp:CardType ; skos:prefLabel "Debit" .
<https://lpp.example/id/card-type/PIN_DEBIT>   a lpp:CardType ; skos:prefLabel "PIN Debit" .
<https://lpp.example/id/card-type/PREPAID>     a lpp:CardType ; skos:prefLabel "Prepaid" .
<https://lpp.example/id/card-type/COMMERCIAL>  a lpp:CardType ; skos:prefLabel "Commercial" .

lpp:MerchantAccount     a owl:Class ;
    rdfs:comment "Account at an acquirer holding settlements for a merchant location/division."@en .
lpp:Authorization       a owl:Class ;
    rdfs:label "Card Authorization"@en .
lpp:Settlement          a owl:Class ;
    rdfs:label "Card Settlement"@en .
