@prefix lpp:    <https://lpp.example/ontology#> .
@prefix lppid:  <https://lpp.example/id/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .

<https://lpp.example/ontology>
    a owl:Ontology ;
    rdfs:label "LPP Treasury & Payments Ontology"@en ;
    rdfs:comment "Treasury + payments ontology covering cash & balances, transactions, forecasts, debt & facilities, hedging, FX, ERP reconciliation, payments hub, card acquiring, working capital, fraud, signatories, capital allocation, pension, peers/benchmarks, macro scenarios, and ESG financing. Scoped to answer the Prompts_Retail workbook (Finance + Payments × Analyst/Manager/Director/Executive)."@en ;
    owl:versionInfo "0.2.0" .

#################################################################
# Core entities
#################################################################

lpp:Currency       a owl:Class ; rdfs:label "Currency"@en .
lpp:Company        a owl:Class ; rdfs:label "Company"@en .
lpp:Bank           a owl:Class ; rdfs:label "Bank"@en .
lpp:BankBranch     a owl:Class ; rdfs:label "Bank Branch"@en .
lpp:BankAccount    a owl:Class ; rdfs:label "Bank Account"@en .

# Account purpose specializations — drive subclass inference from the
# ACCOUNT_PURPOSE column added in lpp-schema-extensions.sql (section A).
lpp:OperatingAccount       rdfs:subClassOf lpp:BankAccount ; rdfs:label "Operating Account"@en .
lpp:CollectionAccount      rdfs:subClassOf lpp:BankAccount .
lpp:ConcentrationAccount   rdfs:subClassOf lpp:BankAccount .
lpp:DisbursementAccount    rdfs:subClassOf lpp:BankAccount .
lpp:InvestmentAccount      rdfs:subClassOf lpp:BankAccount .

#################################################################
# Financial instruments — anything that can create exposure
#################################################################

lpp:FinancialInstrument    a owl:Class ;
    rdfs:label "Financial Instrument"@en ;
    rdfs:comment "Abstract parent for anything that contributes to counterparty exposure."@en .

lpp:InvestmentInstrument   rdfs:subClassOf lpp:FinancialInstrument .
lpp:InvestmentPosition     a owl:Class ;
    rdfs:label "Investment Position"@en ;
    rdfs:comment "A holding (face/market value) of an InvestmentInstrument by a Company on a date."@en .

lpp:FxForward              rdfs:subClassOf lpp:FinancialInstrument ;
    rdfs:label "FX Forward"@en .

lpp:DerivativeMtm          a owl:Class ;
    rdfs:label "Derivative Mark-to-Market"@en ;
    rdfs:comment "Periodic valuation of a derivative deal against a counterparty bank."@en .

# Optional: instrument-type taxonomy as SKOS concepts so they are queryable
lpp:InstrumentType        a owl:Class ; rdfs:subClassOf skos:Concept .
<https://lpp.example/id/instrument-type/MMF>              a lpp:InstrumentType ; skos:prefLabel "Money Market Fund" .
<https://lpp.example/id/instrument-type/TIME_DEPOSIT>     a lpp:InstrumentType ; skos:prefLabel "Time Deposit" .
<https://lpp.example/id/instrument-type/CD>               a lpp:InstrumentType ; skos:prefLabel "Certificate of Deposit" .
<https://lpp.example/id/instrument-type/TREASURY>         a lpp:InstrumentType ; skos:prefLabel "Treasury" .
<https://lpp.example/id/instrument-type/COMMERCIAL_PAPER> a lpp:InstrumentType ; skos:prefLabel "Commercial Paper" .
<https://lpp.example/id/instrument-type/REPO>             a lpp:InstrumentType ; skos:prefLabel "Repurchase Agreement" .
<https://lpp.example/id/instrument-type/BOND>             a lpp:InstrumentType ; skos:prefLabel "Bond" .

#################################################################
# Aggregate / derived
#################################################################

lpp:CounterpartyExposure   a owl:Class ;
    rdfs:label "Counterparty Exposure (snapshot)"@en ;
    rdfs:comment "Materialized total exposure to a bank as of a date. Often derivable from instruments via SPARQL, but stored when reported."@en .

#################################################################
# Object properties (relationships — these are the joins you'll traverse)
#################################################################

lpp:hasCurrency        a owl:ObjectProperty ; rdfs:range lpp:Currency .

lpp:ownedBy            a owl:ObjectProperty ;
    rdfs:domain lpp:BankAccount ; rdfs:range lpp:Company ;
    rdfs:label "owned by"@en .

lpp:heldAt             a owl:ObjectProperty ;
    rdfs:domain lpp:BankAccount ; rdfs:range lpp:Bank ;
    rdfs:label "held at"@en ;
    rdfs:comment "Convenience shortcut: BankAccount → Bank, bypassing BankBranch."@en .

lpp:branchOf           a owl:ObjectProperty ;
    rdfs:domain lpp:BankBranch ; rdfs:range lpp:Bank .

lpp:atBranch           a owl:ObjectProperty ;
    rdfs:domain lpp:BankAccount ; rdfs:range lpp:BankBranch .

lpp:counterparty       a owl:ObjectProperty ;
    rdfs:range lpp:Bank ;
    rdfs:label "counterparty bank"@en ;
    rdfs:comment "Domain is the union of FxForward, InvestmentInstrument (issuer bank), DerivativeMtm, BankAccount (deposits)."@en .

lpp:issuerBank         a owl:ObjectProperty ;
    rdfs:subPropertyOf lpp:counterparty ;
    rdfs:domain lpp:InvestmentInstrument ; rdfs:range lpp:Bank .

lpp:hasInstrument      a owl:ObjectProperty ;
    rdfs:domain lpp:InvestmentPosition ; rdfs:range lpp:InvestmentInstrument .

lpp:heldBy             a owl:ObjectProperty ;
    rdfs:domain lpp:InvestmentPosition ; rdfs:range lpp:Company .

lpp:fundedBy           a owl:ObjectProperty ;
    rdfs:domain lpp:InvestmentPosition ; rdfs:range lpp:BankAccount .

lpp:valuesInstrument   a owl:ObjectProperty ;
    rdfs:domain lpp:DerivativeMtm ; rdfs:range lpp:FinancialInstrument .

lpp:tradedBy           a owl:ObjectProperty ;
    rdfs:range lpp:Company .

lpp:instrumentType     a owl:ObjectProperty ;
    rdfs:domain lpp:InvestmentInstrument ; rdfs:range lpp:InstrumentType .

#################################################################
# Datatype properties (literals)
#################################################################

lpp:code               a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Business key, unique within its class."@en .
lpp:name               a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:bic                a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:lei                a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:countryCode        a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:currencyCode       a owl:DatatypeProperty ; rdfs:range xsd:string .

# Monetary / temporal
lpp:amount             a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:faceAmount         a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:marketValue        a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:bookValue          a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:mtmAmount          a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:notionalAmount     a owl:DatatypeProperty ; rdfs:range xsd:decimal .

lpp:tradeDate          a owl:DatatypeProperty ; rdfs:range xsd:date .
lpp:valueDate          a owl:DatatypeProperty ; rdfs:range xsd:date .
lpp:maturityDate       a owl:DatatypeProperty ; rdfs:range xsd:date .
lpp:asOfDate           a owl:DatatypeProperty ; rdfs:range xsd:date .

lpp:status             a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:rating             a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:yieldToMaturity    a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:durationDays       a owl:DatatypeProperty ; rdfs:range xsd:decimal .

#################################################################
# v0.2 EXTENSIONS — additional domains to answer Prompts_Retail
#
# Sections:
#   A. Geography & organization
#   B. Cash balances, positions, sweeps
#   C. Transactions (payments, receipts, intercompany)
#   D. Forecasts, variance, scenarios, stress tests
#   E. Debt, facilities, covenants, commercial paper
#   F. Hedging, FX rates & exposures, interest-rate scenarios
#   G. ERP / ledger reconciliation
#   H. Working capital, invoices, vendors, customers
#   I. Bank fees, rate cards
#   J. Payments hub, exceptions, STP
#   K. Card acquiring, networks, interchange, chargebacks
#   L. Fraud, authentication, disputes, incidents
#   M. Signatories, access, audit
#   N. Capital allocation, dividends, buybacks, M&A
#   O. Credit ratings
#   P. Pension
#   Q. Peers & external benchmarks
#   R. Macro scenarios, VaR, risk
#   S. ESG / sustainability-linked financing
#################################################################

#################################################################
# A. Geography & organization
#################################################################

lpp:Region          a owl:Class ; rdfs:label "Region"@en .
lpp:Country         a owl:Class ; rdfs:label "Country"@en .
lpp:BusinessUnit    a owl:Class ; rdfs:label "Business Unit"@en .
lpp:Department      a owl:Class ; rdfs:label "Department"@en .
lpp:Channel         a owl:Class ; rdfs:label "Channel"@en ;
    rdfs:comment "Sales/payment origination channel: in-warehouse, e-commerce, membership renewal, etc."@en .

lpp:inRegion        a owl:ObjectProperty ; rdfs:range lpp:Region .
lpp:inCountry       a owl:ObjectProperty ; rdfs:range lpp:Country .
lpp:partOfRegion    a owl:ObjectProperty ; rdfs:domain lpp:Country ; rdfs:range lpp:Region .
lpp:belongsToBU     a owl:ObjectProperty ; rdfs:range lpp:BusinessUnit .
lpp:belongsToDept   a owl:ObjectProperty ; rdfs:range lpp:Department .
lpp:viaChannel      a owl:ObjectProperty ; rdfs:range lpp:Channel .

lpp:LegalEntity     rdfs:subClassOf lpp:Company ;
    rdfs:label "Legal Entity"@en .
lpp:parentEntity    a owl:ObjectProperty ;
    rdfs:domain lpp:Company ; rdfs:range lpp:Company .

#################################################################
# B. Cash balances, positions, sweeps
#################################################################

lpp:BalanceSnapshot a owl:Class ;
    rdfs:label "Balance Snapshot"@en ;
    rdfs:comment "Point-in-time balance for a bank account (opening, closing, average, available)."@en .

lpp:CashPosition    a owl:Class ;
    rdfs:label "Cash Position"@en ;
    rdfs:comment "Aggregate cash position at a level (entity, region, currency, global) for a date."@en .

lpp:SweepEvent      a owl:Class ;
    rdfs:label "Cash Sweep Event"@en ;
    rdfs:comment "Movement from a subsidiary or collection account into a concentration account, executed under a sweep rule."@en .

lpp:SweepRule       a owl:Class ;
    rdfs:label "Sweep Rule"@en ;
    rdfs:comment "Configuration governing target balance, threshold, frequency, and direction for a sweep."@en .

lpp:TargetBalance   a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:openingBalance  a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:closingBalance  a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:averageBalance  a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:availableBalance a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:ledgerBalance   a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:floatAmount     a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "Difference between ledger and available balance."@en .
lpp:idleAmount      a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:trappedCashAmount a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:minimumThreshold a owl:DatatypeProperty ; rdfs:range xsd:decimal .

lpp:forAccount      a owl:ObjectProperty ;
    rdfs:domain lpp:BalanceSnapshot ; rdfs:range lpp:BankAccount .
lpp:forEntity       a owl:ObjectProperty ; rdfs:range lpp:Company .
lpp:sourceAccount   a owl:ObjectProperty ;
    rdfs:domain lpp:SweepEvent ; rdfs:range lpp:BankAccount .
lpp:destinationAccount a owl:ObjectProperty ;
    rdfs:domain lpp:SweepEvent ; rdfs:range lpp:BankAccount .
lpp:appliesRule     a owl:ObjectProperty ;
    rdfs:domain lpp:SweepEvent ; rdfs:range lpp:SweepRule .

#################################################################
# C. Transactions — payments, receipts, intercompany
#################################################################

lpp:Transaction         a owl:Class ;
    rdfs:label "Transaction"@en ;
    rdfs:comment "Abstract parent for any monetary movement."@en .

lpp:Receipt             rdfs:subClassOf lpp:Transaction ; rdfs:label "Receipt"@en .
lpp:Disbursement        rdfs:subClassOf lpp:Transaction ; rdfs:label "Disbursement"@en .
lpp:IntercompanyTransfer rdfs:subClassOf lpp:Transaction ; rdfs:label "Intercompany Transfer"@en .

lpp:PaymentTransaction  rdfs:subClassOf lpp:Transaction ;
    rdfs:label "Payment Transaction"@en .

# Payment method specializations
lpp:WireTransfer        rdfs:subClassOf lpp:PaymentTransaction .
lpp:AchTransaction      rdfs:subClassOf lpp:PaymentTransaction .
lpp:AchDebit            rdfs:subClassOf lpp:AchTransaction .
lpp:AchCredit           rdfs:subClassOf lpp:AchTransaction .
lpp:RtpTransaction      rdfs:subClassOf lpp:PaymentTransaction .
lpp:FedNowTransaction   rdfs:subClassOf lpp:PaymentTransaction .
lpp:CheckPayment        rdfs:subClassOf lpp:PaymentTransaction .
lpp:CardTransaction     rdfs:subClassOf lpp:PaymentTransaction .
lpp:VirtualCardTransaction rdfs:subClassOf lpp:CardTransaction .
lpp:CommercialCardTransaction rdfs:subClassOf lpp:CardTransaction .
lpp:CrossBorderPayment  rdfs:subClassOf lpp:PaymentTransaction .

lpp:PaymentMethod       a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Payment Method"@en .
<https://lpp.example/id/payment-method/WIRE>     a lpp:PaymentMethod ; skos:prefLabel "Wire" .
<https://lpp.example/id/payment-method/ACH>      a lpp:PaymentMethod ; skos:prefLabel "ACH" .
<https://lpp.example/id/payment-method/RTP>      a lpp:PaymentMethod ; skos:prefLabel "Real-Time Payments" .
<https://lpp.example/id/payment-method/FEDNOW>   a lpp:PaymentMethod ; skos:prefLabel "FedNow" .
<https://lpp.example/id/payment-method/CHECK>    a lpp:PaymentMethod ; skos:prefLabel "Check" .
<https://lpp.example/id/payment-method/CARD>     a lpp:PaymentMethod ; skos:prefLabel "Card" .
<https://lpp.example/id/payment-method/VCARD>    a lpp:PaymentMethod ; skos:prefLabel "Virtual Card" .

lpp:TransactionStatus   a owl:Class ; rdfs:subClassOf skos:Concept .
<https://lpp.example/id/txn-status/INITIATED>  a lpp:TransactionStatus ; skos:prefLabel "Initiated" .
<https://lpp.example/id/txn-status/PENDING>    a lpp:TransactionStatus ; skos:prefLabel "Pending" .
<https://lpp.example/id/txn-status/SETTLED>    a lpp:TransactionStatus ; skos:prefLabel "Settled" .
<https://lpp.example/id/txn-status/REJECTED>   a lpp:TransactionStatus ; skos:prefLabel "Rejected" .
<https://lpp.example/id/txn-status/RETURNED>   a lpp:TransactionStatus ; skos:prefLabel "Returned" .
<https://lpp.example/id/txn-status/REPAIRED>   a lpp:TransactionStatus ; skos:prefLabel "Repaired" .

lpp:paymentMethod       a owl:ObjectProperty ; rdfs:range lpp:PaymentMethod .
lpp:fromAccount         a owl:ObjectProperty ;
    rdfs:domain lpp:Transaction ; rdfs:range lpp:BankAccount .
lpp:toAccount           a owl:ObjectProperty ;
    rdfs:domain lpp:Transaction ; rdfs:range lpp:BankAccount .
lpp:beneficiary         a owl:ObjectProperty ;
    rdfs:domain lpp:Transaction ; rdfs:range lpp:Company .
lpp:originator          a owl:ObjectProperty ;
    rdfs:domain lpp:Transaction ; rdfs:range lpp:Company .

lpp:initiatedAt         a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
lpp:settledAt           a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
lpp:authorizedAt        a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
lpp:batchClosedAt       a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
lpp:depositedAt         a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
lpp:rejectionReason     a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:returnReasonCode    a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "ACH return reason code (R01, R03, etc.)."@en .
lpp:reference           a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:slaBreached         a owl:DatatypeProperty ; rdfs:range xsd:boolean .

#################################################################
# D. Forecasts, variance, scenarios, stress tests
#################################################################

lpp:CashForecast        a owl:Class ; rdfs:label "Cash Forecast"@en .
lpp:ForecastLine        a owl:Class ;
    rdfs:comment "Per-period forecasted inflow/outflow for an entity, currency, and driver category."@en .
lpp:ForecastActual      a owl:Class ;
    rdfs:label "Forecast vs Actual"@en .

lpp:Scenario            a owl:Class ; rdfs:label "Scenario"@en .
lpp:StressTest          a owl:Class ; rdfs:subClassOf lpp:Scenario ;
    rdfs:label "Stress Test"@en .
lpp:ScenarioAssumption  a owl:Class .

lpp:forecastPeriod      a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Period label like 2026-W18 or 2026-Q2."@en .
lpp:forecastedInflow    a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:forecastedOutflow   a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:actualInflow        a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:actualOutflow       a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:varianceAmount      a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:variancePct         a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:driverCategory      a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "AR collections, AP disbursements, payroll, capex, tax, dividend, etc."@en .
lpp:scenarioType        a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:confidenceLevel     a owl:DatatypeProperty ; rdfs:range xsd:decimal .

lpp:forForecast         a owl:ObjectProperty ;
    rdfs:domain lpp:ForecastLine ; rdfs:range lpp:CashForecast .
lpp:underScenario       a owl:ObjectProperty ; rdfs:range lpp:Scenario .

#################################################################
# E. Debt, facilities, covenants, commercial paper
#################################################################

lpp:DebtInstrument      rdfs:subClassOf lpp:FinancialInstrument ;
    rdfs:label "Debt Instrument"@en .
lpp:CreditFacility      rdfs:subClassOf lpp:DebtInstrument .
lpp:RevolvingCreditFacility rdfs:subClassOf lpp:CreditFacility .
lpp:TermLoan            rdfs:subClassOf lpp:CreditFacility .
lpp:Bond                rdfs:subClassOf lpp:DebtInstrument .
lpp:CommercialPaperProgram rdfs:subClassOf lpp:DebtInstrument .
lpp:CommercialPaperIssuance rdfs:subClassOf lpp:DebtInstrument .
lpp:LetterOfCredit      rdfs:subClassOf lpp:DebtInstrument .

lpp:Covenant            a owl:Class ; rdfs:label "Covenant"@en .
lpp:CovenantTest        a owl:Class ;
    rdfs:comment "Periodic test of a covenant: status (pass/fail), headroom."@en .

lpp:DebtMaturity        a owl:Class ;
    rdfs:comment "Scheduled principal repayment on a debt instrument."@en .

lpp:principalAmount     a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:drawnAmount         a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:availableCapacity   a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:undrawnCommitment   a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:committedFlag       a owl:DatatypeProperty ; rdfs:range xsd:boolean .
lpp:interestRate        a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:rateType            a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "FIXED or FLOATING."@en .
lpp:rateBenchmark       a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "SOFR, EURIBOR, FED_FUNDS, etc."@en .
lpp:rateSpread          a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:allInCost           a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:expirationDate      a owl:DatatypeProperty ; rdfs:range xsd:date .
lpp:covenantThreshold   a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:covenantHeadroom    a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:covenantStatus      a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:weightedAvgRate     a owl:DatatypeProperty ; rdfs:range xsd:decimal .

lpp:hasCovenant         a owl:ObjectProperty ;
    rdfs:domain lpp:CreditFacility ; rdfs:range lpp:Covenant .
lpp:testsCovenant       a owl:ObjectProperty ;
    rdfs:domain lpp:CovenantTest ; rdfs:range lpp:Covenant .
lpp:scheduledOn         a owl:ObjectProperty ;
    rdfs:domain lpp:DebtMaturity ; rdfs:range lpp:DebtInstrument .
lpp:lender              a owl:ObjectProperty ;
    rdfs:subPropertyOf lpp:counterparty ;
    rdfs:domain lpp:DebtInstrument ; rdfs:range lpp:Bank .

#################################################################
# F. Hedging, FX rates & exposures, interest-rate scenarios
#################################################################

lpp:HedgePosition       a owl:Class ; rdfs:label "Hedge Position"@en .
lpp:FxOption            rdfs:subClassOf lpp:FinancialInstrument .
lpp:InterestRateSwap    rdfs:subClassOf lpp:FinancialInstrument .
lpp:CrossCurrencySwap   rdfs:subClassOf lpp:FinancialInstrument .
lpp:CommodityHedge      rdfs:subClassOf lpp:FinancialInstrument .

lpp:HedgeEffectiveness  a owl:Class .
lpp:FxRate              a owl:Class ; rdfs:label "FX Rate"@en .
lpp:FxExposure          a owl:Class ; rdfs:label "FX Exposure"@en .
lpp:InterestRateBenchmark a owl:Class ; rdfs:subClassOf skos:Concept .
lpp:InterestRateScenario a owl:Class .

lpp:fxRate              a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:fxRateFrom          a owl:ObjectProperty ; rdfs:range lpp:Currency .
lpp:fxRateTo            a owl:ObjectProperty ; rdfs:range lpp:Currency .
lpp:grossExposure       a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:hedgedAmount        a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:netExposure         a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:hedgeRatio          a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:effectivenessRatio  a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:exposureType        a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "TRANSLATION or TRANSACTION."@en .
lpp:tenor               a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:rateShockBps        a owl:DatatypeProperty ; rdfs:range xsd:decimal .

lpp:exposureCurrency    a owl:ObjectProperty ;
    rdfs:domain lpp:FxExposure ; rdfs:range lpp:Currency .
lpp:hedges              a owl:ObjectProperty ;
    rdfs:domain lpp:HedgePosition ; rdfs:range lpp:FxExposure .

#################################################################
# G. ERP / ledger reconciliation
#################################################################

lpp:LedgerEntry         a owl:Class ;
    rdfs:label "ERP Ledger Entry"@en .
lpp:ReconciliationItem  a owl:Class ;
    rdfs:label "Reconciliation Item"@en ;
    rdfs:comment "Discrepancy between a bank balance/transaction and the ERP ledger record."@en .

lpp:ledgerAccount       a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:discrepancyAmount   a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:reconciliationStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:rootCause           a owl:DatatypeProperty ; rdfs:range xsd:string .

lpp:bankSide            a owl:ObjectProperty ;
    rdfs:domain lpp:ReconciliationItem ; rdfs:range lpp:Transaction .
lpp:ledgerSide          a owl:ObjectProperty ;
    rdfs:domain lpp:ReconciliationItem ; rdfs:range lpp:LedgerEntry .

#################################################################
# H. Working capital, invoices, vendors, customers
#################################################################

lpp:Counterparty        a owl:Class ;
    rdfs:label "Counterparty (non-bank)"@en .
lpp:Vendor              rdfs:subClassOf lpp:Counterparty .
lpp:Supplier            rdfs:subClassOf lpp:Vendor .
lpp:Customer            rdfs:subClassOf lpp:Counterparty .
lpp:Member              rdfs:subClassOf lpp:Customer .

lpp:Invoice             a owl:Class ; rdfs:label "Invoice"@en .
lpp:Receivable          rdfs:subClassOf lpp:Invoice .
lpp:Payable             rdfs:subClassOf lpp:Invoice .

lpp:CashApplication     a owl:Class ;
    rdfs:comment "Matching of an incoming receipt to one or more receivables."@en .
lpp:EarlyPaymentDiscount a owl:Class .
lpp:SupplyChainFinanceProgram a owl:Class .
lpp:DynamicDiscountingProgram a owl:Class .
lpp:RebateAgreement     a owl:Class .

lpp:WorkingCapitalMetric a owl:Class ;
    rdfs:label "Working Capital Metric"@en ;
    rdfs:comment "DSO, DPO, DIO, CCC computed for an entity over a period."@en .

lpp:invoiceAmount       a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:invoiceDate         a owl:DatatypeProperty ; rdfs:range xsd:date .
lpp:dueDate             a owl:DatatypeProperty ; rdfs:range xsd:date .
lpp:paidDate            a owl:DatatypeProperty ; rdfs:range xsd:date .
lpp:paymentTerms        a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "e.g. NET30, NET45, 2/10 NET30."@en .
lpp:discountCaptured    a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:rebateEarned        a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:dsoDays             a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:dpoDays             a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:dioDays             a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:onTimePaymentRate   a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:appliedAmount       a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:unappliedAmount     a owl:DatatypeProperty ; rdfs:range xsd:decimal .

lpp:billedTo            a owl:ObjectProperty ;
    rdfs:domain lpp:Receivable ; rdfs:range lpp:Customer .
lpp:billedFrom          a owl:ObjectProperty ;
    rdfs:domain lpp:Payable ; rdfs:range lpp:Vendor .
lpp:settles             a owl:ObjectProperty ;
    rdfs:domain lpp:PaymentTransaction ; rdfs:range lpp:Invoice .

