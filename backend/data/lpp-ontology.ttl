# R. Macro scenarios, VaR, risk
#################################################################

lpp:MacroScenario       rdfs:subClassOf lpp:Scenario ;
    rdfs:label "Macro Scenario"@en ;
    rdfs:comment "Recession, supply-chain disruption, oil shock, pandemic, geopolitical event, etc."@en .

lpp:VaRMetric           a owl:Class ;
    rdfs:label "Value-at-Risk Metric"@en .
lpp:RiskCategory        a owl:Class ; rdfs:subClassOf skos:Concept .
<https://lpp.example/id/risk/FX>           a lpp:RiskCategory ; skos:prefLabel "FX Risk" .
<https://lpp.example/id/risk/INTEREST>     a lpp:RiskCategory ; skos:prefLabel "Interest Rate Risk" .
<https://lpp.example/id/risk/COMMODITY>    a lpp:RiskCategory ; skos:prefLabel "Commodity Risk" .
<https://lpp.example/id/risk/COUNTERPARTY> a lpp:RiskCategory ; skos:prefLabel "Counterparty Risk" .
<https://lpp.example/id/risk/CYBER>        a lpp:RiskCategory ; skos:prefLabel "Cyber Risk" .
<https://lpp.example/id/risk/SETTLEMENT>   a lpp:RiskCategory ; skos:prefLabel "Settlement Risk" .

lpp:varAmount           a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:horizonDays         a owl:DatatypeProperty ; rdfs:range xsd:integer .
lpp:earningsImpact      a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:cashFlowImpact      a owl:DatatypeProperty ; rdfs:range xsd:decimal .

lpp:forRiskCategory     a owl:ObjectProperty ;
    rdfs:domain lpp:VaRMetric ; rdfs:range lpp:RiskCategory .

