lpp:FraudLossEvent      a owl:Class ; rdfs:label "Fraud Loss Event"@en .
lpp:FraudCategory       a owl:Class ; rdfs:subClassOf skos:Concept .
<https://lpp.example/id/fraud-cat/FRIENDLY>    a lpp:FraudCategory ; skos:prefLabel "Friendly Fraud" .
<https://lpp.example/id/fraud-cat/TRUE>        a lpp:FraudCategory ; skos:prefLabel "True Fraud" .
<https://lpp.example/id/fraud-cat/MERCHANT_ERR> a lpp:FraudCategory ; skos:prefLabel "Merchant Error" .

lpp:AuthenticationMethod a owl:Class ; rdfs:subClassOf skos:Concept .
<https://lpp.example/id/auth/3DS>      a lpp:AuthenticationMethod ; skos:prefLabel "3DS" .
<https://lpp.example/id/auth/NO_3DS>   a lpp:AuthenticationMethod ; skos:prefLabel "No 3DS" .

lpp:OperationalLossEvent a owl:Class .
lpp:PaymentIncident     a owl:Class ;
    rdfs:comment "Outage, settlement delay, sanctions hit, large reconciliation break, etc."@en .

lpp:fraudLossAmount     a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:fraudCategoryLabel  a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:deviceFingerprint   a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:incidentImpact      a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:incidentDate        a owl:DatatypeProperty ; rdfs:range xsd:date .
lpp:remediationStatus   a owl:DatatypeProperty ; rdfs:range xsd:string .

lpp:fraudCategory       a owl:ObjectProperty ;
    rdfs:domain lpp:FraudLossEvent ; rdfs:range lpp:FraudCategory .
lpp:authenticatedVia    a owl:ObjectProperty ;
    rdfs:domain lpp:CardTransaction ; rdfs:range lpp:AuthenticationMethod .
lpp:relatedToTransaction a owl:ObjectProperty ;
    rdfs:domain lpp:FraudLossEvent ; rdfs:range lpp:Transaction .

