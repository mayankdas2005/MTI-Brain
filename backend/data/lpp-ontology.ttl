lpp:NetworkAssessment   rdfs:subClassOf lpp:BankFee .
lpp:ProcessorFee        rdfs:subClassOf lpp:BankFee .

lpp:Chargeback          a owl:Class ; rdfs:label "Chargeback"@en .
lpp:ChargebackReason    a owl:Class ; rdfs:subClassOf skos:Concept .
lpp:Refund              a owl:Class .
lpp:MerchandiseReturn   a owl:Class .

lpp:grossSaleAmount     a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:netSettlementAmount a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:authorizationRate   a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:declineRate         a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:chargebackRate      a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:disputeWinRate      a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:interchangeAmount   a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:networkFeeAmount    a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:processorMargin     a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:ticketSize          a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:issuingBin          a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:issuingCountry      a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:dccFlag             a owl:DatatypeProperty ; rdfs:range xsd:boolean .
lpp:reasonCode          a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:rebatePercent       a owl:DatatypeProperty ; rdfs:range xsd:decimal .

lpp:processedBy         a owl:ObjectProperty ;
    rdfs:domain lpp:CardTransaction ; rdfs:range lpp:Acquirer .
lpp:onNetwork           a owl:ObjectProperty ;
    rdfs:domain lpp:CardTransaction ; rdfs:range lpp:CardNetwork .
lpp:cardType            a owl:ObjectProperty ;
    rdfs:domain lpp:CardTransaction ; rdfs:range lpp:CardType .
lpp:authorizes          a owl:ObjectProperty ;
    rdfs:domain lpp:Authorization ; rdfs:range lpp:CardTransaction .
lpp:settles_card        a owl:ObjectProperty ;
    rdfs:domain lpp:Settlement ; rdfs:range lpp:CardTransaction .
lpp:depositTo           a owl:ObjectProperty ;
    rdfs:domain lpp:Settlement ; rdfs:range lpp:BankAccount .
lpp:disputeReason       a owl:ObjectProperty ;
    rdfs:domain lpp:Chargeback ; rdfs:range lpp:ChargebackReason .
lpp:disputedTransaction a owl:ObjectProperty ;
    rdfs:domain lpp:Chargeback ; rdfs:range lpp:CardTransaction .

#################################################################
# L. Fraud, authentication, disputes, incidents
