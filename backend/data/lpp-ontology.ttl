<https://lpp.example/id/card-network/VISA>       a lpp:CardNetwork ; skos:prefLabel "Visa" .
<https://lpp.example/id/card-network/MASTERCARD> a lpp:CardNetwork ; skos:prefLabel "Mastercard" .
<https://lpp.example/id/card-network/AMEX>       a lpp:CardNetwork ; skos:prefLabel "American Express" .
<https://lpp.example/id/card-network/DISCOVER>   a lpp:CardNetwork ; skos:prefLabel "Discover" .
<https://lpp.example/id/card-network/COSTCO>     a lpp:CardNetwork ; skos:prefLabel "Costco-branded" .

