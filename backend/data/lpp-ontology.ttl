#################################################################

lpp:SustainabilityLinkedInstrument rdfs:subClassOf lpp:DebtInstrument ;
    rdfs:label "Sustainability-Linked Instrument"@en .
lpp:GreenBond           rdfs:subClassOf lpp:SustainabilityLinkedInstrument .
lpp:SustainabilityLinkedLoan rdfs:subClassOf lpp:SustainabilityLinkedInstrument .
lpp:EsgTarget           a owl:Class .

lpp:esgKpiName          a owl:DatatypeProperty ; rdfs:range xsd:string .
lpp:esgTargetValue      a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:pricingAdjustmentBps a owl:DatatypeProperty ; rdfs:range xsd:decimal .

lpp:linkedToTarget      a owl:ObjectProperty ;
    rdfs:domain lpp:SustainabilityLinkedInstrument ; rdfs:range lpp:EsgTarget .

#################################################################
# v0.3 EXTENSIONS — rollup classes and recency flags
#
# These additions support pre-aggregated TriplesMaps emitted by the
# v0.3 ROLLUPS section of lpp-r2rml.ttl. They are purely additive:
# nothing above is restated or redefined.
#################################################################

# --- Rollup classes ---------------------------------------------------------
lpp:CardPaymentRollup     a owl:Class ;
    rdfs:label "Card Payment Rollup"@en ;
    rdfs:comment "Pre-aggregated card settlement totals per (acquirer x network x date)."@en .
lpp:PaymentMethodRollup   a owl:Class ;
    rdfs:label "Payment Method Rollup"@en ;
    rdfs:comment "Pre-aggregated payment throughput per (rail x date)."@en .
lpp:VendorPaymentRollup   a owl:Class ;
    rdfs:label "Vendor Payment Rollup"@en ;
    rdfs:comment "Pre-aggregated payables per (vendor x month)."@en .
lpp:CashRollup            a owl:Class ;
    rdfs:label "Cash Rollup"@en ;
    rdfs:comment "Pre-aggregated total cash per (entity x currency x date)."@en .

# --- Datatype properties used by rollups ------------------------------------
lpp:batchCount        a owl:DatatypeProperty ; rdfs:range xsd:integer .
lpp:txnCount          a owl:DatatypeProperty ; rdfs:range xsd:integer .
lpp:txnValue          a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:onTimeRate        a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:totalCash         a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:nAccounts         a owl:DatatypeProperty ; rdfs:range xsd:integer .
lpp:totalBilled       a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:totalPaid         a owl:DatatypeProperty ; rdfs:range xsd:decimal .
lpp:periodMonth       a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Calendar month bucket rendered as 'YYYY-MM'."@en .

# Note: lpp:successRate and lpp:repairRate are already declared above
# (Section J. Payment hub); the PaymentMethodRollup reuses them as-is.

# --- Snapshot / recency flag booleans ---------------------------------------
lpp:isLatestSnapshot  a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:domain lpp:BalanceSnapshot ;
    rdfs:comment "True iff this snapshot has the MAX(statement_date) for its account+balance_type."@en .
lpp:inLast7Days       a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:comment "True iff the row's value-date >= MAX(date)-7 days in its source table."@en .
lpp:inLast30Days      a owl:DatatypeProperty ; rdfs:range xsd:boolean .
lpp:inLast90Days      a owl:DatatypeProperty ; rdfs:range xsd:boolean .
lpp:inLastYear        a owl:DatatypeProperty ; rdfs:range xsd:boolean .

# --- Object properties used by rollups --------------------------------------
# viaAcquirer is referenced by the existing CardSettlementBatchMap but was
# never declared in the ontology; declare it here.
lpp:viaAcquirer       a owl:ObjectProperty ;
    rdfs:range lpp:Acquirer ;
    rdfs:comment "Settling acquirer for a card payment or rollup row."@en .
lpp:vendor            a owl:ObjectProperty ;
    rdfs:domain lpp:VendorPaymentRollup ;
    rdfs:range lpp:Counterparty ;
    rdfs:comment "Vendor (subclass of Counterparty) for a vendor-payment rollup."@en .
# lpp:onNetwork is already declared (range lpp:CardNetwork) above and is
# reused unchanged by CardPaymentRollup.

