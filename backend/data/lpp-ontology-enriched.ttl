@prefix brain: <https://lpp.example/ontology/brain#> .
@prefix lpp: <https://lpp.example/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://lpp.example/id/agency/FITCH> a lpp:CreditRatingAgency ;
    skos:prefLabel "Fitch" .

<https://lpp.example/id/agency/MOODYS> a lpp:CreditRatingAgency ;
    skos:prefLabel "Moody's" .

<https://lpp.example/id/agency/SP> a lpp:CreditRatingAgency ;
    skos:prefLabel "S&P Global Ratings" .

<https://lpp.example/id/auth/3DS> a lpp:AuthenticationMethod ;
    skos:prefLabel "3DS" .

<https://lpp.example/id/auth/NO_3DS> a lpp:AuthenticationMethod ;
    skos:prefLabel "No 3DS" .

<https://lpp.example/id/card-network/AMEX> a lpp:CardNetwork ;
    skos:prefLabel "American Express" .

<https://lpp.example/id/card-network/COSTCO> a lpp:CardNetwork ;
    skos:prefLabel "Costco-branded" .

<https://lpp.example/id/card-network/DISCOVER> a lpp:CardNetwork ;
    skos:prefLabel "Discover" .

<https://lpp.example/id/card-network/MASTERCARD> a lpp:CardNetwork ;
    skos:prefLabel "Mastercard" .

<https://lpp.example/id/card-network/VISA> a lpp:CardNetwork ;
    skos:prefLabel "Visa" .

<https://lpp.example/id/card-type/COMMERCIAL> a lpp:CardType ;
    skos:prefLabel "Commercial" .

<https://lpp.example/id/card-type/CREDIT> a lpp:CardType ;
    skos:prefLabel "Credit" .

<https://lpp.example/id/card-type/DEBIT> a lpp:CardType ;
    skos:prefLabel "Debit" .

<https://lpp.example/id/card-type/PIN_DEBIT> a lpp:CardType ;
    skos:prefLabel "PIN Debit" .

<https://lpp.example/id/card-type/PREPAID> a lpp:CardType ;
    skos:prefLabel "Prepaid" .

<https://lpp.example/id/fraud-cat/FRIENDLY> a lpp:FraudCategory ;
    skos:prefLabel "Friendly Fraud" .

<https://lpp.example/id/fraud-cat/MERCHANT_ERR> a lpp:FraudCategory ;
    skos:prefLabel "Merchant Error" .

<https://lpp.example/id/fraud-cat/TRUE> a lpp:FraudCategory ;
    skos:prefLabel "True Fraud" .

<https://lpp.example/id/instrument-type/BOND> a lpp:InstrumentType ;
    skos:prefLabel "Bond" .

<https://lpp.example/id/instrument-type/CD> a lpp:InstrumentType ;
    skos:prefLabel "Certificate of Deposit" .

<https://lpp.example/id/instrument-type/COMMERCIAL_PAPER> a lpp:InstrumentType ;
    skos:prefLabel "Commercial Paper" .

<https://lpp.example/id/instrument-type/MMF> a lpp:InstrumentType ;
    skos:prefLabel "Money Market Fund" .

<https://lpp.example/id/instrument-type/REPO> a lpp:InstrumentType ;
    skos:prefLabel "Repurchase Agreement" .

<https://lpp.example/id/instrument-type/TIME_DEPOSIT> a lpp:InstrumentType ;
    skos:prefLabel "Time Deposit" .

<https://lpp.example/id/instrument-type/TREASURY> a lpp:InstrumentType ;
    skos:prefLabel "Treasury" .

<https://lpp.example/id/payment-method/ACH> a lpp:PaymentMethod ;
    skos:prefLabel "ACH" .

<https://lpp.example/id/payment-method/CARD> a lpp:PaymentMethod ;
    skos:prefLabel "Card" .

<https://lpp.example/id/payment-method/CHECK> a lpp:PaymentMethod ;
    skos:prefLabel "Check" .

<https://lpp.example/id/payment-method/FEDNOW> a lpp:PaymentMethod ;
    skos:prefLabel "FedNow" .

<https://lpp.example/id/payment-method/RTP> a lpp:PaymentMethod ;
    skos:prefLabel "Real-Time Payments" .

<https://lpp.example/id/payment-method/VCARD> a lpp:PaymentMethod ;
    skos:prefLabel "Virtual Card" .

<https://lpp.example/id/payment-method/WIRE> a lpp:PaymentMethod ;
    skos:prefLabel "Wire" .

<https://lpp.example/id/risk/COMMODITY> a lpp:RiskCategory ;
    skos:prefLabel "Commodity Risk" .

<https://lpp.example/id/risk/COUNTERPARTY> a lpp:RiskCategory ;
    skos:prefLabel "Counterparty Risk" .

<https://lpp.example/id/risk/CYBER> a lpp:RiskCategory ;
    skos:prefLabel "Cyber Risk" .

<https://lpp.example/id/risk/FX> a lpp:RiskCategory ;
    skos:prefLabel "FX Risk" .

<https://lpp.example/id/risk/INTEREST> a lpp:RiskCategory ;
    skos:prefLabel "Interest Rate Risk" .

<https://lpp.example/id/risk/SETTLEMENT> a lpp:RiskCategory ;
    skos:prefLabel "Settlement Risk" .

<https://lpp.example/id/txn-status/INITIATED> a lpp:TransactionStatus ;
    skos:prefLabel "Initiated" .

<https://lpp.example/id/txn-status/PENDING> a lpp:TransactionStatus ;
    skos:prefLabel "Pending" .

<https://lpp.example/id/txn-status/REJECTED> a lpp:TransactionStatus ;
    skos:prefLabel "Rejected" .

<https://lpp.example/id/txn-status/REPAIRED> a lpp:TransactionStatus ;
    skos:prefLabel "Repaired" .

<https://lpp.example/id/txn-status/RETURNED> a lpp:TransactionStatus ;
    skos:prefLabel "Returned" .

<https://lpp.example/id/txn-status/SETTLED> a lpp:TransactionStatus ;
    skos:prefLabel "Settled" .

<https://lpp.example/ontology> a owl:Ontology ;
    rdfs:label "LPP Treasury & Payments Ontology"@en ;
    rdfs:comment "Treasury + payments ontology covering cash & balances, transactions, forecasts, debt & facilities, hedging, FX, ERP reconciliation, payments hub, card acquiring, working capital, fraud, signatories, capital allocation, pension, peers/benchmarks, macro scenarios, and ESG financing. Scoped to answer the Prompts_Retail workbook (Finance + Payments × Analyst/Manager/Director/Executive)."@en ;
    owl:versionInfo "0.2.0" .

lpp:AccessControlEvent a owl:Class .

lpp:AchCredit rdfs:subClassOf lpp:AchTransaction .

lpp:AchDebit rdfs:subClassOf lpp:AchTransaction .

lpp:Acquisition rdfs:subClassOf lpp:CapitalAllocation .

lpp:Benchmark a owl:Class .

lpp:BenchmarkMetric a owl:Class .

lpp:Bond rdfs:comment "This table stores information about credit facilities and bond-like financing arrangements available to the organization, capturing the terms, limits, and status of borrowing facilities extended by financial institutions. It supports treasury questions related to available liquidity, debt capacity, and financing structure. Business users can leverage this table to assess credit availability, monitor facility utilization, and manage capital structure decisions."@en ;
    rdfs:subClassOf lpp:DebtInstrument .

lpp:CapexProgram rdfs:subClassOf lpp:CapitalAllocation .

lpp:CashApplication a owl:Class ;
    rdfs:comment "Matching of an incoming receipt to one or more receivables."@en .

lpp:CashPosition a owl:Class ;
    rdfs:label "Cash Position"@en ;
    rdfs:comment "Aggregate cash position at a level (entity, region, currency, global) for a date."@en .

lpp:CheckPayment rdfs:comment "The CheckPayment class mapped to the lpp.transfer table represents check-based payment transactions processed by the treasury and payments system. This table captures the lifecycle and details of check disbursements and receipts, supporting business questions around outstanding checks, cleared payments, vendor disbursements, and cash flow reconciliation. It serves as a key audit trail for paper-based payment instruments within the broader payments infrastructure."@en ;
    rdfs:subClassOf lpp:PaymentTransaction .

lpp:CollectionAccount rdfs:subClassOf lpp:BankAccount .

lpp:CommercialCardTransaction rdfs:subClassOf lpp:CardTransaction .

lpp:CommercialPaperIssuance rdfs:subClassOf lpp:DebtInstrument .

lpp:CommercialPaperProgram rdfs:comment "This table stores details about Commercial Paper Programs, which are short-term unsecured debt instruments used by the treasury to manage liquidity and fund operational needs. It captures program-level attributes such as authorized issuance limits, tenors, credit ratings, and dealer arrangements that support capital markets funding strategies. Business questions answered include: What is the total authorized commercial paper capacity? Which programs are active and what are their current outstanding balances relative to program limits?"@en ;
    rdfs:subClassOf lpp:DebtInstrument .

lpp:CommodityHedge rdfs:subClassOf lpp:FinancialInstrument .

lpp:ConcentrationAccount rdfs:comment "The ConcentrationAccount class represents bank accounts used in cash concentration and pooling structures, where funds from subsidiary or regional accounts are swept into a central treasury account to optimize liquidity and reduce idle cash. This table stores the defining attributes of each concentration account, including its banking relationships, account identifiers, and structural role within the cash management hierarchy. It supports treasury questions around intercompany funding, zero-balance account (ZBA) structures, notional pooling arrangements, and centralized liquidity management."@en ;
    rdfs:subClassOf lpp:BankAccount .

lpp:CrossBorderPayment rdfs:subClassOf lpp:PaymentTransaction .

lpp:CrossCurrencySwap rdfs:subClassOf lpp:FinancialInstrument .

lpp:DebtPaydown rdfs:subClassOf lpp:CapitalAllocation .

lpp:Disbursement rdfs:label "Disbursement"@en ;
    rdfs:comment "The lpp.cash_flow table records disbursement transactions representing outgoing cash flows from the organization, including vendor payments, payroll, intercompany transfers, and other treasury-initiated disbursements. It serves as the foundational ledger for tracking cash outflows across bank accounts, enabling treasury teams to monitor liquidity positions, reconcile payments, and forecast short-term cash requirements. This table answers business questions around payment timing, disbursement volumes by category, and cash utilization across legal entities."@en ;
    rdfs:subClassOf lpp:Transaction .

lpp:DisbursementAccount rdfs:subClassOf lpp:BankAccount .

lpp:DividendPayment rdfs:subClassOf lpp:CapitalAllocation .

lpp:DuplicatePaymentException rdfs:subClassOf lpp:PaymentException .

lpp:DynamicDiscountingProgram a owl:Class .

lpp:EarlyPaymentDiscount a owl:Class .

lpp:FedNowTransaction rdfs:comment "The FedNowTransaction table (lpp.transfer) captures real-time payment transactions processed through the FedNow instant payment rail, enabling the treasury team to monitor, reconcile, and report on immediate fund transfers between bank accounts. It supports business questions around intraday liquidity management, real-time cash positioning, and settlement confirmation for instant payments. This table serves as the authoritative record for FedNow-facilitated transfers, linking payment activity to broader cash flow and bank account management workflows."@en ;
    rdfs:subClassOf lpp:PaymentTransaction .

lpp:FileFormatException rdfs:subClassOf lpp:PaymentException .

lpp:FxOption rdfs:subClassOf lpp:FinancialInstrument .

lpp:GreenBond rdfs:subClassOf lpp:SustainabilityLinkedInstrument .

lpp:HedgeEffectiveness a owl:Class .

lpp:InterchangeFee rdfs:subClassOf lpp:BankFee .

lpp:InterestRateScenario a owl:Class .

lpp:InterestRateSwap rdfs:subClassOf lpp:FinancialInstrument .

lpp:InvestmentAccount rdfs:subClassOf lpp:BankAccount .

lpp:MacroScenario rdfs:label "Macro Scenario"@en ;
    rdfs:comment "Recession, supply-chain disruption, oil shock, pandemic, geopolitical event, etc."@en ;
    rdfs:subClassOf lpp:Scenario .

lpp:Member rdfs:subClassOf lpp:Customer .

lpp:MerchandiseReturn a owl:Class .

lpp:MerchantAccount a owl:Class ;
    rdfs:comment "Account at an acquirer holding settlements for a merchant location/division."@en .

lpp:NetworkAssessment rdfs:subClassOf lpp:BankFee .

lpp:OfacHoldException rdfs:subClassOf lpp:PaymentException .

lpp:OperatingAccount rdfs:label "Operating Account"@en ;
    rdfs:comment "The OperatingAccount class represents the bank accounts held by the retail company across various financial institutions, used to manage day-to-day cash flows, disbursements, and collections. This table serves as the master registry of all operating bank accounts, enabling treasury to answer questions about account ownership, banking relationships, account types, and currency denominations. It supports cash position reporting, liquidity management, and intercompany funding analysis."@en ;
    rdfs:subClassOf lpp:BankAccount .

lpp:OperationalLossEvent a owl:Class .

lpp:PaymentHubEvent a owl:Class ;
    rdfs:label "Payment Hub Event"@en .

lpp:PaymentIncident a owl:Class ;
    rdfs:comment "Outage, settlement delay, sanctions hit, large reconciliation break, etc."@en .

lpp:ProcessorFee rdfs:subClassOf lpp:BankFee .

lpp:RebateAgreement a owl:Class .

lpp:Receipt rdfs:label "Receipt"@en ;
    rdfs:comment "The lpp.cash_flow table stores receipt and cash flow transaction records that capture the movement of funds into and out of the organization's treasury accounts. It supports business questions related to daily cash positioning, liquidity analysis, and reconciliation of incoming payments and receipts. This table serves as a foundational ledger for tracking operational cash inflows across retail, card acquiring, and other revenue channels."@en ;
    rdfs:subClassOf lpp:Transaction .

lpp:Recertification a owl:Class .

lpp:Refund a owl:Class .

lpp:RepairException rdfs:subClassOf lpp:PaymentException .

lpp:RevolvingCreditFacility rdfs:comment "This table stores details about revolving credit facilities available to the organization, capturing the terms, limits, and status of each credit line arranged with banking counterparties. It supports treasury liquidity management by tracking available borrowing capacity, drawdown conditions, and facility agreements. Business questions answered include: what credit facilities are currently active, what is the total committed borrowing capacity, and which banking partners provide revolving credit support?"@en ;
    rdfs:subClassOf lpp:CreditFacility .

lpp:RtpTransaction rdfs:comment "The RtpTransaction class mapped to lpp.transfer represents Real-Time Payment (RTP) transactions processed through the company's payment rails, capturing instant fund transfers between accounts or counterparties. This table supports treasury and payments operations by tracking the lifecycle, status, and settlement of real-time payments, enabling monitoring of liquidity impact, payment confirmation, and operational reconciliation. It answers business questions around intraday cash movements, payment success rates, and real-time settlement exposure."@en ;
    rdfs:subClassOf lpp:PaymentTransaction .

lpp:ShareRepurchase rdfs:subClassOf lpp:CapitalAllocation .

lpp:ShareRepurchaseProgram a owl:Class .

lpp:StpMetric a owl:Class ;
    rdfs:label "STP Metric"@en .

lpp:Supplier rdfs:subClassOf lpp:Vendor .

lpp:SupplyChainFinanceProgram a owl:Class .

lpp:SustainabilityLinkedLoan rdfs:subClassOf lpp:SustainabilityLinkedInstrument .

lpp:TargetBalance a owl:DatatypeProperty ;
    rdfs:comment "The desired residual cash balance that should remain in the source account after a sweep is executed, typically set to zero for zero-balance accounts or a specific floor amount for notional pooling arrangements."@en ;
    rdfs:domain lpp:SweepRule ;
    rdfs:range xsd:decimal .

lpp:TermLoan rdfs:comment "The TermLoan (credit_facility) table stores information about the company's term loan agreements and structured credit facilities, capturing key details about borrowed funds with defined repayment schedules. It supports treasury questions around debt management, maturity profiling, covenant tracking, and interest cost analysis. This table is essential for monitoring outstanding principal balances, upcoming repayment obligations, and overall leverage positions across the organization's credit portfolio."@en ;
    rdfs:subClassOf lpp:CreditFacility .

lpp:VirtualCardTransaction rdfs:subClassOf lpp:CardTransaction .

lpp:WireTransfer rdfs:comment "The lpp.transfer table stores wire transfer transaction records, capturing the movement of funds between bank accounts via wire payment rails. It supports treasury operations by enabling tracking of outbound and inbound wire payments, settlement status, and counterparty details. This table answers business questions related to wire transfer volumes, settlement timing, payment instruction details, and cash flow reconciliation."@en ;
    rdfs:subClassOf lpp:PaymentTransaction .

lpp:actionDate a owl:DatatypeProperty ;
    rdfs:comment "The settlement or effective date on which the equity action (buyback or dividend) was executed or recorded."@en ;
    rdfs:domain lpp:EquityAction .

lpp:actionType a owl:DatatypeProperty ;
    rdfs:comment "Classifies the type of equity action performed, either BUYBACK for share repurchase programs or DIVIDEND for cash distributions to shareholders."@en ;
    rdfs:domain lpp:EquityAction .

lpp:actualInflow a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:actualOutflow a owl:DatatypeProperty ;
    rdfs:comment "The realized cash outflow amount for the given driver category and period, expressed in the specified currency."@en ;
    rdfs:domain lpp:ForecastActual ;
    rdfs:range xsd:decimal .

lpp:affiliatedBank a owl:ObjectProperty ;
    rdfs:comment "Reference to an affiliated or parent banking institution associated with this acquirer, used to map acquiring relationships to broader bank counterparty exposure and concentration analysis."@en ;
    rdfs:domain lpp:Acquirer ;
    rdfs:range lpp:Bank .

lpp:agency a owl:DatatypeProperty ;
    rdfs:comment "The credit rating agency that issued the rating, such as Moody's, S&P, or Fitch, identifying the source of the credit assessment."@en ;
    rdfs:domain lpp:CreditRating .

lpp:allInCost a owl:DatatypeProperty ;
    rdfs:comment "The total annualized cost of the borrowing expressed as a percentage, including interest rate, fees, and any applicable spreads."@en ;
    rdfs:domain lpp:DebtMaturity ;
    rdfs:range xsd:decimal .

lpp:allocationAmount a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:amount a owl:DatatypeProperty ;
    rdfs:comment "The dollar amount of the original ACH transfer that was returned, expressed as a decimal value. | The monetary balance amount recorded for the account as of the snapshot date, expressed in the account's designated currency, which may be positive (credit balance), zero, or negative (overdraft position). | The actual monetary amount in dollars allocated to the corresponding capital bucket during the reporting period. | The monetary value of the transaction submitted for authorization, expressed as a decimal in the currency indicated by currencyCode. | The monetary value of the disputed transaction subject to the chargeback, expressed as a decimal in the account's base currency. | The monetary value of the company's financial exposure to the counterparty as of the snapshot date, expressed in the specified currency. | The monetary value of the intercompany transfer in the specified currency, representing the gross amount moved between the originating and beneficiary accounts. | The monetary value of interest accrued for a given currency and valuation date, expressed as a decimal number in the denomination of the associated currency. | The monetary balance of the general ledger account as of the reporting date, expressed in the account's native currency to six decimal places. | The monetary value of the payment transaction expressed in the associated currency, representing the exact sum to be transferred to the beneficiary. | The gross transaction amount in the specified currency, representing the total value tendered or charged for the sale or membership event. | The monetary value of funds transferred during this sweep event, denominated in the currency specified by currencyCode. | The monetary value of the cash flow transaction, expressed as a signed decimal where negative values indicate outflows (e.g., payroll disbursements or payments) and positive values indicate inflows, denominated in the currency specified by currencyCode."@en ;
    rdfs:domain lpp:AchReturn,
        lpp:BalanceSnapshot,
        lpp:CapitalAllocationActual,
        lpp:CardAuthorization,
        lpp:Chargeback,
        lpp:CounterpartyExposure,
        lpp:IntercompanyTransfer,
        lpp:InterestAccrual,
        lpp:LedgerEntry,
        lpp:PaymentTransaction,
        lpp:PosTransaction,
        lpp:SweepEvent,
        lpp:Transaction ;
    rdfs:range xsd:decimal .

lpp:appliedAmount a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:appliedBy a owl:ObjectProperty ;
    rdfs:comment "A reference to the internal entity or business unit that requested and applied for this letter of credit."@en ;
    rdfs:domain lpp:LetterOfCredit ;
    rdfs:range lpp:Company .

lpp:appliesRule a owl:ObjectProperty ;
    rdfs:comment "A reference to the treasury sweep rule that triggered this event, linking the execution to the specific policy or threshold configuration that governed the transfer."@en ;
    rdfs:domain lpp:SweepEvent ;
    rdfs:range lpp:SweepRule .

lpp:approvalLimit a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:approvedBy a owl:ObjectProperty ;
    rdfs:domain lpp:PaymentTransaction ;
    rdfs:range lpp:Person .

lpp:asOfDate a owl:DatatypeProperty ;
    rdfs:comment "The business date for which the balance snapshot is recorded, representing the point-in-time as of which the cash position is measured (e.g., end of business day). | The reporting date on which the bank fee was recorded or assessed, used for period-based fee analysis and trending. | The business date for which the card settlement batch was processed and aggregated, used as the primary time dimension for daily treasury reconciliation. | The reference date on which the forecast snapshot was generated or to which it applies, used to version forecasts and track how projections evolve over time. | The calendar date for which the aggregated cash balance snapshot is recorded, representing the statement balance date as reported by the bank. | The date on which the exposure snapshot was recorded, used for point-in-time risk reporting and trend analysis. | The date on which the credit rating was assigned or became effective, enabling point-in-time and historical rating analysis. | The valuation date as of which the mark-to-market amount is calculated, typically representing a weekly or period-end snapshot of the derivative's fair value. | The month-end date representing the period for which the forecast-versus-actual comparison is being evaluated. | The reference date for which the forecast cash flow projections are calculated, representing the snapshot point in time for the forecast. | The reporting date as of which the FX exposure forecast snapshot was captured, typically month-end. | The calendar date for which the exchange rate is valid, used to align FX rates with transaction dates, reporting periods, or cash position snapshots. | The calendar date as of which the interest accrual amount is calculated and recorded, used for point-in-time treasury reporting and reconciliation. | The business date on which the benchmark rate was published or observed, used to retrieve point-in-time or historical rate snapshots. | The date as of which the investment position snapshot was recorded, typically captured on a weekly basis to track portfolio evolution over time. | The month-end date as of which the ledger balance is recorded, representing the closing position for that accounting period. | The calendar date on which the macroeconomic indicator value was observed or published, enabling point-in-time analysis and trend tracking. | The calendar date for which the aggregated payment method metrics are reported, serving as the primary time dimension for trend analysis. | The measurement or valuation date as of which the pension figures are reported, typically aligned with fiscal year-end or interim reporting periods. | The accounting period end date as of which the reconciliation was performed, typically the last day of a calendar month. | The reference date for which the stress scenario run result was calculated, representing the snapshot date of the liquidity position being stressed. | The effective date on which this sweep event was executed or recorded in the treasury system. | The reporting period end date as of which the working capital metrics are calculated, typically aligned to month-end or quarter-end."@en ;
    rdfs:domain lpp:BalanceSnapshot,
        lpp:BankFee,
        lpp:CardPaymentRollup,
        lpp:CashForecast,
        lpp:CashRollup,
        lpp:CounterpartyExposure,
        lpp:CreditRating,
        lpp:DerivativeMtm,
        lpp:ForecastActual,
        lpp:ForecastLine,
        lpp:FxExposure,
        lpp:FxRate,
        lpp:InterestAccrual,
        lpp:InterestRateBenchmark,
        lpp:InvestmentPosition,
        lpp:LedgerEntry,
        lpp:MacroIndicator,
        lpp:PaymentMethodRollup,
        lpp:PensionValuation,
        lpp:ReconciliationItem,
        lpp:ScenarioAssumption,
        lpp:SweepEvent,
        lpp:WorkingCapitalMetric ;
    rdfs:range xsd:date .

lpp:atBranch a owl:ObjectProperty ;
    rdfs:comment "A reference to the specific bank branch (RDF resource) where this account is physically or administratively held, linking to branch-level details such as location and sort code."@en ;
    rdfs:domain lpp:BankAccount ;
    rdfs:range lpp:BankBranch .

lpp:auth3dsStatus a owl:DatatypeProperty ;
    rdfs:comment "Indicates the outcome or applicability of 3D Secure authentication for this authorization attempt, such as NOT_ATTEMPTED when 3DS was not invoked."@en ;
    rdfs:domain lpp:CardAuthorization .

lpp:authDecision a owl:DatatypeProperty ;
    rdfs:comment "The final authorization decision returned by the issuer or authorization engine, such as APPROVED or DECLINED."@en ;
    rdfs:domain lpp:CardAuthorization .

lpp:authForPos a owl:ObjectProperty ;
    rdfs:comment "Indicates whether the authorization was initiated for a point-of-sale terminal context; no samples available in current dataset."@en ;
    rdfs:domain lpp:CardAuthorization ;
    rdfs:range lpp:PosTxn .

lpp:authMethod a owl:DatatypeProperty ;
    rdfs:comment "The authentication method in use at the time of the fraudulent transaction, indicating whether 3D Secure challenge, frictionless 3DS, no 3DS, or no authentication was applied."@en ;
    rdfs:domain lpp:FraudLoss .

lpp:authRatePct a owl:DatatypeProperty ;
    rdfs:comment "The percentage of card authorization attempts that were successfully approved by the acquirer on the measurement date, expressed as a decimal percentage (e.g., 98.189 means 98.189%)."@en ;
    rdfs:domain lpp:AcquirerSlaMetric .

lpp:authRequestTimestamp a owl:DatatypeProperty ;
    rdfs:comment "The UTC timestamp at which the authorization request was initiated and sent for processing, used to measure authorization latency and volume patterns over time."@en ;
    rdfs:domain lpp:CardAuthorization .

lpp:authResponseTimestamp a owl:DatatypeProperty ;
    rdfs:comment "The UTC timestamp at which the authorization response was received, used in conjunction with authRequestTimestamp to calculate end-to-end response time."@en ;
    rdfs:domain lpp:CardAuthorization .

lpp:authenticatedVia a owl:ObjectProperty ;
    rdfs:domain lpp:CardTransaction ;
    rdfs:range lpp:AuthenticationMethod .

lpp:authorityLimitAmount a owl:DatatypeProperty ;
    rdfs:comment "The maximum monetary amount in the account currency up to which this signatory is authorized to approve or release transactions on the linked bank account."@en ;
    rdfs:domain lpp:BankAccountSignatory .

lpp:authorizationAmount a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:authorizationRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:authorizedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

lpp:authorizes a owl:ObjectProperty ;
    rdfs:domain lpp:Authorization ;
    rdfs:range lpp:CardTransaction .

lpp:availableBalance a owl:DatatypeProperty ;
    rdfs:comment "The funds immediately available for use in the account at the time of the snapshot, net of holds, pending transactions, or reserve requirements."@en ;
    rdfs:domain lpp:Balance ;
    rdfs:range xsd:decimal .

lpp:availableCapacity a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:averageBalance a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:avgPurchasePrice a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:bankDepositTimestamp a owl:DatatypeProperty ;
    rdfs:comment "The UTC timestamp at which the net settlement funds were credited to the company's bank account following processor settlement."@en ;
    rdfs:domain lpp:CardSettlementBatch .

lpp:bankSide a owl:ObjectProperty ;
    rdfs:domain lpp:ReconciliationItem ;
    rdfs:range lpp:Transaction .

lpp:batchCloseTimestamp a owl:DatatypeProperty ;
    rdfs:comment "The UTC timestamp at which the card terminal or point-of-sale system closed the settlement batch, marking the end of the transaction capture window."@en ;
    rdfs:domain lpp:CardSettlementBatch .

lpp:batchClosedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

lpp:batchCount a owl:DatatypeProperty ;
    rdfs:comment "The number of individual settlement batches consolidated into this rollup record for the given date, indicating whether single or multiple batch submissions occurred."@en ;
    rdfs:domain lpp:CardPaymentRollup ;
    rdfs:range xsd:integer .

lpp:belongsToBU a owl:ObjectProperty ;
    rdfs:range lpp:BusinessUnit .

lpp:belongsToDept a owl:ObjectProperty ;
    rdfs:range lpp:Department .

lpp:benchmarkPeriod a owl:DatatypeProperty ;
    rdfs:range xsd:string .

lpp:benchmarkedAgainst a owl:ObjectProperty ;
    rdfs:range lpp:PeerCompany .

lpp:beneficiary a owl:ObjectProperty ;
    rdfs:comment "The legal entity or subsidiary that receives the funds in the intercompany transfer, typically represented as a reference to the receiving party."@en ;
    rdfs:domain lpp:IntercompanyTransfer,
        lpp:Transaction ;
    rdfs:range lpp:Company .

lpp:bic a owl:DatatypeProperty ;
    rdfs:comment "The Bank Identifier Code (SWIFT BIC) uniquely identifying the bank for international payment routing and messaging."@en ;
    rdfs:domain lpp:Bank ;
    rdfs:range xsd:string .

lpp:billedFrom a owl:ObjectProperty ;
    rdfs:comment "The counterparty or supplier entity that issued the invoice, identifying the vendor or service provider to whom payment is owed. | The vendor or counterparty entity that issued the invoice and to whom payment is owed, linking the payable to a specific supplier relationship."@en ;
    rdfs:domain lpp:Invoice,
        lpp:Payable ;
    rdfs:range lpp:Vendor .

lpp:billedRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:billedTo a owl:ObjectProperty ;
    rdfs:comment "The counterparty or customer entity to whom the invoice was issued, used for receivables segmentation and customer-level exposure reporting."@en ;
    rdfs:domain lpp:Receivable ;
    rdfs:range lpp:Customer .

lpp:bookValue a owl:DatatypeProperty ;
    rdfs:comment "The amortized cost or book value of the investment position in the stated currency, representing the carrying value on the company's balance sheet."@en ;
    rdfs:domain lpp:InvestmentPosition ;
    rdfs:range xsd:decimal .

lpp:branchOf a owl:ObjectProperty ;
    rdfs:comment "A reference linking this branch to its parent banking institution (BankInstitution entity), establishing the ownership hierarchy between a branch and its owning bank."@en ;
    rdfs:domain lpp:BankBranch ;
    rdfs:range lpp:Bank .

lpp:bucket a owl:DatatypeProperty ;
    rdfs:comment "The capital allocation category representing the strategic use of funds, such as CAPEX (capital expenditures), M_AND_A (mergers and acquisitions), DIVIDENDS, DEBT_PAYDOWN, or BUYBACKS (share repurchases)."@en ;
    rdfs:domain lpp:CapitalAllocationActual .

lpp:buybackYieldPct a owl:DatatypeProperty ;
    rdfs:comment "The annualized share buyback yield expressed as a percentage of market capitalization, indicating how aggressively the peer company is returning capital to shareholders through repurchases."@en ;
    rdfs:domain lpp:PeerCompanyMetric .

lpp:cardType a owl:ObjectProperty ;
    rdfs:domain lpp:CardTransaction ;
    rdfs:range lpp:CardType .

lpp:cashFlowImpact a owl:DatatypeProperty ;
    rdfs:comment "The projected monetary impact on cash flows resulting from the stress scenario run, expressed as a decimal value in the specified currency, indicating net inflows or outflows under the stressed conditions."@en ;
    rdfs:domain lpp:ScenarioAssumption ;
    rdfs:range xsd:decimal .

lpp:channel a owl:DatatypeProperty ;
    rdfs:comment "The commerce channel through which the fraudulent transaction occurred, such as in-warehouse point-of-sale, e-commerce, or membership renewal. | The sales or renewal channel through which the membership fee was initiated, such as automatic renewal (AUTORENEW), in-warehouse signup, new member signup, or ecommerce platform. | The sales or payment channel through which the transaction was initiated, such as IN_WAREHOUSE for physical store purchases, ECOMMERCE for online orders, or MEMBERSHIP_RENEWAL for subscription fee collections."@en ;
    rdfs:domain lpp:FraudLoss,
        lpp:MembershipFee,
        lpp:PosTransaction .

lpp:chargebackRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:chargedBy a owl:ObjectProperty ;
    rdfs:comment "A reference to the banking institution or counterparty that levied the fee, linking to the bank or financial institution entity in the ontology. | The name or identifier of the external party, bank, or service provider that levies this fee against the company."@en ;
    rdfs:domain lpp:BankFee,
        lpp:RateCardLine ;
    rdfs:range lpp:Bank .

lpp:classification a owl:DatatypeProperty ;
    rdfs:comment "The categorization of the chargeback's root cause, distinguishing between TRUE_FRAUD (unauthorized use), FRIENDLY_FRAUD (illegitimate cardholder dispute), and MERCHANT_ERROR (fulfillment or processing mistake)."@en ;
    rdfs:domain lpp:Chargeback .

lpp:closingBalance a owl:DatatypeProperty ;
    rdfs:comment "The ending ledger balance of the bank account at the close of the statement period or snapshot date."@en ;
    rdfs:domain lpp:Balance ;
    rdfs:range xsd:decimal .

lpp:cnpIndicator a owl:DatatypeProperty ;
    rdfs:comment "Boolean flag indicating whether the transaction was Card Not Present (CNP), distinguishing between in-person and remote or online payment scenarios."@en ;
    rdfs:domain lpp:CardAuthorization .

lpp:code a owl:DatatypeProperty ;
    rdfs:comment "A short, system-readable unique identifier for the acquirer used as a foreign key in transaction, settlement, and fee records (e.g., ADYEN, FISERV). | An internal short code used by the treasury system to reference the bank across transactions, accounts, and reports. | A unique alphanumeric identifier or account code assigned internally to reference this bank account within the treasury management system. | A unique alphanumeric identifier for a bank branch, formatted as BR_{BankAcronym}_{LocationCode}, used to reference specific branches in transaction, account, and hedging records. | A short uppercase identifier for the card network used as a foreign key in transaction and acquiring tables (e.g., VISA, MASTERCARD, COSTCO_PRIVATE). | A unique alphanumeric identifier for the rebate program, typically encoding the issuer and card type (e.g., REB_JPM_VCARD for JPMorgan virtual card), used as the primary reference key across the data warehouse. | A structured alphanumeric identifier for the forecast snapshot encoding the as-of date and forecast frequency (e.g., FC_20230801_M), used as a unique key to retrieve or compare specific forecast runs. | Internal alphanumeric identifier assigned to the company for use across treasury and payments systems. | A unique alphanumeric identifier for the counterparty used as a reference key across treasury and payments systems, with special codes such as RETAIL_CONSUMER representing aggregated groups rather than individual entities. | A unique alphanumeric identifier for the credit facility, encoding key attributes such as facility type (RCF, TERM, OD, CP, IC), currency, and approximate size (e.g., CF_RCF_USD_2B is a USD 2 billion revolving credit facility). | The ISO 4217 three-letter alphabetic currency code that uniquely identifies each currency and serves as the primary key for joining to financial transactions, FX rates, and account balances throughout the data warehouse. | A short numeric identifier uniquely representing a specific bank service fee type, used as a foreign key in fee transaction and bank analysis tables. | Unique alphanumeric identifier for the FX forward contract, used to reference and track the instrument across treasury and reporting systems. | The unique alphanumeric identifier for the GL account, encoding the account number prefix, entity or region code, and functional purpose (e.g., '1110-GR_AE_COLLECTION_1' denotes a cash collection account for the GR entity in the AE region). | A unique alphanumeric identifier for each hedge relationship record, used to reference and track individual hedging arrangements across treasury systems. | The standardized identifier of the benchmark interest rate index, such as SOFR (USD), SONIA (GBP), ESTR (EUR), TONA (JPY), SARON (CHF), or TIIE_28D (MXN), representing the specific rate regime in use. | Unique alphanumeric identifier for the investment instrument, used to reference it across cash deployment, position, and transaction records (e.g., INV_MMF_0014 denotes a specific money market fund). | A short internal identifier code assigned to the peer company, typically matching its stock ticker symbol, used as a primary key in benchmark joins and SPARQL lookups. | A short alphanumeric role identifier representing the user's functional position within the treasury and finance organization, such as TREAS_FRONT for treasury front office or CFO_GLOBAL for the global chief financial officer. | A short alphanumeric identifier representing a major geographic region (e.g., APAC for Asia-Pacific, AMER for Americas, LATAM for Latin America, EMEA for Europe/Middle East/Africa, MENA for Middle East/North Africa) used to classify bank branches and aggregate treasury data. | A short machine-readable identifier for the stress scenario, used as a unique reference key when linking scenario parameters to stress test results and run configurations. | A unique business identifier for the sweep rule, typically encoding the legal entity group, country, account type, and sequence number (e.g., SW_GR_AE_OPERATING_1 denotes a sweep rule for the GR group's AED operating account in the UAE)."@en ;
    rdfs:domain lpp:Acquirer,
        lpp:Bank,
        lpp:BankAccount,
        lpp:BankBranch,
        lpp:CardNetwork,
        lpp:CardRebateProgram,
        lpp:CashForecast,
        lpp:Company,
        lpp:Counterparty,
        lpp:CreditFacility,
        lpp:Currency,
        lpp:FeeServiceType,
        lpp:FxForward,
        lpp:GlAccount,
        lpp:HedgePosition,
        lpp:InterestRateBenchmark,
        lpp:InvestmentInstrument,
        lpp:PeerCompany,
        lpp:Person,
        lpp:Region,
        lpp:StressTest,
        lpp:SweepRule ;
    rdfs:range xsd:string .

lpp:collectedBy a owl:ObjectProperty ;
    rdfs:comment "The entity, staff member, system, or payment processor responsible for collecting or processing the membership fee payment."@en ;
    rdfs:domain lpp:MembershipFee ;
    rdfs:range lpp:Company .

lpp:committedFlag a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

lpp:confidenceLevel a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:consumesFacility a owl:ObjectProperty ;
    rdfs:comment "A reference to the credit facility or bank line that this letter of credit draws capacity from, linking LC utilization to facility management."@en ;
    rdfs:domain lpp:LetterOfCredit ;
    rdfs:range lpp:CreditFacility .

lpp:containsTransaction a owl:ObjectProperty ;
    rdfs:domain lpp:PaymentBatch ;
    rdfs:range lpp:Transaction .

lpp:corridor a owl:DatatypeProperty ;
    rdfs:comment "Identifies the high-level payment corridor as a directional pair of regional or country codes (e.g., US-EU, US-APAC), used to group and analyze cross-border payment flows between major trade zones."@en ;
    rdfs:domain lpp:CrossBorderPaymentLeg .

lpp:countryCode a owl:DatatypeProperty ;
    rdfs:comment "ISO 3166-1 alpha-2 country code indicating the country where the bank branch is physically located or operationally domiciled, used for jurisdictional and regulatory classification. | ISO 3166-1 alpha-2 country code representing the primary country of domicile or registration for the company. | The ISO 3166-1 alpha-2 two-letter country code uniquely identifying each country in which the company has treasury, payments, or banking operations. | ISO two-letter country code indicating the jurisdiction in which the pension plan is registered and governed, such as US, GB, or JP."@en ;
    rdfs:domain lpp:BankBranch,
        lpp:Company,
        lpp:Country,
        lpp:PensionPlan ;
    rdfs:range xsd:string .

lpp:covenantHeadroom a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:covenantStatus a owl:DatatypeProperty ;
    rdfs:range xsd:string .

lpp:covenantThreshold a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:crossBorder a owl:DatatypeProperty ;
    rdfs:comment "Indicates whether the card transaction was cross-border, meaning the issuer country differs from the merchant's country, which affects interchange rates and FX exposure."@en ;
    rdfs:domain lpp:CardSettlementLine .

lpp:currencyCode a owl:DatatypeProperty ;
    rdfs:comment "The ISO 4217 three-letter currency code indicating the currency in which the balance amount is denominated (e.g., AUD, BRL, EUR). | The ISO 4217 currency code in which the fee amount is denominated, such as USD, enabling multi-currency fee aggregation and conversion. | The ISO 4217 three-letter currency code in which the transaction amount is denominated, such as USD. | The ISO 4217 three-letter currency code (e.g., EUR) indicating the currency in which all aggregated balances in this row are denominated. | The ISO 4217 currency code in which the exposure amount is denominated, indicating the currency of the outstanding position. | The ISO 4217 currency code in which the borrowing is denominated, indicating the currency of principal and repayment obligations. | The ISO 4217 currency code in which the MTM amount is denominated, indicating the reporting or settlement currency of the derivative position. | The ISO 4217 currency code in which both the forecasted and actual outflow amounts are denominated. | The ISO currency code (e.g., USD, EUR, GBP) denoting the denomination in which the forecasted inflows and outflows are expressed. | The ISO 4217 three-letter currency code representing the foreign currency being hedged in this relationship, such as CNY, GBP, or JPY. | The ISO 4217 three-letter currency code denoting the currency in which the intercompany transfer is denominated (e.g., USD, EUR, KRW). | The ISO 4217 three-letter currency code identifying the currency in which the interest accrual amount is denominated, reflecting the company's multi-currency treasury operations. | The ISO 4217 three-letter currency code identifying the currency to which the benchmark rate applies, linking the rate to the relevant monetary jurisdiction. | The ISO 4217 currency code in which the investment position is denominated, used to support multi-currency portfolio reporting and FX exposure analysis. | The ISO 4217 currency code in which the invoice is denominated, used to identify FX exposure and support multi-currency working capital reporting. | The ISO 4217 currency code indicating the denomination of the ledger balance, reflecting the local currency of the entity or account. | The ISO 4217 currency code in which the invoice is denominated, indicating the currency of the payment obligation (e.g., AED, USD, CNY). | The ISO 4217 three-letter currency code identifying the denomination in which the payment file transactions are settled, supporting multi-currency treasury operations across markets such as UAE Dirham, Euro, Swedish Krona, British Pound, Mexican Peso, and Brazilian Real. | The ISO 4217 three-letter currency code indicating the currency in which the payment amount is denominated (e.g., AED, EUR, SEK, GBP). | The ISO 4217 currency code of the transaction amount, indicating the currency in which the payment was made and enabling multi-currency treasury reporting. | The ISO 4217 currency code in which the negotiated fee rate is denominated, indicating the billing currency for the associated service. | The ISO 4217 currency code in which the invoice is denominated, used for multi-currency receivables reporting and FX exposure analysis. | The ISO 4217 currency code in which the ledger account balance and any discrepancy amounts are denominated. | The ISO 4217 currency code in which the cash flow impact is denominated, used to normalize results across multi-currency treasury operations. | The ISO 4217 currency code representing the currency in which the sweep amount is denominated. | The ISO 4217 three-letter currency code representing the denomination of the accounts and funds governed by this sweep rule. | The ISO 4217 three-letter currency code indicating the currency in which the transaction amount is denominated, such as AUD for Australian dollars. | The ISO 4217 currency code in which the working capital metrics are denominated, used to ensure consistent cross-entity comparisons."@en ;
    rdfs:domain lpp:BalanceSnapshot,
        lpp:BankFee,
        lpp:CardAuthorization,
        lpp:CashRollup,
        lpp:CounterpartyExposure,
        lpp:DebtMaturity,
        lpp:DerivativeMtm,
        lpp:ForecastActual,
        lpp:ForecastLine,
        lpp:HedgePosition,
        lpp:IntercompanyTransfer,
        lpp:InterestAccrual,
        lpp:InterestRateBenchmark,
        lpp:InvestmentPosition,
        lpp:Invoice,
        lpp:LedgerEntry,
        lpp:Payable,
        lpp:PaymentFile,
        lpp:PaymentTransaction,
        lpp:PosTransaction,
        lpp:RateCardLine,
        lpp:Receivable,
        lpp:ReconciliationItem,
        lpp:ScenarioAssumption,
        lpp:SweepEvent,
        lpp:SweepRule,
        lpp:Transaction,
        lpp:WorkingCapitalMetric ;
    rdfs:range xsd:string .

lpp:dccFlag a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

lpp:debtToEbitda a owl:DatatypeProperty ;
    rdfs:comment "The ratio of net debt to EBITDA for the reporting period, used as a leverage benchmark to assess how many years of operating earnings would be required to repay debt obligations. | The ratio of net debt to EBITDA for the peer company, a key leverage metric used to assess credit risk and capital structure relative to earnings capacity."@en ;
    rdfs:domain lpp:CompanyFinancialMetric,
        lpp:PeerCompanyMetric .

lpp:declineRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:declineReasonCode a owl:DatatypeProperty ;
    rdfs:comment "The issuer or network-provided reason code explaining why an authorization was declined; null or absent when the transaction was approved."@en ;
    rdfs:domain lpp:CardAuthorization .

lpp:depositTo a owl:ObjectProperty ;
    rdfs:domain lpp:Settlement ;
    rdfs:range lpp:BankAccount .

lpp:depositedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

lpp:destinationAccount a owl:ObjectProperty ;
    rdfs:comment "A reference to the bank account that received the swept funds, representing the target concentration or zero-balance account. | The identifier of the target bank account to which funds are transferred when the sweep rule is activated, typically a regional or global concentration or header account."@en ;
    rdfs:domain lpp:SweepEvent,
        lpp:SweepRule ;
    rdfs:range lpp:BankAccount .

lpp:destinationCountry a owl:DatatypeProperty ;
    rdfs:comment "ISO 3166-1 alpha-2 country code representing the receiving country where funds are delivered at the end of the payment leg."@en ;
    rdfs:domain lpp:CrossBorderPaymentLeg .

lpp:detectedAt a owl:DatatypeProperty ;
    rdfs:comment "The UTC timestamp when the payment exception was first identified by the system or operations team, marking the start of the exception lifecycle."@en ;
    rdfs:domain lpp:PaymentException .

lpp:deviceFingerprint a owl:DatatypeProperty ;
    rdfs:range xsd:string .

lpp:dilutedEps a owl:DatatypeProperty ;
    rdfs:comment "Diluted earnings per share for the period, calculated using the fully diluted share count including options and convertible instruments, used as a profitability and valuation benchmark."@en ;
    rdfs:domain lpp:CompanyFinancialMetric .

lpp:dilutedSharesOutstanding a owl:DatatypeProperty ;
    rdfs:comment "The total number of diluted shares outstanding for the company in the reporting period, including the effect of all potentially dilutive securities such as options and warrants."@en ;
    rdfs:domain lpp:CompanyFinancialMetric .

lpp:dioDays a owl:DatatypeProperty ;
    rdfs:comment "Days Inventory Outstanding — the average number of days the entity holds inventory before it is sold, where higher values indicate slower inventory turnover."@en ;
    rdfs:domain lpp:WorkingCapitalMetric ;
    rdfs:range xsd:decimal .

lpp:discountCaptured a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:discountRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:discountRatePct a owl:DatatypeProperty ;
    rdfs:comment "The actuarial discount rate (expressed as a percentage) used to calculate the present value of the projected benefit obligation, reflecting yields on high-quality corporate or government bonds at the measurement date."@en ;
    rdfs:domain lpp:PensionValuation .

lpp:discrepancyAmount a owl:DatatypeProperty ;
    rdfs:comment "The net difference between the internal general ledger balance and the external reference balance; a value of zero indicates a fully matched reconciliation."@en ;
    rdfs:domain lpp:ReconciliationItem ;
    rdfs:range xsd:decimal .

lpp:disputeReason a owl:ObjectProperty ;
    rdfs:domain lpp:Chargeback ;
    rdfs:range lpp:ChargebackReason .

lpp:disputeWinRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:disputedTransaction a owl:ObjectProperty ;
    rdfs:domain lpp:Chargeback ;
    rdfs:range lpp:CardTransaction .

lpp:disputesAuth a owl:ObjectProperty ;
    rdfs:comment "A reference or flag linking the chargeback to the original authorization record associated with the disputed transaction."@en ;
    rdfs:domain lpp:Chargeback ;
    rdfs:range lpp:CardAuth .

lpp:dividendPerShare a owl:DatatypeProperty ;
    rdfs:comment "The declared cash dividend amount paid per share to shareholders, populated only when actionType is DIVIDEND."@en ;
    rdfs:domain lpp:EquityAction ;
    rdfs:range xsd:decimal .

lpp:dividendYieldPct a owl:DatatypeProperty ;
    rdfs:comment "The annualized dividend yield expressed as a percentage of share price, reflecting the peer company's cash dividend distribution to shareholders."@en ;
    rdfs:domain lpp:PeerCompanyMetric .

lpp:dpoDays a owl:DatatypeProperty ;
    rdfs:comment "Days Payables Outstanding — the average number of days the entity takes to pay its suppliers, where higher values indicate the entity is retaining cash longer before settling obligations."@en ;
    rdfs:domain lpp:WorkingCapitalMetric ;
    rdfs:range xsd:decimal .

lpp:drawnAmount a owl:DatatypeProperty ;
    rdfs:comment "The actual amount drawn down or utilized from the credit facility at the time of the transaction, which may differ from the total principal if partially drawn. | The cumulative monetary amount that has been drawn or called against this letter of credit to date, expressed as a decimal; a value of zero indicates no draws have occurred."@en ;
    rdfs:domain lpp:DebtMaturity,
        lpp:LetterOfCredit ;
    rdfs:range xsd:decimal .

lpp:driverCategory a owl:DatatypeProperty ;
    rdfs:comment "The treasury classification of the cash flow driver being compared, such as AP_DISBURSEMENT, PAYROLL, TAX, AR_COLLECTION, FX_REVAL, or CAPEX. | A classification label identifying the business driver or category behind the forecasted cash movement, such as merchandise payables, membership fees, or capital expenditures."@en ;
    rdfs:domain lpp:ForecastActual,
        lpp:ForecastLine ;
    rdfs:range xsd:string .

lpp:dsoDays a owl:DatatypeProperty ;
    rdfs:comment "Days Sales Outstanding — the average number of days it takes to collect receivables after a sale, where lower values indicate faster cash collection from customers."@en ;
    rdfs:domain lpp:WorkingCapitalMetric ;
    rdfs:range xsd:decimal .

lpp:dueDate a owl:DatatypeProperty ;
    rdfs:comment "The contractual date by which the invoice must be paid, used to calculate days payable outstanding (DPO), aging buckets, and liquidity forecasting. | The contractual date by which the invoice must be paid to the vendor per the agreed payment terms, used for cash outflow scheduling and overdue liability tracking. | The contractual date by which payment must be received, used to calculate overdue balances and drive cash flow forecasting."@en ;
    rdfs:domain lpp:Invoice,
        lpp:Payable,
        lpp:Receivable ;
    rdfs:range xsd:date .

lpp:durationDays a owl:DatatypeProperty ;
    rdfs:comment "The effective duration of the investment instrument expressed in days, indicating the interest rate sensitivity and maturity profile of the position."@en ;
    rdfs:domain lpp:InvestmentPosition ;
    rdfs:range xsd:decimal .

lpp:earningsImpact a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:ebitda a owl:DatatypeProperty ;
    rdfs:comment "Earnings before interest, taxes, depreciation, and amortization for the reporting period, expressed in the company's reporting currency, used as a core measure of operating profitability in peer benchmarking. | The peer company's earnings before interest, taxes, depreciation, and amortization in absolute currency terms for the reporting period, used as a proxy for operating cash profitability."@en ;
    rdfs:domain lpp:CompanyFinancialMetric,
        lpp:PeerCompanyMetric .

lpp:effectiveFrom a owl:DatatypeProperty ;
    rdfs:comment "The date on which this acquirer contract becomes legally active and its terms begin to apply to card transaction processing."@en ;
    rdfs:domain lpp:AcquirerContract .

lpp:effectiveTo a owl:DatatypeProperty ;
    rdfs:comment "The date on which this acquirer contract expires or is scheduled to terminate, marking the end of the contractual terms."@en ;
    rdfs:domain lpp:AcquirerContract .

lpp:effectivenessRatio a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:eligibleSpend a owl:DatatypeProperty ;
    rdfs:comment "The gross card spend amount (in the reporting currency) that qualifies for rebate calculation under the corporate card program during the period, expressed as a decimal value."@en ;
    rdfs:domain lpp:CardRebateEarning .

lpp:epsImpact a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:esgKpiName a owl:DatatypeProperty ;
    rdfs:range xsd:string .

lpp:esgTargetValue a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:exceedsRateCard a owl:DatatypeProperty ;
    rdfs:comment "A boolean flag indicating whether the charged fee exceeds the negotiated rate card agreement with the bank, used to identify billing discrepancies and contract violations."@en ;
    rdfs:domain lpp:BankFee ;
    rdfs:range xsd:boolean .

lpp:exceptionType a owl:DatatypeProperty ;
    rdfs:comment "A categorical code classifying the nature of the payment exception, with values including BANK_VALIDATION (invalid or unrecognized bank details), DUPLICATE (repeated payment submission), FILE_FORMAT (malformed or non-compliant payment file), and OTHER (exceptions not fitting standard categories)."@en ;
    rdfs:domain lpp:PaymentException ;
    rdfs:range xsd:string .

lpp:expirationDate a owl:DatatypeProperty ;
    rdfs:comment "The date on which the facility commitment expires and the lender is no longer obligated to make funds available, which may differ from the maturity date for drawn balances. | The date on which this letter of credit expires and the issuing bank's obligation to honor draws ceases."@en ;
    rdfs:domain lpp:CreditFacility,
        lpp:LetterOfCredit ;
    rdfs:range xsd:date .

lpp:exposureCurrency a owl:ObjectProperty ;
    rdfs:comment "The foreign currency in which the exposure is denominated, identifying which currency drives the FX risk for this record."@en ;
    rdfs:domain lpp:FxExposure ;
    rdfs:range lpp:Currency .

lpp:exposureType a owl:DatatypeProperty ;
    rdfs:comment "Indicates whether the company holds a net long (asset/receivable) or short (liability/payable) position in the exposure currency."@en ;
    rdfs:domain lpp:FxExposure ;
    rdfs:range xsd:string .

lpp:faceAmount a owl:DatatypeProperty ;
    rdfs:comment "The par or face value of the investment instrument, representing the principal amount that will be returned at maturity. | The maximum notional amount the issuing bank is obligated to pay under this letter of credit, representing the full contingent liability."@en ;
    rdfs:domain lpp:InvestmentPosition,
        lpp:LetterOfCredit ;
    rdfs:range xsd:decimal .

lpp:feeAmount a owl:DatatypeProperty ;
    rdfs:comment "The monetary value of the individual bank fee charged, expressed in the associated currency, used to calculate total bank service costs. | The monetary amount charged for the membership fee in the local currency, reflecting the fee tier (e.g., 65.00 for standard, 130.00 for executive-level memberships)."@en ;
    rdfs:domain lpp:BankFee,
        lpp:MembershipFee ;
    rdfs:range xsd:decimal .

lpp:feeServiceType a owl:ObjectProperty ;
    rdfs:comment "A categorical reference describing the type of banking service for which the fee was charged, such as wire transfer, account maintenance, or lockbox processing. | A classification or label describing the type of treasury or payment service to which this rate card line applies, such as wire transfer, card acquiring, or FX conversion."@en ;
    rdfs:domain lpp:BankFee,
        lpp:RateCardLine ;
    rdfs:range lpp:FeeServiceType .

lpp:flagsTransaction a owl:ObjectProperty ;
    rdfs:domain lpp:PaymentException ;
    rdfs:range lpp:Transaction .

lpp:floatAmount a owl:DatatypeProperty ;
    rdfs:comment "Difference between ledger and available balance."@en ;
    rdfs:range xsd:decimal .

lpp:forAccount a owl:ObjectProperty ;
    rdfs:comment "A reference to the bank account entity to which this balance snapshot belongs, linking the balance record to a specific account in the treasury system. | A reference to the specific bank account against which the fee was assessed, linking this fee record to the corresponding BankAccount entity. | A reference to the specific bank or treasury account entity associated with this reconciliation item, linking the GL account to its corresponding external account record."@en ;
    rdfs:domain lpp:BalanceSnapshot,
        lpp:BankFee,
        lpp:ReconciliationItem ;
    rdfs:range lpp:BankAccount .

lpp:forAcquirer a owl:ObjectProperty ;
    rdfs:comment "A reference to the acquirer entity (linked via RDF relationship) for which these SLA metrics are recorded, identifying which acquiring bank or payment processor the row pertains to."@en ;
    rdfs:domain lpp:AcquirerSlaMetric ;
    rdfs:range lpp:Acquirer .

lpp:forCompany a owl:ObjectProperty ;
    rdfs:comment "A reference to the company entity for which this capital allocation record applies, supporting multi-entity or peer comparison scenarios within the data warehouse. | A foreign key reference linking the financial metric record to the specific peer or subject company entity in the ontology for which these metrics are reported. | A reference to the company entity that this credit rating applies to, linking the rating record to the specific organization being evaluated. | A reference to the company entity for which this equity action was performed, linking the record to the corresponding organization in the ontology."@en ;
    rdfs:domain lpp:CapitalAllocationActual,
        lpp:CompanyFinancialMetric,
        lpp:CreditRating,
        lpp:EquityAction ;
    rdfs:range lpp:Company .

lpp:forEntity a owl:ObjectProperty ;
    rdfs:comment "A reference to the legal entity (e.g., a subsidiary or operating company) for which the cash rollup is aggregated, linking this record to the relevant organizational unit in the treasury structure. | A reference to the legal entity or business unit for which this forecast-versus-actual comparison applies. | A reference to the legal entity or business unit for which this forecast cash flow line is being projected. | The legal entity or business unit for which the stress scenario run result was computed, enabling entity-level liquidity risk assessment and reporting. | A reference to the legal entity or organizational unit for which the working capital metrics are recorded, linking the metrics to a specific business or corporate entity in the ontology."@en ;
    rdfs:domain lpp:CashRollup,
        lpp:ForecastActual,
        lpp:ForecastLine,
        lpp:ScenarioAssumption,
        lpp:WorkingCapitalMetric ;
    rdfs:range lpp:Company .

lpp:forForecast a owl:ObjectProperty ;
    rdfs:comment "A reference to the parent forecast scenario or forecast run to which this individual cash flow line belongs, linking it to a specific forecast version or cycle."@en ;
    rdfs:domain lpp:ForecastLine ;
    rdfs:range lpp:CashForecast .

lpp:forPeer a owl:ObjectProperty ;
    rdfs:comment "A URI reference linking this metric record to the specific peer company entity in the ontology for which these financial and operational metrics are reported."@en ;
    rdfs:domain lpp:PeerCompanyMetric ;
    rdfs:range lpp:Peer .

lpp:forPlan a owl:ObjectProperty ;
    rdfs:comment "A reference linking this valuation record to the specific pension plan entity it describes, identifying which defined benefit plan the valuation applies to."@en ;
    rdfs:domain lpp:PensionValuation ;
    rdfs:range lpp:PensionPlan .

lpp:forRiskCategory a owl:ObjectProperty ;
    rdfs:domain lpp:VaRMetric ;
    rdfs:range lpp:RiskCategory .

lpp:forecastPeriod a owl:DatatypeProperty ;
    rdfs:comment "Period label like 2026-W18 or 2026-Q2."@en ;
    rdfs:range xsd:string .

lpp:forecastedInflow a owl:DatatypeProperty ;
    rdfs:comment "The projected amount of cash expected to be received by the entity during the forecast period, expressed in the specified currency."@en ;
    rdfs:domain lpp:ForecastLine ;
    rdfs:range xsd:decimal .

lpp:forecastedOutflow a owl:DatatypeProperty ;
    rdfs:comment "The projected cash outflow amount that was estimated for the given driver category and period prior to the close date. | The projected amount of cash expected to be disbursed by the entity during the forecast period, expressed in the specified currency."@en ;
    rdfs:domain lpp:ForecastActual,
        lpp:ForecastLine ;
    rdfs:range xsd:decimal .

lpp:frameworkTargetPct a owl:DatatypeProperty ;
    rdfs:comment "The target percentage of total available capital that the company's capital allocation framework prescribes should be deployed to this bucket, used as a benchmark against actual allocations."@en ;
    rdfs:domain lpp:CapitalAllocationActual .

lpp:fraudCategory a owl:ObjectProperty ;
    rdfs:domain lpp:FraudLossEvent ;
    rdfs:range lpp:FraudCategory .

lpp:fraudCategoryLabel a owl:DatatypeProperty ;
    rdfs:comment "The fraud risk classification label assigned by the fraud detection engine, indicating the outcome category of the evaluation such as ALLOW for approved transactions, REVIEW for transactions flagged for manual inspection, or BLOCK for transactions rejected due to suspected fraud."@en ;
    rdfs:domain lpp:FraudLossEvent ;
    rdfs:range xsd:string .

lpp:fraudLossAmount a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:fraudLossBps a owl:DatatypeProperty ;
    rdfs:comment "The peer company's fraud loss expressed in basis points of payment transaction volume, used to benchmark fraud management effectiveness across the industry."@en ;
    rdfs:domain lpp:PeerCompanyMetric .

lpp:fraudVector a owl:DatatypeProperty ;
    rdfs:comment "The attack method or fraud typology used to perpetrate the loss, such as social engineering or card-not-present fraud."@en ;
    rdfs:domain lpp:FraudLoss .

lpp:freeCashFlow a owl:DatatypeProperty ;
    rdfs:comment "Operating cash flow less capital expenditures for the reporting period, representing the cash available to service debt, pay dividends, or fund investments, used in peer cash generation comparisons. | The peer company's free cash flow in absolute currency terms for the reporting period, representing operating cash flow after capital expenditures and used to assess liquidity and financial flexibility."@en ;
    rdfs:domain lpp:CompanyFinancialMetric,
        lpp:PeerCompanyMetric .

lpp:fromAccount a owl:ObjectProperty ;
    rdfs:comment "The internal bank account identifier from which funds are debited as part of the intercompany transfer. | The identifier of the source bank account from which the funds are debited for this cash flow transaction, linking the transaction to a specific account in the treasury account master."@en ;
    rdfs:domain lpp:IntercompanyTransfer,
        lpp:Transaction ;
    rdfs:range lpp:BankAccount .

lpp:fromDetectionEvent a owl:ObjectProperty ;
    rdfs:comment "A reference linking this fraud loss record to the upstream fraud detection event that identified or flagged the transaction, enabling traceability from detection through to confirmed loss realization."@en ;
    rdfs:domain lpp:FraudLoss ;
    rdfs:range lpp:FraudEvent .

lpp:fundedBy a owl:ObjectProperty ;
    rdfs:comment "A reference to the funding source or cash pool that financed this investment position, linking the position to its liquidity origin."@en ;
    rdfs:domain lpp:InvestmentPosition ;
    rdfs:range lpp:BankAccount .

lpp:fundedStatus a owl:DatatypeProperty ;
    rdfs:comment "The net funded status of the pension plan in base currency, calculated as plan assets at fair value minus the projected benefit obligation; a positive value indicates an overfunded plan and a negative value indicates an underfunded plan."@en ;
    rdfs:domain lpp:PensionValuation ;
    rdfs:range xsd:decimal .

lpp:fxRate a owl:DatatypeProperty ;
    rdfs:comment "The numeric exchange rate value representing how many units of the target currency are equivalent to one unit of the source currency on the given date."@en ;
    rdfs:domain lpp:FxRate ;
    rdfs:range xsd:decimal .

lpp:fxRateFrom a owl:ObjectProperty ;
    rdfs:comment "The source currency code (e.g., USD) from which the conversion is being made, forming the base leg of the currency pair."@en ;
    rdfs:domain lpp:FxRate ;
    rdfs:range lpp:Currency .

lpp:fxRateTo a owl:ObjectProperty ;
    rdfs:comment "The target currency code (e.g., MXN) into which the source currency is being converted, forming the quote leg of the currency pair."@en ;
    rdfs:domain lpp:FxRate ;
    rdfs:range lpp:Currency .

lpp:fxSpreadBps a owl:DatatypeProperty ;
    rdfs:comment "The foreign exchange spread charged on the payment leg expressed in basis points, representing the cost markup above the interbank mid-rate applied during currency conversion for this corridor."@en ;
    rdfs:domain lpp:CrossBorderPaymentLeg .

lpp:governedBy a owl:ObjectProperty ;
    rdfs:comment "A reference to the contractual agreement or rate card that defines the terms and expected pricing for this fee, used to validate charges against negotiated terms."@en ;
    rdfs:domain lpp:BankFee ;
    rdfs:range lpp:RateCard .

lpp:grossAmount a owl:DatatypeProperty ;
    rdfs:comment "The gross transaction amount settled in the transaction currency before deducting interchange fees or other adjustments, representing the top-line card revenue for this line item."@en ;
    rdfs:domain lpp:CardSettlementLine .

lpp:grossExposure a owl:DatatypeProperty ;
    rdfs:comment "The total absolute value of the forecasted foreign currency exposure in the base reporting currency, before any hedging offsets are applied."@en ;
    rdfs:domain lpp:FxExposure ;
    rdfs:range xsd:decimal .

lpp:grossSaleAmount a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:grossSalesAmount a owl:DatatypeProperty ;
    rdfs:comment "The total face value of card sales transactions submitted for settlement before any fee deductions, representing gross card revenue for the day. | The total face value of all card sales captured in the batch before any deductions for interchange, network assessments, or processor fees, expressed in the settlement currency."@en ;
    rdfs:domain lpp:CardPaymentRollup,
        lpp:CardSettlementBatch .

lpp:hasCovenant a owl:ObjectProperty ;
    rdfs:domain lpp:CreditFacility ;
    rdfs:range lpp:Covenant .

lpp:hasCurrency a owl:ObjectProperty ;
    rdfs:comment "A reference to the currency (RDF resource) in which this bank account is denominated, such as USD, EUR, or GBP, governing the currency of all transactions and balances. | A relationship linking the credit facility to its designated currency entity, identifying the currency in which the facility is denominated and drawn. | The currency denomination of the investment instrument, linking to a currency entity and used to manage FX exposure within the cash investment portfolio."@en ;
    rdfs:domain lpp:BankAccount,
        lpp:CreditFacility,
        lpp:InvestmentInstrument ;
    rdfs:range lpp:Currency .

lpp:hasInstrument a owl:ObjectProperty ;
    rdfs:comment "A reference to the specific fixed-income instrument or security associated with this investment position, such as a Treasury bill, commercial paper, or money-market fund."@en ;
    rdfs:domain lpp:InvestmentPosition ;
    rdfs:range lpp:InvestmentInstrument .

lpp:hedgeRatio a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:hedgedAmount a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:hedges a owl:ObjectProperty ;
    rdfs:domain lpp:HedgePosition ;
    rdfs:range lpp:FxExposure .

lpp:heldAt a owl:ObjectProperty ;
    rdfs:label "held at"@en ;
    rdfs:comment "A reference to the financial institution (RDF resource) at which this account is maintained, identifying the bank or counterparty holding the funds."@en ;
    rdfs:domain lpp:BankAccount ;
    rdfs:range lpp:Bank .

lpp:heldBy a owl:ObjectProperty ;
    rdfs:comment "A reference to the legal entity, bank account, or custodian that holds this investment position on behalf of the company."@en ;
    rdfs:domain lpp:InvestmentPosition ;
    rdfs:range lpp:Company .

lpp:horizonDays a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

lpp:idleAmount a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:inBatch a owl:ObjectProperty ;
    rdfs:comment "A reference to the parent card settlement batch that this line item belongs to, linking the individual settlement line to its aggregated batch for reconciliation purposes."@en ;
    rdfs:domain lpp:CardSettlementLine ;
    rdfs:range lpp:SettleBatch .

lpp:inCountry a owl:ObjectProperty ;
    rdfs:comment "Stores the country in which the bank branch is located, used to group branches by national jurisdiction for regulatory reporting and cross-border cash management. | Stores the country in which the legal entity is incorporated or operationally domiciled, used to determine regulatory jurisdiction, currency exposure, and applicable tax or compliance frameworks."@en ;
    rdfs:domain lpp:Branch,
        lpp:LegalEntity ;
    rdfs:range lpp:Country .

lpp:inLast30Days a owl:DatatypeProperty ;
    rdfs:comment "Boolean or numeric flag indicating whether the invoice falls within the most recent 30-day window, used for short-term cash outflow analysis and near-term payment obligation reporting. | Boolean or numeric flag indicating whether the invoice was created, due, or settled within the last 30 calendar days, used for short-term cash inflow forecasting. | The total amount of funds received into the account over the trailing 30-day period from the snapshot date, used for short-term cash flow analysis. | The total amount of cash received into accounts during the most recent 30-day rolling period, used for monthly liquidity and cash inflow trend analysis. | A boolean or numeric flag indicating whether the payment transaction occurred within the last 30 calendar days, used to support rolling monthly payment volume and trend analysis. | A flag or count indicating whether or to what extent settlement batch activity falls within the most recent 30-day rolling window, used for monthly trend analysis and reconciliation. | A boolean or numeric flag indicating whether this sweep event occurred within the last 30 days relative to the reporting date, used for rolling period analysis. | Aggregate measure or flag indicating transfer activity that occurred within the most recent 30-day rolling window, used for monthly cash flow and liquidity analysis."@en ;
    rdfs:domain lpp:ApInvoice,
        lpp:ArInvoice,
        lpp:Balance,
        lpp:CashFlow,
        lpp:PaymentTxn,
        lpp:SettleBatch,
        lpp:SweepEvent,
        lpp:Transfer ;
    rdfs:range xsd:boolean .

lpp:inLast7Days a owl:DatatypeProperty ;
    rdfs:comment "The total amount of funds received into the account over the trailing 7-day period from the snapshot date, used for near-term liquidity monitoring. | The total amount of cash received into accounts during the most recent 7-day rolling period, used for short-term weekly cash inflow monitoring and near-term liquidity forecasting. | A boolean or numeric flag indicating whether the payment transaction occurred within the last 7 calendar days, used to support short-term liquidity monitoring and weekly payment activity reporting. | A flag or count indicating whether or to what extent settlement batch activity falls within the most recent 7-day rolling window, used for weekly operational monitoring of card settlement throughput. | A boolean or numeric flag indicating whether this sweep event occurred within the last 7 days relative to the reporting date, used for near-term liquidity monitoring. | Aggregate measure or flag indicating transfer activity that occurred within the most recent 7-day rolling window, used for short-term cash position monitoring and weekly treasury reporting."@en ;
    rdfs:domain lpp:Balance,
        lpp:CashFlow,
        lpp:PaymentTxn,
        lpp:SettleBatch,
        lpp:SweepEvent,
        lpp:Transfer ;
    rdfs:range xsd:boolean .

lpp:inLast90Days a owl:DatatypeProperty ;
    rdfs:comment "Boolean or numeric flag indicating whether the invoice falls within the most recent 90-day window, used for quarterly working capital assessments and medium-term payables trend analysis. | Boolean or numeric flag indicating whether the invoice falls within the last 90 calendar days, supporting quarterly receivables aging and working capital reporting. | The total amount of funds received into the account over the trailing 90-day period from the snapshot date, supporting medium-term cash flow trend analysis. | The total amount of cash received into accounts during the most recent 90-day rolling period, used for quarterly cash inflow analysis and medium-term treasury planning. | A boolean or numeric flag indicating whether the payment transaction occurred within the last 90 calendar days, used to support quarterly payment trend analysis and medium-term cash flow assessments. | A flag or count indicating whether or to what extent settlement batch activity falls within the most recent 90-day rolling window, used for quarterly performance reviews and settlement pattern analysis. | A boolean or numeric flag indicating whether this sweep event occurred within the last 90 days relative to the reporting date, used for quarterly cash movement analysis. | Aggregate measure or flag indicating transfer activity that occurred within the most recent 90-day rolling window, used for quarterly trend analysis and working capital assessments."@en ;
    rdfs:domain lpp:ApInvoice,
        lpp:ArInvoice,
        lpp:Balance,
        lpp:CashFlow,
        lpp:PaymentTxn,
        lpp:SettleBatch,
        lpp:SweepEvent,
        lpp:Transfer ;
    rdfs:range xsd:boolean .

lpp:inLastYear a owl:DatatypeProperty ;
    rdfs:comment "Boolean or numeric flag indicating whether the invoice falls within the most recent 12-month window, used for annual spend analysis, vendor payment history reporting, and year-over-year payables benchmarking. | Boolean or numeric flag indicating whether the invoice activity occurred within the last 12 months, used for annual trend analysis of accounts receivable and revenue recognition. | The total amount of funds received into the account over the trailing 12-month period from the snapshot date, used for annual cash flow benchmarking and planning. | The total amount of cash received into accounts during the most recent 365-day rolling period, used for annual cash inflow benchmarking, trend analysis, and long-term liquidity strategy. | A boolean or numeric flag indicating whether the payment transaction occurred within the last 365 calendar days, used to support annual payment volume benchmarking and year-over-year trend comparisons. | A flag or count indicating whether or to what extent settlement batch activity falls within the most recent 365-day rolling window, used for annual benchmarking and year-over-year comparison of card settlement volumes. | A boolean or numeric flag indicating whether this sweep event occurred within the last 365 days relative to the reporting date, used for annual sweep activity reporting. | Aggregate measure or flag indicating transfer activity that occurred within the most recent 365-day rolling window, used for annual liquidity benchmarking and year-over-year cash movement comparisons."@en ;
    rdfs:domain lpp:ApInvoice,
        lpp:ArInvoice,
        lpp:Balance,
        lpp:CashFlow,
        lpp:PaymentTxn,
        lpp:SettleBatch,
        lpp:SweepEvent,
        lpp:Transfer ;
    rdfs:range xsd:boolean .

lpp:inRegion a owl:ObjectProperty ;
    rdfs:comment "Stores the regional classification of the bank branch (e.g., geographic region or sub-national territory), enabling aggregation of cash positions and transaction activity at the regional level."@en ;
    rdfs:domain lpp:Branch ;
    rdfs:range lpp:Region .

lpp:inSector a owl:ObjectProperty ;
    rdfs:range lpp:IndustrySector .

lpp:incidentDate a owl:DatatypeProperty ;
    rdfs:range xsd:date .

lpp:incidentImpact a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:indicatorCode a owl:DatatypeProperty ;
    rdfs:comment "A standardized code identifying the specific macroeconomic indicator being recorded, such as FED_FUNDS for the US Federal Funds Rate."@en ;
    rdfs:domain lpp:MacroIndicator .

lpp:initiatedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

lpp:initiatedDate a owl:DatatypeProperty ;
    rdfs:comment "The calendar date on which the chargeback dispute was formally opened by the issuing bank or cardholder."@en ;
    rdfs:domain lpp:Chargeback .

lpp:instrumentType a owl:ObjectProperty ;
    rdfs:comment "Categorical classification of the investment instrument (e.g., money market fund, treasury bill, commercial paper), used to segment and report the portfolio by asset class."@en ;
    rdfs:domain lpp:InvestmentInstrument ;
    rdfs:range lpp:InstrumentType .

lpp:interchangeAmount a owl:DatatypeProperty ;
    rdfs:comment "The interchange fees assessed by the card networks and paid to issuing banks, representing typically the largest component of card acceptance cost deducted from gross sales. | The interchange fee amount deducted from gross sales and remitted to the card-issuing banks as mandated by the card network, expressed in the settlement currency."@en ;
    rdfs:domain lpp:CardPaymentRollup,
        lpp:CardSettlementBatch ;
    rdfs:range xsd:decimal .

lpp:interchangeBps a owl:DatatypeProperty ;
    rdfs:comment "The interchange fee rate applied to this settlement line expressed in basis points, used to calculate the cost of card acceptance charged by the card network to the acquirer."@en ;
    rdfs:domain lpp:CardSettlementLine .

lpp:interestRate a owl:DatatypeProperty ;
    rdfs:comment "The annualized benchmark interest rate value expressed as a percentage for the given code, currency, and tenor as of the observation date."@en ;
    rdfs:domain lpp:InterestRateBenchmark ;
    rdfs:range xsd:decimal .

lpp:invoiceAmount a owl:DatatypeProperty ;
    rdfs:comment "The face value of the invoice in the specified currency, representing the obligation or receivable amount submitted for financing or payment. | The total monetary amount of the invoice as billed by the vendor in the invoice currency, representing the gross payable obligation. | The total monetary value of the invoice in the invoice currency, representing the gross amount billed to the customer."@en ;
    rdfs:domain lpp:Invoice,
        lpp:Payable,
        lpp:Receivable ;
    rdfs:range xsd:decimal .

lpp:invoiceDate a owl:DatatypeProperty ;
    rdfs:comment "The date the invoice was originally issued by the supplier or biller, used to determine invoice tenor, early payment discount windows, and aging calculations. | The date the vendor issued the invoice, used as the anchor date for calculating payment term due dates and aging analysis. | The date on which the invoice was issued to the customer, used as the starting point for payment terms calculation and aging analysis."@en ;
    rdfs:domain lpp:Invoice,
        lpp:Payable,
        lpp:Receivable ;
    rdfs:range xsd:date .

lpp:isCurrent a owl:DatatypeProperty ;
    rdfs:comment "A boolean flag indicating whether this rating record represents the most current active rating from the given agency, distinguishing current ratings from superseded historical ones."@en ;
    rdfs:domain lpp:CreditRating .

lpp:isLatestSnapshot a owl:DatatypeProperty ;
    rdfs:comment "A boolean flag indicating whether this record represents the most recent balance snapshot for the associated bank account, used to filter for current cash positions."@en ;
    rdfs:domain lpp:Balance,
        lpp:BalanceSnapshot ;
    rdfs:range xsd:boolean .

lpp:issueDate a owl:DatatypeProperty ;
    rdfs:comment "The date on which this letter of credit was formally issued and became effective."@en ;
    rdfs:domain lpp:LetterOfCredit .

lpp:issuedBy a owl:ObjectProperty ;
    rdfs:comment "A reference to the financial institution or bank counterparty that issued and is obligated under this letter of credit."@en ;
    rdfs:domain lpp:LetterOfCredit ;
    rdfs:range lpp:Bank .

lpp:issuedDate a owl:DatatypeProperty ;
    rdfs:comment "The calendar date on which the membership fee was issued or billed to the member."@en ;
    rdfs:domain lpp:MembershipFee .

lpp:issuerBank a owl:ObjectProperty ;
    rdfs:comment "The name or identifier of the financial institution that issues the card and is contractually obligated to pay the rebate, linking this program to the company's banking relationship records. | Reference to the bank or financial institution that issues or manages the investment instrument, used for counterparty concentration risk monitoring and credit exposure reporting."@en ;
    rdfs:domain lpp:CardRebateProgram,
        lpp:InvestmentInstrument ;
    rdfs:range lpp:Bank ;
    rdfs:subPropertyOf lpp:counterparty .

lpp:issuerCountry a owl:DatatypeProperty ;
    rdfs:comment "The ISO 3166-1 alpha-2 country code of the bank or financial institution that issued the payment card, used to identify cross-border transactions and assess geographic risk concentration."@en ;
    rdfs:domain lpp:CardSettlementLine .

lpp:issuingBin a owl:DatatypeProperty ;
    rdfs:range xsd:string .

lpp:issuingCountry a owl:DatatypeProperty ;
    rdfs:range xsd:string .

lpp:lcNumber a owl:DatatypeProperty ;
    rdfs:comment "The unique alphanumeric identifier assigned to this letter of credit, used for tracking and reconciliation across treasury and banking systems."@en ;
    rdfs:domain lpp:LetterOfCredit .

lpp:lcType a owl:DatatypeProperty ;
    rdfs:comment "Classifies the letter of credit as either STANDBY (guaranteeing performance or payment obligations) or COMMERCIAL (facilitating payment for trade goods and services)."@en ;
    rdfs:domain lpp:LetterOfCredit .

lpp:ledgerAccount a owl:DatatypeProperty ;
    rdfs:comment "The ledger account reference key used to link this GL account to transactions and journal entries in the general ledger system; in the current dataset this mirrors the code column and serves as the formal ledger identifier. | A compound identifier combining the GL account number and entity or region code (e.g., '7000-GR_GB'), used to uniquely identify a specific ledger account within a particular legal entity or geographic unit. | The general ledger account identifier, combining the account number and the associated legal entity or regional operating unit, used to uniquely identify the account being reconciled."@en ;
    rdfs:domain lpp:GlAccount,
        lpp:LedgerEntry,
        lpp:ReconciliationItem ;
    rdfs:range xsd:string .

lpp:ledgerBalance a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:ledgerSide a owl:ObjectProperty ;
    rdfs:domain lpp:ReconciliationItem ;
    rdfs:range lpp:LedgerEntry .

lpp:lei a owl:DatatypeProperty ;
    rdfs:comment "The Legal Entity Identifier (LEI), a globally recognized 20-character alphanumeric code uniquely identifying the bank as a legal entity for regulatory and counterparty risk purposes. | Legal Entity Identifier (LEI) as defined by the Global LEI System (GLEIF), used for regulatory reporting, FX counterparty verification, and cross-border payment compliance."@en ;
    rdfs:domain lpp:Bank,
        lpp:Company ;
    rdfs:range xsd:string .

lpp:lender a owl:ObjectProperty ;
    rdfs:comment "A relationship identifying the financial institution or syndicate member(s) providing the credit commitment under the facility."@en ;
    rdfs:domain lpp:CreditFacility,
        lpp:DebtInstrument ;
    rdfs:range lpp:Bank ;
    rdfs:subPropertyOf lpp:counterparty .

lpp:liftingFees a owl:DatatypeProperty ;
    rdfs:comment "The flat or variable fee charged to execute and lift the payment through correspondent banking or payment networks, expressed in the transaction currency, representing the direct transaction cost excluding FX spread."@en ;
    rdfs:domain lpp:CrossBorderPaymentLeg .

lpp:linkedToTarget a owl:ObjectProperty ;
    rdfs:domain lpp:SustainabilityLinkedInstrument ;
    rdfs:range lpp:EsgTarget .

lpp:locationCode a owl:DatatypeProperty ;
    rdfs:comment "A unique identifier for the warehouse or retail location where the transaction occurred, following a structured naming convention that encodes country and site number (e.g., WH_DE_0002 for Germany warehouse 2)."@en ;
    rdfs:domain lpp:PosTransaction .

lpp:lossAmount a owl:DatatypeProperty ;
    rdfs:comment "The confirmed monetary value of the fraud loss in the local or reporting currency, representing the net financial impact recognized for this fraud event."@en ;
    rdfs:domain lpp:FraudLoss .

lpp:lossCategory a owl:DatatypeProperty ;
    rdfs:comment "The classification of the fraud loss as either true fraud (unauthorized third-party fraud) or friendly fraud (disputed legitimate transactions, typically chargeback abuse)."@en ;
    rdfs:domain lpp:FraudLoss .

lpp:lossDate a owl:DatatypeProperty ;
    rdfs:comment "The calendar date on which the fraud loss was recognized or finalized, used for period-over-period loss trending and reserve calculations."@en ;
    rdfs:domain lpp:FraudLoss .

lpp:marketValue a owl:DatatypeProperty ;
    rdfs:comment "The current fair market value of the investment position, used to calculate unrealized gains or losses relative to book value."@en ;
    rdfs:domain lpp:InvestmentPosition ;
    rdfs:range xsd:decimal .

lpp:maturityDate a owl:DatatypeProperty ;
    rdfs:comment "The final legal maturity date by which all outstanding drawn amounts under the facility must be fully repaid. | The scheduled date on which the principal of the borrowing is due to be fully repaid or the facility expires. | The date on which the investment instrument matures and principal is returned, used to assess liquidity horizon and match funding needs."@en ;
    rdfs:domain lpp:CreditFacility,
        lpp:DebtMaturity,
        lpp:InvestmentInstrument ;
    rdfs:range xsd:date .

lpp:measurementDate a owl:DatatypeProperty ;
    rdfs:comment "The calendar date for which the SLA metrics were recorded, used to track acquirer performance trends over time."@en ;
    rdfs:domain lpp:AcquirerSlaMetric .

lpp:metricDate a owl:DatatypeProperty ;
    rdfs:comment "The calendar date for which the throughput and processing metrics are recorded, enabling time-series analysis of payment hub performance."@en ;
    rdfs:domain lpp:PaymentHubThroughput .

lpp:metricName a owl:DatatypeProperty ;
    rdfs:range xsd:string .

lpp:metricValue a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:minimumThreshold a owl:DatatypeProperty ;
    rdfs:comment "The minimum cash balance or transaction amount that must be present in the source account before a sweep is triggered, preventing unnecessary transfers for insignificant balances."@en ;
    rdfs:domain lpp:SweepRule ;
    rdfs:range xsd:decimal .

lpp:mtmAmount a owl:DatatypeProperty ;
    rdfs:comment "The mark-to-market fair value of the derivative instrument as of the valuation date, expressed as a positive value for unrealized gains and a negative value for unrealized losses."@en ;
    rdfs:domain lpp:DerivativeMtm ;
    rdfs:range xsd:decimal .

lpp:nAccounts a owl:DatatypeProperty ;
    rdfs:comment "The count of distinct bank accounts included in the cash rollup for this entity, currency, and date combination."@en ;
    rdfs:domain lpp:CashRollup ;
    rdfs:range xsd:integer .

lpp:name a owl:DatatypeProperty ;
    rdfs:comment "The full legal or trading name of the acquiring entity, including parent company context where relevant (e.g., Elavon (US Bancorp), Fiserv (First Data)). | The full legal name of the banking institution as registered with regulatory authorities. | The full human-readable display name of the card network as used in business reports and dashboards (e.g., Visa, American Express, Costco Private Label). | A human-readable label describing the forecast type and horizon, distinguishing between methodologies such as the 13-week direct forecast and the 18-month indirect forecast. | Full legal or commonly used business name of the company as recognized in contracts, banking agreements, and treasury records. | The full descriptive name of the counterparty, identifying either a specific named retail or financial partner (e.g., Macys Partner 1, Selfridges Partner 5) or a consolidated category such as Aggregated Retail Consumer for bulk consumer transaction groupings. | The full, human-readable name of the currency corresponding to its ISO 4217 code, used for display purposes in reports, dashboards, and business-facing documentation. | A human-readable label describing the bank service fee type, such as account maintenance charges, wire transfer fees (domestic or international), ACH credits, or statement delivery costs. | The human-readable display name of the GL account, describing its cash purpose and regional entity association (e.g., 'Cash - GR_AE OPERATING Account') for use in financial reporting and treasury dashboards. | The full legal registered name of the peer company as used in financial filings and external reporting. | The given name of the application user associated with the role code, used for display, audit trails, and workflow attribution within the treasury and payments platform. | A human-readable description of the stress scenario that specifies the nature, magnitude, and duration of the shock, as displayed in risk dashboards and treasury reports."@en ;
    rdfs:domain lpp:Acquirer,
        lpp:Bank,
        lpp:CardNetwork,
        lpp:CashForecast,
        lpp:Company,
        lpp:Counterparty,
        lpp:Currency,
        lpp:FeeServiceType,
        lpp:GlAccount,
        lpp:PeerCompany,
        lpp:Person,
        lpp:StressTest ;
    rdfs:range xsd:string .

lpp:negotiatedRate a owl:DatatypeProperty ;
    rdfs:comment "The contractually agreed fee rate for the service line, expressed as a numeric value (e.g., basis points or percentage) reflecting the terms negotiated with the charging entity."@en ;
    rdfs:domain lpp:RateCardLine ;
    rdfs:range xsd:decimal .

lpp:netDebt a owl:DatatypeProperty ;
    rdfs:comment "Total financial debt minus cash and cash equivalents for the reporting period; negative values indicate a net cash position, used to assess balance sheet strength and leverage relative to peers. | The peer company's net debt position in absolute currency terms, calculated as total financial debt minus cash and cash equivalents; negative values indicate a net cash position."@en ;
    rdfs:domain lpp:CompanyFinancialMetric,
        lpp:PeerCompanyMetric .

lpp:netExposure a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:netSettlementAmount a owl:DatatypeProperty ;
    rdfs:comment "The actual net amount funded by the acquirer to the company after all fees are deducted from gross sales, representing the cash received in the settlement bank account. | The actual amount deposited to the company's bank account after subtracting interchange, network assessment, and processor margin from gross sales, representing the true cash received."@en ;
    rdfs:domain lpp:CardPaymentRollup,
        lpp:CardSettlementBatch ;
    rdfs:range xsd:decimal .

lpp:networkAssessmentAmount a owl:DatatypeProperty ;
    rdfs:comment "The fees charged by the card network (e.g., Visa, Mastercard) for transaction processing and network access, separate from interchange and assessed on gross volume. | The fee assessed by the card network (e.g., Visa, Mastercard) on the batch volume, deducted from gross sales as part of the cost of network participation."@en ;
    rdfs:domain lpp:CardPaymentRollup,
        lpp:CardSettlementBatch .

lpp:networkFeeAmount a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:networkType a owl:DatatypeProperty ;
    rdfs:comment "Classifies the card network by its payment rail and credit structure, with values such as CREDIT, CHARGE, PRIVATE_LABEL, and DEBIT_PIN, enabling cost and risk segmentation across different funding and liability models."@en ;
    rdfs:domain lpp:CardNetwork .

lpp:nextRecertifyDueDate a owl:DatatypeProperty ;
    rdfs:comment "The date by which this signatory's authorization must be formally reviewed and recertified to remain active and compliant with internal treasury governance policies."@en ;
    rdfs:domain lpp:BankAccountSignatory .

lpp:notionalAmount a owl:DatatypeProperty ;
    rdfs:comment "The face value or principal amount of the hedge position in the hedged currency, representing the scale of foreign currency exposure being protected."@en ;
    rdfs:domain lpp:HedgePosition ;
    rdfs:range xsd:decimal .

lpp:ociImpact a owl:DatatypeProperty ;
    rdfs:comment "The dollar amount of actuarial gains or losses and prior service costs recognized in other comprehensive income (OCI) during the period, representing the portion of pension remeasurement not immediately recorded in net income."@en ;
    rdfs:domain lpp:PensionValuation ;
    rdfs:range xsd:decimal .

lpp:onBankAccount a owl:ObjectProperty ;
    rdfs:comment "A reference to the bank account entity for which this signatory authorization applies, linking the signatory to a specific account in the treasury system."@en ;
    rdfs:domain lpp:BankAccountSignatory ;
    rdfs:range lpp:BankAccount .

lpp:onFile a owl:ObjectProperty ;
    rdfs:comment "An indicator of whether supporting documentation or evidence related to the payment exception has been filed or attached, used for audit trail and compliance record-keeping purposes."@en ;
    rdfs:domain lpp:PaymentException ;
    rdfs:range lpp:PaymentFile .

lpp:onNetwork a owl:ObjectProperty ;
    rdfs:comment "Indicates the payment network over which the authorization was routed, such as Visa or Mastercard; no samples available in current dataset. | Identifies the card network (e.g., Visa, Mastercard, Amex) over which the settlement batch was processed, used to segment acceptance costs and volumes by network. | A reference to the card network (e.g., Visa, Mastercard, Amex) over which the transactions in this batch were processed and settled. | An indicator or identifier specifying which card network (e.g., Visa, Mastercard, Amex) is governing and processing the chargeback dispute."@en ;
    rdfs:domain lpp:CardAuthorization,
        lpp:CardPaymentRollup,
        lpp:CardSettlementBatch,
        lpp:CardTransaction,
        lpp:Chargeback ;
    rdfs:range lpp:CardNetwork .

lpp:onTimePaymentRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:onTimeRate a owl:DatatypeProperty ;
    rdfs:comment "The proportion of invoices paid on or before their due date for the vendor in the given month, expressed as a decimal between 0 and 1, where 1.0 indicates all invoices were paid on time."@en ;
    rdfs:domain lpp:VendorPaymentRollup ;
    rdfs:range xsd:decimal .

lpp:openingBalance a owl:DatatypeProperty ;
    rdfs:comment "The starting ledger balance of the bank account at the beginning of the statement period or snapshot date, used as the baseline for reconciliation and period-over-period analysis."@en ;
    rdfs:domain lpp:Balance ;
    rdfs:range xsd:decimal .

lpp:originalTransfer a owl:ObjectProperty ;
    rdfs:comment "A reference to the original ACH transfer record that was returned, linking this return to its source transaction for reconciliation and dispute management."@en ;
    rdfs:domain lpp:AchReturn ;
    rdfs:range lpp:Transfer .

lpp:originatedBy a owl:ObjectProperty ;
    rdfs:comment "A reference to the entity or system that originated the original ACH transfer, such as a vendor, counterparty, or internal payment process, used to attribute returns to their source."@en ;
    rdfs:domain lpp:AchReturn ;
    rdfs:range lpp:Company .

lpp:originatingSystem a owl:DatatypeProperty ;
    rdfs:range xsd:string .

lpp:originationCountry a owl:DatatypeProperty ;
    rdfs:comment "ISO 3166-1 alpha-2 country code representing the sending country where the payment leg originates, used to determine regulatory requirements, correspondent bank selection, and cost structure."@en ;
    rdfs:domain lpp:CrossBorderPaymentLeg .

lpp:originator a owl:ObjectProperty ;
    rdfs:comment "The legal entity or subsidiary that initiates and sends the intercompany transfer, representing the funding source. | The entity or system responsible for generating and submitting the payment file, identifying the source business unit, treasury system, or automated process that initiated the batch payment submission."@en ;
    rdfs:domain lpp:IntercompanyTransfer,
        lpp:PaymentFile,
        lpp:Transaction ;
    rdfs:range lpp:Company .

lpp:outlook a owl:DatatypeProperty ;
    rdfs:comment "The rating agency's forward-looking assessment of the likely direction of the credit rating, such as Stable or Positive, indicating expected near-term credit trajectory."@en ;
    rdfs:domain lpp:CreditRating .

lpp:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by"@en ;
    rdfs:comment "A reference to the legal entity, business unit, or organizational division (RDF resource) that owns and is responsible for this bank account within the corporate structure."@en ;
    rdfs:domain lpp:BankAccount ;
    rdfs:range lpp:Company .

lpp:paidDate a owl:DatatypeProperty ;
    rdfs:comment "The actual date on which payment was made to the vendor, used to calculate early or late payment relative to the due date and to confirm settlement. | The actual date on which full payment was received and settled, used to measure payment timeliness and compute realized DSO."@en ;
    rdfs:domain lpp:Payable,
        lpp:Receivable ;
    rdfs:range xsd:date .

lpp:parentEntity a owl:ObjectProperty ;
    rdfs:domain lpp:Company ;
    rdfs:range lpp:Company .

lpp:partOfRegion a owl:ObjectProperty ;
    rdfs:domain lpp:Country ;
    rdfs:range lpp:Region .

lpp:paymentMethod a owl:ObjectProperty ;
    rdfs:comment "The identifier or name of the payment method being summarized (e.g., credit card, debit card, ACH, wire), serving as the primary dimension for segmenting performance metrics across payment channels. | The mechanism or channel used to execute the payment (e.g., SWIFT, SEPA, CHAPS, or local clearing), determining the routing and settlement timeline of the transaction. | The payment instrument used for the transaction, such as credit card, debit card, cash, or digital wallet, relevant for card acquiring fee analysis and payment mix reporting."@en ;
    rdfs:domain lpp:PaymentMethodRollup,
        lpp:PaymentTransaction,
        lpp:PosTransaction ;
    rdfs:range lpp:PaymentMethod .

lpp:paymentRail a owl:DatatypeProperty ;
    rdfs:comment "The payment network or protocol over which transactions were processed on the given date, such as WIRE (domestic/international wire transfer), SEPA_CT (SEPA Credit Transfer for EUR payments), ACH (Automated Clearing House for batch payments), or RTP (Real-Time Payments for instant settlement)."@en ;
    rdfs:domain lpp:PaymentHubThroughput .

lpp:paymentTerms a owl:DatatypeProperty ;
    rdfs:comment "The agreed payment terms between the company and the vendor (e.g., NET_30, NET_60, EOM_5), defining the time window within which payment is due after the invoice date. | The agreed payment terms code defining when payment is due relative to the invoice date, such as NET_0 indicating immediate payment is required."@en ;
    rdfs:domain lpp:Payable,
        lpp:Receivable ;
    rdfs:range xsd:string .

lpp:paymentsCostPctRevenue a owl:DatatypeProperty ;
    rdfs:comment "The peer company's total payments acceptance and processing cost expressed as a percentage of revenue, used to benchmark payments efficiency and cost competitiveness."@en ;
    rdfs:domain lpp:PeerCompanyMetric .

lpp:pbo a owl:DatatypeProperty ;
    rdfs:comment "The projected benefit obligation (PBO) in base currency, representing the actuarial present value of all future pension benefits earned by employees to date, incorporating assumptions about future salary increases and demographic factors."@en ;
    rdfs:domain lpp:PensionValuation .

lpp:peerGroup a owl:DatatypeProperty ;
    rdfs:comment "A categorical classification grouping the peer company by retail format or business model (e.g., BIG_BOX_RETAIL, GROCERY, ECOMMERCE), used to filter and segment benchmark comparisons by competitive peer set."@en ;
    rdfs:domain lpp:PeerCompany .

lpp:peerPercentile a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:periodDate a owl:DatatypeProperty ;
    rdfs:comment "The end date of the reporting period for which the capital allocation actuals are recorded, typically representing a quarter-end or fiscal period close date. | The quarter-end date representing the reporting period for which the eligible spend and rebate earned figures are calculated, formatted as YYYY-MM-DD. | The calendar end date of the financial reporting period (quarter-end or year-end) to which the metrics apply, enabling time-series and cross-period comparisons. | The end date of the reporting period (typically a fiscal quarter-end) for which the peer company's metrics are recorded."@en ;
    rdfs:domain lpp:CapitalAllocationActual,
        lpp:CardRebateEarning,
        lpp:CompanyFinancialMetric,
        lpp:PeerCompanyMetric .

lpp:periodMonth a owl:DatatypeProperty ;
    rdfs:comment "The calendar month (formatted as YYYY-MM) for which the rollup metrics are aggregated, representing the accounting period of the underlying invoices."@en ;
    rdfs:domain lpp:VendorPaymentRollup ;
    rdfs:range xsd:string .

lpp:periodType a owl:DatatypeProperty ;
    rdfs:comment "A code indicating the frequency of the reporting period, such as 'Q' for quarterly or 'A' for annual, used to filter and align metrics across peers on a consistent basis."@en ;
    rdfs:domain lpp:CompanyFinancialMetric .

lpp:planAssetValue a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:planAssetsFairValue a owl:DatatypeProperty ;
    rdfs:comment "The fair value of all assets held in the pension trust or fund as of the measurement date, used to determine the plan's ability to meet its projected benefit obligations."@en ;
    rdfs:domain lpp:PensionValuation .

lpp:planType a owl:DatatypeProperty ;
    rdfs:comment "Categorizes the pension plan structure, where DB indicates a traditional defined benefit plan with fixed employer obligations and HYBRID indicates a plan combining elements of both defined benefit and defined contribution arrangements."@en ;
    rdfs:domain lpp:PensionPlan .

lpp:pricePerShare a owl:DatatypeProperty ;
    rdfs:comment "The price per share at which shares were repurchased during a buyback, or the market reference price associated with the equity action."@en ;
    rdfs:domain lpp:EquityAction .

lpp:pricingAdjustmentBps a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:principalAmount a owl:DatatypeProperty ;
    rdfs:comment "The total committed or authorized principal amount of the facility in the facility's denomination currency, representing the maximum drawable capacity. | The original face value or notional principal amount of the borrowing at inception."@en ;
    rdfs:domain lpp:CreditFacility,
        lpp:DebtMaturity ;
    rdfs:range xsd:decimal .

lpp:processedBy a owl:ObjectProperty ;
    rdfs:domain lpp:CardTransaction ;
    rdfs:range lpp:Acquirer .

lpp:processorMargin a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:processorMarginAmount a owl:DatatypeProperty ;
    rdfs:comment "The acquirer or payment processor's service margin fee deducted from gross sales, representing the processor's revenue for transaction handling and settlement services. | The fee retained by the payment processor or acquirer for processing and settling the batch, representing the processor's revenue on the transaction volume."@en ;
    rdfs:domain lpp:CardPaymentRollup,
        lpp:CardSettlementBatch .

lpp:processorMarginBps a owl:DatatypeProperty ;
    rdfs:comment "The acquirer's processing fee expressed in basis points, representing the margin charged on each card transaction settled under this contract."@en ;
    rdfs:domain lpp:AcquirerContract .

lpp:processorSettleTimestamp a owl:DatatypeProperty ;
    rdfs:comment "The UTC timestamp at which the payment processor completed its internal settlement calculation and initiated the funds transfer to the company's bank account."@en ;
    rdfs:domain lpp:CardSettlementBatch .

lpp:programType a owl:DatatypeProperty ;
    rdfs:comment "Classifies the card rebate program into a standardized category such as VIRTUAL_CARD, COMMERCIAL_CARD, or PURCHASING_CARD, reflecting the underlying payment instrument and its intended use case in accounts payable or procurement workflows."@en ;
    rdfs:domain lpp:CardRebateProgram .

lpp:projectedBenefitObligation a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:projectedContribution a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

<https://lpp.example/ontology#prov:endedAtTime> a owl:DatatypeProperty ;
    rdfs:comment "The timestamp marking when the SME feedback session concluded, used to calculate session duration and establish the provenance timeline of captured knowledge."@en ;
    rdfs:domain prov:Activity .

<https://lpp.example/ontology#prov:generatedAtTime> a owl:DatatypeProperty ;
    rdfs:comment "The timestamp recording when this tribal knowledge fact was first created or captured in the system, supporting provenance and auditability."@en ;
    rdfs:domain brain:TribalFact .

<https://lpp.example/ontology#prov:startedAtTime> a owl:DatatypeProperty ;
    rdfs:comment "The timestamp marking when the SME feedback session began, establishing the start of the provenance activity record for the knowledge capture event."@en ;
    rdfs:domain prov:Activity .

<https://lpp.example/ontology#prov:wasAssociatedWith> a owl:ObjectProperty ;
    rdfs:comment "References the agent, user, or automated process that initiated or was responsible for the evaluation, providing provenance linkage to the actor who requested the treasury or payments analysis. | A reference to the agent or agents associated with the session, typically identifying the SME participant, interviewer, or responsible business unit who contributed to or conducted the feedback session."@en ;
    rdfs:domain prov:Activity,
        brain:Evaluation ;
    rdfs:range lpp:User .

<https://lpp.example/ontology#prov:wasAttributedTo> a owl:ObjectProperty ;
    rdfs:comment "A reference to the agent, person, team, or system that is credited as the originating source or author of this tribal knowledge fact."@en ;
    rdfs:domain brain:TribalFact ;
    rdfs:range lpp:User .

<https://lpp.example/ontology#prov:wasGeneratedBy> a owl:ObjectProperty ;
    rdfs:comment "A reference to the activity or process — such as an expert review session, an automated anomaly detection run, or a post-mortem analysis — that produced this tribal knowledge fact."@en ;
    rdfs:domain brain:TribalFact ;
    rdfs:range lpp:Session .

lpp:rateBenchmark a owl:DatatypeProperty ;
    rdfs:comment "The floating interest rate reference benchmark used to price the facility (e.g., SOFR for USD, ESTR for EUR, SONIA for GBP), to which the rate spread is added to determine the all-in borrowing cost."@en ;
    rdfs:domain lpp:CreditFacility ;
    rdfs:range xsd:string .

lpp:rateShockBps a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:rateSpread a owl:DatatypeProperty ;
    rdfs:comment "The margin or spread in basis points added to the rate benchmark to calculate the total interest rate payable on drawn amounts under the facility."@en ;
    rdfs:domain lpp:CreditFacility ;
    rdfs:range xsd:decimal .

lpp:rateType a owl:DatatypeProperty ;
    rdfs:comment "Classifies the nature of the exchange rate (e.g., SPOT for immediate settlement rates), distinguishing it from forward, budget, or hedged rates that may also exist in the system."@en ;
    rdfs:domain lpp:FxRate ;
    rdfs:range xsd:string .

lpp:ratedBy a owl:ObjectProperty ;
    rdfs:domain lpp:CreditRating ;
    rdfs:range lpp:CreditRatingAgency .

lpp:ratedEntity a owl:ObjectProperty ;
    rdfs:domain lpp:CreditRating ;
    rdfs:range lpp:Company .

lpp:ratedInstrument a owl:ObjectProperty ;
    rdfs:domain lpp:CreditRating ;
    rdfs:range lpp:FinancialInstrument .

lpp:rating a owl:DatatypeProperty ;
    rdfs:comment "Credit rating assigned to the instrument by a recognized rating agency (e.g., AAA-mf for top-tier money market fund rating), used to enforce investment policy credit quality thresholds."@en ;
    rdfs:domain lpp:InvestmentInstrument ;
    rdfs:range xsd:string .

lpp:ratingDate a owl:DatatypeProperty ;
    rdfs:range xsd:date .

lpp:ratingGrade a owl:DatatypeProperty ;
    rdfs:comment "The specific alphanumeric credit rating grade assigned by the agency, such as Aa3, A+, or BBB+, representing the assessed creditworthiness level of the rated entity."@en ;
    rdfs:domain lpp:CreditRating .

lpp:ratingOutlook a owl:DatatypeProperty ;
    rdfs:range xsd:string .

lpp:ratingValue a owl:DatatypeProperty ;
    rdfs:range xsd:string .

lpp:reasonCategory a owl:DatatypeProperty ;
    rdfs:comment "A high-level grouping of the dispute reason, such as FRAUD, DUPLICATE, NOT_AS_DESCRIBED, or NON_RECEIPT, used for trend analysis and reporting."@en ;
    rdfs:domain lpp:Chargeback .

lpp:reasonCode a owl:DatatypeProperty ;
    rdfs:comment "The card network-specific reason code (e.g., Visa/Mastercard numeric codes) that precisely identifies the regulatory or procedural basis for the dispute."@en ;
    rdfs:domain lpp:Chargeback ;
    rdfs:range xsd:string .

lpp:rebateBpsAtTarget a owl:DatatypeProperty ;
    rdfs:comment "The rebate rate expressed in basis points (hundredths of a percent) that the company earns on eligible card spend when the program's target spend threshold is achieved within the measurement period."@en ;
    rdfs:domain lpp:CardRebateProgram .

lpp:rebateEarned a owl:DatatypeProperty ;
    rdfs:comment "The actual monetary rebate amount earned from the card issuer or program provider based on the eligible spend for the period and applicable rebate rate tiers."@en ;
    rdfs:domain lpp:CardRebateEarning ;
    rdfs:range xsd:decimal .

lpp:rebatePercent a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:recertificationDue a owl:DatatypeProperty ;
    rdfs:range xsd:date .

lpp:reconciliationStatus a owl:DatatypeProperty ;
    rdfs:comment "The outcome of the reconciliation process for the given account and period, indicating whether the ledger balance matches the external source (e.g., MATCHED, UNMATCHED, PENDING)."@en ;
    rdfs:domain lpp:ReconciliationItem ;
    rdfs:range xsd:string .

lpp:recoveryRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:reference a owl:DatatypeProperty ;
    rdfs:comment "A unique internal identifier for the intercompany transaction, formatted as 'IC-' followed by a numeric sequence, used for tracking and reconciliation purposes. | The unique system-generated identifier for the WCF invoice document, used to trace and reconcile individual invoices across treasury and accounts payable systems. | The unique internal accounts payable invoice identifier (e.g., AP-00122716) used to reference and reconcile the payable across treasury and ERP systems. | A unique business reference string identifying the payment instruction, typically encoding the payment type, legal entity, country, and period (e.g., rent payments formatted as RENT-{entity}-{YYYYMM}) or an accounts payable invoice number (e.g., AP-XXXXXXXX). | A unique business reference identifier for the invoice, typically encoding channel, entity, and date information, used for reconciliation and audit tracing. | A structured business reference identifier for the transaction, typically encoding the payment type, entity, country, purpose, and period (e.g., PAY-GR_AU_PAYROLL_1-20230531), used to trace transactions back to their originating payment instructions or schedules."@en ;
    rdfs:domain lpp:IntercompanyTransfer,
        lpp:Invoice,
        lpp:Payable,
        lpp:PaymentTransaction,
        lpp:Receivable,
        lpp:Transaction ;
    rdfs:range xsd:string .

lpp:region a owl:DatatypeProperty ;
    rdfs:comment "The geographic operating region in which this acquirer processes transactions for the company, aligned to standard treasury region codes such as AMER or EMEA. | The geographic region or country to which the macroeconomic indicator applies, allowing multi-region comparisons and regional treasury decisions."@en ;
    rdfs:domain lpp:Acquirer,
        lpp:MacroIndicator .

lpp:rejectionRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:rejectionReason a owl:DatatypeProperty ;
    rdfs:comment "A descriptive code or message explaining why a payment instruction was rejected or failed processing; populated only when the payment has not been successfully acknowledged or executed."@en ;
    rdfs:domain lpp:PaymentTransaction ;
    rdfs:range xsd:string .

lpp:relatedToTransaction a owl:ObjectProperty ;
    rdfs:comment "A reference linking this fraud detection event to the associated payment transaction record, enabling join traversal between fraud outcomes and the underlying transaction details such as amount, merchant, and account."@en ;
    rdfs:domain lpp:FraudLossEvent ;
    rdfs:range lpp:Transaction .

lpp:remainingAuth a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:remediationStatus a owl:DatatypeProperty ;
    rdfs:range xsd:string .

lpp:repairCost a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:repairRate a owl:DatatypeProperty ;
    rdfs:comment "The proportion of transactions that required manual or automated repair intervention to complete successfully, expressed as a decimal ratio; a non-zero value indicates processing exceptions requiring remediation."@en ;
    rdfs:domain lpp:PaymentMethodRollup ;
    rdfs:range xsd:decimal .

lpp:resolutionStatus a owl:DatatypeProperty ;
    rdfs:range xsd:string .

lpp:resolutionTimeMin a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:resolutionTimeMinutes a owl:DatatypeProperty ;
    rdfs:comment "The total elapsed time in minutes between exception detection and resolution, used to measure remediation speed and assess compliance with internal SLAs."@en ;
    rdfs:domain lpp:PaymentException .

lpp:resolvedAt a owl:DatatypeProperty ;
    rdfs:comment "The UTC timestamp when the payment exception was fully resolved and closed, marking the end of the exception lifecycle and enabling SLA adherence calculations."@en ;
    rdfs:domain lpp:PaymentException .

lpp:resolvedDate a owl:DatatypeProperty ;
    rdfs:comment "The calendar date on which the chargeback case was closed, either through a final ruling, representment acceptance, or withdrawal."@en ;
    rdfs:domain lpp:Chargeback .

lpp:responseTimeMs a owl:DatatypeProperty ;
    rdfs:comment "The elapsed time in milliseconds between the authorization request and response, used to assess authorization network and acquirer performance."@en ;
    rdfs:domain lpp:CardAuthorization .

lpp:returnCategory a owl:DatatypeProperty ;
    rdfs:comment "A high-level business classification of the return reason, such as UNAUTHORIZED, INVALID_ACCT, INSUFFICIENT_FUNDS, or OTHER, used for operational reporting and trend analysis."@en ;
    rdfs:domain lpp:AchReturn .

lpp:returnDate a owl:DatatypeProperty ;
    rdfs:comment "The date on which the ACH return was received and recorded, used for aging analysis and compliance tracking against NACHA return windows."@en ;
    rdfs:domain lpp:AchReturn .

lpp:returnReasonCode a owl:DatatypeProperty ;
    rdfs:comment "The standardized NACHA return reason code (e.g., R01 for insufficient funds, R03 for no account, R10 for customer advises unauthorized) assigned by the receiving or returning bank."@en ;
    rdfs:domain lpp:AchReturn ;
    rdfs:range xsd:string .

lpp:revenue a owl:DatatypeProperty ;
    rdfs:comment "Total net revenue recognized by the company in the reporting period, expressed in the company's reporting currency, used as a scale metric in peer benchmarking and ratio calculations. | The peer company's total reported revenue in absolute currency terms for the reporting period, serving as the scale denominator for ratio-based benchmarking metrics."@en ;
    rdfs:domain lpp:CompanyFinancialMetric,
        lpp:PeerCompanyMetric .

lpp:role a owl:DatatypeProperty ;
    rdfs:comment "The functional role assigned to this signatory on the bank account, such as SIGNER_A or SIGNER_B for dual-control signing tiers, or RELEASER for payment release authority."@en ;
    rdfs:domain lpp:BankAccountSignatory .

lpp:rootCause a owl:DatatypeProperty ;
    rdfs:range xsd:string .

lpp:scenarioType a owl:DatatypeProperty ;
    rdfs:comment "A categorical classification of the stress scenario that groups shocks by their primary risk driver, such as RECEIPTS_DROP, FX_SHOCK, RATE_SHOCK, CUSTOMER_DEFAULT, or BANK_DOWNGRADE, enabling aggregation and filtering by risk category in SPARQL queries."@en ;
    rdfs:domain lpp:StressTest ;
    rdfs:range xsd:string .

lpp:scheduledOn a owl:ObjectProperty ;
    rdfs:comment "The date on which a scheduled repayment or drawdown event is expected to occur, used for forward-looking debt service planning."@en ;
    rdfs:domain lpp:DebtMaturity ;
    rdfs:range lpp:DebtInstrument .

lpp:sector a owl:DatatypeProperty ;
    rdfs:comment "The standard equity market sector classification of the peer company, reflecting its primary industry exposure as used in financial analysis and index categorization."@en ;
    rdfs:domain lpp:PeerCompany .

lpp:settledAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

lpp:settledTo a owl:ObjectProperty ;
    rdfs:comment "A reference to the bank account or financial institution destination to which the net settlement amount for this batch was deposited."@en ;
    rdfs:domain lpp:CardSettlementBatch ;
    rdfs:range lpp:BankAccount .

lpp:settlementAccount a owl:ObjectProperty ;
    rdfs:comment "Reference to the specific bank or treasury account into which this acquirer remits settled card proceeds, used to reconcile daily settlement flows and cash positioning."@en ;
    rdfs:domain lpp:Acquirer ;
    rdfs:range lpp:BankAccount .

lpp:settlementLagDays a owl:DatatypeProperty ;
    rdfs:comment "The number of business days between the transaction authorization date and the date funds are settled into the retailer's bank account by the acquirer."@en ;
    rdfs:domain lpp:AcquirerContract .

lpp:settlementOnTimePct a owl:DatatypeProperty ;
    rdfs:comment "The percentage of transactions settled by the acquirer within the contractually agreed settlement window on the measurement date, indicating timeliness of fund transfer to the merchant."@en ;
    rdfs:domain lpp:AcquirerSlaMetric .

lpp:settles a owl:ObjectProperty ;
    rdfs:domain lpp:PaymentTransaction ;
    rdfs:range lpp:Invoice .

lpp:settlesAuth a owl:ObjectProperty ;
    rdfs:comment "A reference to the original card authorization record that this settlement line is settling, enabling matching of settled transactions back to their corresponding authorization events."@en ;
    rdfs:domain lpp:CardSettlementLine ;
    rdfs:range lpp:CardAuth .

lpp:settles_card a owl:ObjectProperty ;
    rdfs:domain lpp:Settlement ;
    rdfs:range lpp:CardTransaction .

lpp:shares a owl:DatatypeProperty ;
    rdfs:comment "The number of shares involved in the equity action, representing shares repurchased in a buyback or shares eligible for dividend payment."@en ;
    rdfs:domain lpp:EquityAction .

lpp:sharesPurchased a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:signatoryPerson a owl:ObjectProperty ;
    rdfs:domain lpp:Signatory ;
    rdfs:range lpp:Person .

lpp:signatoryRole a owl:DatatypeProperty ;
    rdfs:range xsd:string .

lpp:signatoryUser a owl:ObjectProperty ;
    rdfs:comment "A reference to the user or person entity who holds this signatory authorization, identifying the individual granted the specified role and authority limit on the bank account."@en ;
    rdfs:domain lpp:BankAccountSignatory ;
    rdfs:range lpp:User .

lpp:signsOn a owl:ObjectProperty ;
    rdfs:domain lpp:Signatory ;
    rdfs:range lpp:BankAccount .

lpp:slaBreached a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

lpp:slaMet a owl:DatatypeProperty ;
    rdfs:comment "A boolean flag indicating whether the processor delivered settlement within the contractually agreed service level agreement timeframe for this batch."@en ;
    rdfs:domain lpp:CardSettlementBatch .

lpp:soldBy a owl:ObjectProperty ;
    rdfs:comment "The identifier of the employee, terminal, or system that processed the transaction, used for operational reconciliation and fraud investigation workflows."@en ;
    rdfs:domain lpp:PosTransaction ;
    rdfs:range lpp:Company .

lpp:sourceAccount a owl:ObjectProperty ;
    rdfs:comment "A reference to the bank account from which funds were swept, typically a subsidiary or feeder account subject to the applied sweep rule. | The identifier of the originating bank account from which funds are swept when the rule conditions are met, typically a local operating or subsidiary account."@en ;
    rdfs:domain lpp:SweepEvent,
        lpp:SweepRule ;
    rdfs:range lpp:BankAccount .

lpp:spendCategory a owl:DatatypeProperty ;
    rdfs:comment "The business classification of the card expenditure used to segment rebate earnings, such as LOGISTICS, INVENTORY, UTILITIES, TRAVEL, or OTHER."@en ;
    rdfs:domain lpp:CardRebateEarning .

lpp:sponsoredBy a owl:ObjectProperty ;
    rdfs:comment "Identifies the legal entity or organizational unit within the company that acts as the plan sponsor and bears the associated funding and fiduciary responsibilities."@en ;
    rdfs:domain lpp:PensionPlan ;
    rdfs:range lpp:Company .

lpp:status a owl:DatatypeProperty ;
    rdfs:comment "The current lifecycle status of the contract, indicating whether the agreement is active, expired, or otherwise inactive. | The processing or confirmation status of the balance snapshot, indicating whether the balance record has been confirmed, is pending reconciliation, or carries another workflow state. | The current authorization status of the signatory record, indicating whether the signatory is actively permitted to act on the account (e.g., ACTIVE) or has been suspended or revoked. | The current processing state of the chargeback, indicating whether it is INITIATED, REPRESENTED (contested by the merchant), WON (resolved in the merchant's favor), or LOST (resolved in the cardholder's favor). | The current operational status of the facility, indicating whether it is active, expired, cancelled, or in another lifecycle state. | The current lifecycle status of the borrowing, indicating whether it is active, outstanding, or has been fully repaid (e.g., REPAID). | The current processing status of the fraud detection event, reflecting the actionable disposition of the transaction as ALLOW (permitted to proceed), REVIEW (held for further investigation), or BLOCK (declined due to fraud risk). | Current lifecycle status of the forward contract, indicating whether it is active, pending settlement, settled, or cancelled (e.g., SETTLED). | The current lifecycle state of the hedge relationship, indicating whether it is ACTIVE and in effect or DEDESIGNATED and no longer qualifying for hedge accounting treatment. | The current settlement state of the intercompany transfer, indicating whether the transaction has been completed (e.g., SETTLED) or is pending. | The current lifecycle state of the invoice (e.g., SUBMITTED, APPROVED, PAID), indicating where the document stands in the working capital finance approval and settlement workflow. | The current lifecycle status of the letter of credit, indicating whether it is OPEN (active and available), DRAWN (partially or fully utilized), or EXPIRED (past its expiration date). | The current collection status of the membership fee, indicating whether the payment was successfully collected (COLLECTED) or the transaction failed (FAILED). | The current lifecycle status of the invoice (e.g., PAID), indicating whether the payable obligation has been fulfilled. | The current processing status of the payment file indicating its transmission state, where SENT confirms the file has been successfully dispatched to the receiving banking or payment network. | The current processing status of the payment instruction within the payment lifecycle (e.g., ACK indicating the payment has been acknowledged by the bank or payment processor). | The current lifecycle status of the invoice indicating whether it is outstanding, partially paid, or fully settled, used to filter open versus closed receivables. | The processing or approval status of the stress run result, indicating the current state of the scenario result record within the treasury workflow (e.g., NONE indicating a default or unreviewed state). | The current processing status of the sweep event, such as pending, completed, failed, or reversed, indicating whether the transfer was successfully executed. | The processing or confirmation status of the cash flow transaction, indicating whether the transaction has been confirmed, is pending, or has been cancelled; a value of CONFIRMED indicates the transaction is settled or authorised."@en ;
    rdfs:domain lpp:AcquirerContract,
        lpp:BalanceSnapshot,
        lpp:BankAccountSignatory,
        lpp:Chargeback,
        lpp:CreditFacility,
        lpp:DebtMaturity,
        lpp:FraudLossEvent,
        lpp:FxForward,
        lpp:HedgePosition,
        lpp:IntercompanyTransfer,
        lpp:Invoice,
        lpp:LetterOfCredit,
        lpp:MembershipFee,
        lpp:Payable,
        lpp:PaymentFile,
        lpp:PaymentTransaction,
        lpp:Receivable,
        lpp:ScenarioAssumption,
        lpp:SweepEvent,
        lpp:Transaction ;
    rdfs:range xsd:string .

lpp:stpRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:stpRatePct a owl:DatatypeProperty ;
    rdfs:comment "The straight-through processing rate as a percentage, indicating the proportion of transactions on that rail and date that were processed without manual intervention, where 100.000 represents fully automated processing."@en ;
    rdfs:domain lpp:PaymentHubThroughput .

lpp:successRate a owl:DatatypeProperty ;
    rdfs:comment "The proportion of attempted transactions that completed successfully without failure or reversal, expressed as a decimal ratio between 0 and 1, where 1.0 represents 100% success."@en ;
    rdfs:domain lpp:PaymentMethodRollup ;
    rdfs:range xsd:decimal .

lpp:tenor a owl:DatatypeProperty ;
    rdfs:comment "The forward time bucket in which the exposure is expected to materialize, such as 0-1 month, 1-3 months, or 3-6 months. | The time period or maturity term to which the rate applies, such as overnight (ON), one month (1M), or three months (3M), distinguishing short-term funding cost horizons."@en ;
    rdfs:domain lpp:FxExposure,
        lpp:InterestRateBenchmark ;
    rdfs:range xsd:string .

lpp:testsCovenant a owl:ObjectProperty ;
    rdfs:domain lpp:CovenantTest ;
    rdfs:range lpp:Covenant .

lpp:throughputCount a owl:DatatypeProperty ;
    rdfs:comment "The total number of individual payment transactions bundled within the payment file, used to measure batch processing volume and reconcile transaction counts against expected totals."@en ;
    rdfs:domain lpp:PaymentFile ;
    rdfs:range xsd:integer .

lpp:throughputValue a owl:DatatypeProperty ;
    rdfs:comment "The aggregate monetary value of all transactions contained within the payment file expressed in the file's designated currency, used for cash position forecasting, settlement reconciliation, and daily liquidity monitoring."@en ;
    rdfs:domain lpp:PaymentFile ;
    rdfs:range xsd:decimal .

lpp:ticker a owl:DatatypeProperty ;
    rdfs:comment "The official stock exchange ticker symbol of the peer company, used to link to external market data sources, pricing feeds, and capital markets benchmarks."@en ;
    rdfs:domain lpp:PeerCompany .

lpp:ticketSize a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:tier a owl:DatatypeProperty ;
    rdfs:comment "The membership tier level associated with the fee, such as EXECUTIVE, GOLD, or BUSINESS, which determines the fee amount and associated member benefits."@en ;
    rdfs:domain lpp:MembershipFee .

lpp:toAccount a owl:ObjectProperty ;
    rdfs:comment "The internal bank account identifier to which funds are credited as the destination of the intercompany transfer."@en ;
    rdfs:domain lpp:IntercompanyTransfer,
        lpp:Transaction ;
    rdfs:range lpp:BankAccount .

lpp:totalAmount a owl:DatatypeProperty ;
    rdfs:comment "The total cash outlay in base currency for the equity action, representing aggregate buyback spend or total dividend distribution amount."@en ;
    rdfs:domain lpp:EquityAction .

lpp:totalBilled a owl:DatatypeProperty ;
    rdfs:comment "The total gross amount invoiced by the vendor during the period month, expressed in the ledger currency, representing the sum of all invoice face values before any deductions."@en ;
    rdfs:domain lpp:VendorPaymentRollup ;
    rdfs:range xsd:decimal .

lpp:totalCash a owl:DatatypeProperty ;
    rdfs:comment "The sum of closing cash balances across all included bank accounts for the specified entity, currency, and date, expressed as a decimal numeric value in the stated currency."@en ;
    rdfs:domain lpp:CashRollup ;
    rdfs:range xsd:decimal .

lpp:totalPaid a owl:DatatypeProperty ;
    rdfs:comment "The total amount actually disbursed to the vendor during the period month, expressed in the ledger currency; differences from totalBilled may indicate partial payments, disputes, or outstanding balances."@en ;
    rdfs:domain lpp:VendorPaymentRollup ;
    rdfs:range xsd:decimal .

lpp:tradeDate a owl:DatatypeProperty ;
    rdfs:comment "The date on which the credit facility agreement was executed or signed between the company and the lender(s). | The date on which the borrowing was executed or the loan agreement was entered into. | The date on which the FX forward contract was executed and agreed upon between the company and the counterparty. | The date on which the hedging instrument was executed or the hedge relationship was formally established. | The date on which the intercompany transfer was initiated or agreed upon between the sending and receiving entities. | The date on which the payment instruction was created or submitted for processing, representing the initiation date of the transaction in the treasury system. | The date on which the transaction was initiated or booked in the system, representing the business date the payment instruction was created or agreed upon."@en ;
    rdfs:domain lpp:CreditFacility,
        lpp:DebtMaturity,
        lpp:FxForward,
        lpp:HedgePosition,
        lpp:IntercompanyTransfer,
        lpp:PaymentTransaction,
        lpp:Transaction ;
    rdfs:range xsd:date .

lpp:tradedBy a owl:ObjectProperty ;
    rdfs:comment "A relationship identifying the internal treasury desk, trader, or responsible party who negotiated or manages the credit facility on behalf of the company. | The identifier of the treasury dealer, trader, or counterparty relationship manager responsible for executing or managing the borrowing. | The trader, desk, or business unit responsible for managing or executing hedges against this specific FX exposure. | The treasury dealer or trader within the organization who executed and is responsible for this forward contract. | The identifier of the treasury dealer or trader responsible for executing and managing this hedge relationship. | The treasury user, desk, or entity that submitted or processed the invoice within the working capital finance platform, used for audit and accountability tracking. | The internal trader, buyer, or business unit responsible for the purchase transaction that generated this payable, used for cost center attribution and spend analysis. | The internal legal entity or business unit that originated and owns the receivable, used for entity-level P&L attribution and intercompany reconciliation."@en ;
    rdfs:domain lpp:CreditFacility,
        lpp:DebtMaturity,
        lpp:FxExposure,
        lpp:FxForward,
        lpp:HedgePosition,
        lpp:Invoice,
        lpp:Payable,
        lpp:Receivable ;
    rdfs:range lpp:Company .

lpp:transactionSizeBand a owl:DatatypeProperty ;
    rdfs:comment "A categorical band grouping the transaction amount into defined ranges such as LT_25, 25_100, 100_500, or 500_5000, used for segmentation and reporting of authorization activity by value tier."@en ;
    rdfs:domain lpp:CardAuthorization .

lpp:transactionTimestamp a owl:DatatypeProperty ;
    rdfs:comment "The full UTC timestamp with microsecond precision at which the transaction was processed, used for intraday cash position updates, settlement timing analysis, and audit trails."@en ;
    rdfs:domain lpp:PosTransaction .

lpp:trappedCashAmount a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:txnCount a owl:DatatypeProperty ;
    rdfs:comment "The total number of individual payment transactions processed via this payment method on the given date, used to assess volume and statistical significance of the success metrics."@en ;
    rdfs:domain lpp:PaymentMethodRollup ;
    rdfs:range xsd:integer .

lpp:txnValue a owl:DatatypeProperty ;
    rdfs:comment "The total monetary value in the reporting currency of all transactions processed via this payment method on the given date, used to assess financial exposure and throughput."@en ;
    rdfs:domain lpp:PaymentMethodRollup ;
    rdfs:range xsd:decimal .

lpp:unappliedAmount a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:underProgram a owl:ObjectProperty ;
    rdfs:comment "The identifier or name of the corporate card rebate program under which the eligible spend and rebate earning are being tracked, linking the record to a specific card issuer agreement or program tier."@en ;
    rdfs:domain lpp:CardRebateEarning ;
    rdfs:range lpp:CardRebateProgram .

lpp:underScenario a owl:ObjectProperty ;
    rdfs:comment "A reference to the specific stress scenario definition applied in this run, linking the result to the underlying assumptions, shock parameters, and scenario type used to generate the cash flow impact."@en ;
    rdfs:domain lpp:ScenarioAssumption ;
    rdfs:range lpp:Scenario .

lpp:undrawnCommitment a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:uptimePct a owl:DatatypeProperty ;
    rdfs:comment "The percentage of time the acquirer's payment processing infrastructure was available and operational during the measurement date, reflecting system reliability against uptime SLA commitments."@en ;
    rdfs:domain lpp:AcquirerSlaMetric .

lpp:uptimeSlaPct a owl:DatatypeProperty ;
    rdfs:comment "The minimum system availability percentage guaranteed by the acquirer in the service-level agreement, representing the contractual uptime commitment for payment processing infrastructure."@en ;
    rdfs:domain lpp:AcquirerContract .

lpp:value a owl:DatatypeProperty ;
    rdfs:comment "The numeric value of the macroeconomic indicator on the given date, expressed as a decimal rate or index level, used in interest rate sensitivity and hedging analyses."@en ;
    rdfs:domain lpp:MacroIndicator .

lpp:valueAmount a owl:DatatypeProperty ;
    rdfs:comment "The total monetary value of all transactions processed over the specified payment rail on the given date, expressed in the rail's base currency units (typically thousands)."@en ;
    rdfs:domain lpp:PaymentHubThroughput .

lpp:valueDate a owl:DatatypeProperty ;
    rdfs:comment "The future date on which the currency exchange will physically settle and funds will be delivered, typically days to months after the trade date. | The date on which the funds are expected to be or were actually credited to the beneficiary account, typically one or two business days after the trade date. | The contractual settlement date on which funds are expected to be debited from the company's account and credited to the beneficiary, used for cash flow forecasting and liquidity planning. | The date on which the funds are expected to be or were actually settled and reflected in the account balance, which may coincide with or differ from the tradeDate depending on settlement conventions."@en ;
    rdfs:domain lpp:FxForward,
        lpp:IntercompanyTransfer,
        lpp:PaymentTransaction,
        lpp:Transaction ;
    rdfs:range xsd:date .

lpp:valuesInstrument a owl:ObjectProperty ;
    rdfs:comment "The identifier or description of the specific derivative instrument being valued, such as an FX forward, swap, or option contract, linking the MTM record to the underlying hedging instrument."@en ;
    rdfs:domain lpp:DerivativeMtm ;
    rdfs:range lpp:FinancialInstrument .

lpp:varAmount a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:varianceAmount a owl:DatatypeProperty ;
    rdfs:comment "The absolute difference between actual and forecasted outflow amounts, where a positive value indicates actual exceeded forecast and a negative value indicates actual was below forecast."@en ;
    rdfs:domain lpp:ForecastActual ;
    rdfs:range xsd:decimal .

lpp:variancePct a owl:DatatypeProperty ;
    rdfs:comment "The percentage difference between actual and forecasted outflow, expressing forecast error as a rounded percentage of the forecasted amount."@en ;
    rdfs:domain lpp:ForecastActual ;
    rdfs:range xsd:decimal .

lpp:vendor a owl:ObjectProperty ;
    rdfs:comment "A reference to the vendor entity associated with the payment rollup, linking to the supplier master record that identifies the payee organization."@en ;
    rdfs:domain lpp:VendorPaymentRollup ;
    rdfs:range lpp:Counterparty .

lpp:viaAcquirer a owl:ObjectProperty ;
    rdfs:comment "Identifies the acquiring institution or processor through which the authorization request was submitted; no samples available in current dataset. | Identifies the acquiring bank or payment processor that handled the settlement batch, used to attribute fees and net settlement amounts to specific acquirer relationships. | A reference to the acquiring bank or payment processor that processed and settled this card settlement batch on behalf of the company. | A reference to the acquiring bank or payment processor through which the chargeback was routed and managed on behalf of the merchant."@en ;
    rdfs:domain lpp:CardAuthorization,
        lpp:CardPaymentRollup,
        lpp:CardSettlementBatch,
        lpp:Chargeback ;
    rdfs:range lpp:Acquirer .

lpp:viaChannel a owl:ObjectProperty ;
    rdfs:range lpp:Channel .

lpp:volumeCount a owl:DatatypeProperty ;
    rdfs:comment "The total number of individual payment transactions processed over the specified payment rail on the given date."@en ;
    rdfs:domain lpp:PaymentHubThroughput .

lpp:waccPct a owl:DatatypeProperty ;
    rdfs:comment "The weighted average cost of capital expressed as a decimal percentage for the reporting period, reflecting the blended required return on equity and debt, used to benchmark discount rates and assess capital efficiency across peers."@en ;
    rdfs:domain lpp:CompanyFinancialMetric .

lpp:weightedAvgRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

lpp:withAcquirer a owl:ObjectProperty ;
    rdfs:comment "A reference to the acquirer entity (financial institution or payment processor) that is the counterparty to this contract."@en ;
    rdfs:domain lpp:AcquirerContract ;
    rdfs:range lpp:Acquirer .

lpp:yieldToMaturity a owl:DatatypeProperty ;
    rdfs:comment "The annualized yield to maturity of the investment instrument, representing the total expected return if held until maturity."@en ;
    rdfs:domain lpp:InvestmentPosition ;
    rdfs:range xsd:decimal .

brain:BehavioralPattern a owl:Class ;
    rdfs:comment "This table captures institutional tribal knowledge and behavioral patterns observed across treasury and payments operations, encoding expert heuristics, anomaly signatures, and operational rules that are not formally documented elsewhere. It serves as a repository of learned patterns from experienced practitioners covering areas such as cash flow seasonality, fraud behavioral signatures, FX risk indicators, and reconciliation anomalies. Business questions it answers include: what informal rules govern cash positioning decisions, what behavioral signatures indicate emerging fraud patterns, and what experiential benchmarks guide capital allocation judgments."@en .

brain:RMSignal a owl:Class ;
    rdfs:comment "The lpp.tribal_knowledge_fact table stores unstructured or semi-structured institutional knowledge signals used by the Risk Management (RMSignal) framework to capture heuristic, experiential, or qualitative insights that are difficult to encode in standard transactional data. It serves as a repository for expert-driven risk indicators and contextual intelligence accumulated over time by treasury and payments practitioners. This table supports AI-assisted query generation and decision augmentation by providing background context that bridges formal data models with real-world treasury operational wisdom."@en .

brain:SideAgreement a owl:Class ;
    rdfs:comment "This table captures undocumented institutional knowledge, informal agreements, and tacit understandings between the treasury department and its banking counterparties, internal business units, or payment partners that govern how transactions, limits, or terms are applied in practice beyond formal contractual documentation. It serves as a repository for side agreements, verbal commitments, gentlemen's agreements, and operational conventions that influence cash management, credit facilities, FX dealing, or card acquiring relationships. Business users query this table to surface hidden constraints, preferential treatments, or informal obligations that may affect liquidity decisions, audit findings, or counterparty risk assessments."@en .

brain:StrategicPreference a owl:Class ;
    rdfs:comment "This table captures qualitative strategic preferences, institutional knowledge, and heuristic rules that guide treasury decision-making and cannot be easily expressed in structured transactional data. It serves as a repository for tribal knowledge accumulated by treasury professionals regarding policies, behavioral preferences, and contextual reasoning around cash management, FX hedging, capital allocation, and payment strategies. It enables AI-assisted query generation to incorporate business context and expert judgment alongside quantitative warehouse data."@en .

brain:UndocumentedConstraint a owl:Class ;
    rdfs:comment "This table represents undocumented institutional knowledge and informal business rules ('tribal knowledge') that govern treasury and payments operations but have never been formally captured in system documentation. It serves as a placeholder or stub for constraints, thresholds, and decision logic that exist only in the minds of experienced staff or in undocumented legacy processes. Business questions it addresses include identifying gaps in formal policy documentation and surfacing hidden operational rules that may affect cash positioning, FX hedging decisions, or fraud threshold configurations."@en .

brain:VerbalCommitment a owl:Class ;
    rdfs:comment "This table captures informal, undocumented treasury and payments knowledge — often referred to as 'tribal knowledge' — that exists within the organization but has not been formally codified in structured data sources. It serves as a repository for institutional expertise, tacit rules, and experiential insights related to bank relationships, cash management practices, FX conventions, and payment workflows that influence decision-making but are not reflected in transactional systems. Business questions it answers include: What unwritten rules govern our banking relationships? What historical context explains current treasury policies or counterparty arrangements?"@en .

brain:answerSummary a owl:DatatypeProperty ;
    rdfs:comment "Stores the synthesized textual answer or summary returned by the AI system in response to the evaluated query, representing the final human-readable output for the treasury or payments business question."@en ;
    rdfs:domain brain:Evaluation .

brain:appliesTo a owl:ObjectProperty ;
    rdfs:comment "Column brain:appliesTo in (sql) lpp.tribal_knowledge_entity_link."@en ;
    rdfs:domain lpp:Fact ;
    rdfs:range lpp:Bank,
        lpp:BankAccount,
        lpp:Company,
        lpp:CreditFacility,
        lpp:FxForward,
        lpp:Hedge,
        lpp:ThirdParty,
        lpp:User .

brain:appliesTo_1 a owl:DatatypeProperty ;
    rdfs:comment "References the first target entity or data object to which a piece of tribal knowledge applies, such as a specific bank account, transaction, or FX hedge record."@en .

brain:appliesTo_2 a owl:DatatypeProperty ;
    rdfs:comment "References the second target entity or data object to which a piece of tribal knowledge applies, supporting many-to-one knowledge linkage across treasury domains."@en .

brain:appliesTo_3 a owl:DatatypeProperty ;
    rdfs:comment "References the third target entity or data object to which a piece of tribal knowledge applies, enabling broad annotation of related instruments or positions."@en .

brain:appliesTo_4 a owl:DatatypeProperty ;
    rdfs:comment "References the fourth target entity or data object to which a piece of tribal knowledge applies, extending linkage to card acquiring or fraud-related entities."@en .

brain:appliesTo_5 a owl:DatatypeProperty ;
    rdfs:comment "References the fifth target entity or data object to which a piece of tribal knowledge applies, covering capital allocation or cash position records."@en .

brain:appliesTo_6 a owl:DatatypeProperty ;
    rdfs:comment "References the sixth target entity or data object to which a piece of tribal knowledge applies, supporting peer benchmark or counterparty entity annotations."@en .

brain:appliesTo_7 a owl:DatatypeProperty ;
    rdfs:comment "References the seventh target entity or data object to which a piece of tribal knowledge applies, allowing flexible multi-entity knowledge association."@en .

brain:appliesTo_8 a owl:DatatypeProperty ;
    rdfs:comment "References the eighth target entity or data object to which a piece of tribal knowledge applies, completing the set of linkable treasury and payments entities for a given knowledge record."@en .

brain:boardMemberOverlap a owl:ObjectProperty ;
    rdfs:comment "Indicates whether this bank shares one or more board members with the company or other related entities, used for conflict-of-interest and governance risk assessments."@en ;
    rdfs:domain lpp:Bank ;
    rdfs:range lpp:Bank .

brain:confidence a owl:DatatypeProperty ;
    rdfs:comment "A numeric or categorical score (e.g., 0.0–1.0 or Low/Medium/High) indicating how reliable or validated this piece of tribal knowledge is, based on evidence, expert consensus, or historical accuracy."@en ;
    rdfs:domain brain:TribalFact .

brain:effectiveFrom a owl:DatatypeProperty ;
    rdfs:comment "The date from which this tribal knowledge fact is considered valid and applicable to treasury or payments operations."@en ;
    rdfs:domain brain:TribalFact .

brain:effectiveTo a owl:DatatypeProperty ;
    rdfs:comment "The date after which this tribal knowledge fact is no longer considered valid or applicable, supporting time-bounded knowledge management."@en ;
    rdfs:domain brain:TribalFact .

brain:evaluatedAt a owl:DatatypeProperty ;
    rdfs:comment "Records the timestamp at which the evaluation was executed, enabling audit trails and temporal analysis of when specific treasury or payments queries were processed."@en ;
    rdfs:domain brain:Evaluation .

brain:expansionHops a owl:DatatypeProperty ;
    rdfs:comment "Captures the number of graph traversal hops performed during query expansion, indicating how many related ontology nodes were explored to enrich the answer beyond the directly queried entities."@en ;
    rdfs:domain brain:Evaluation .

brain:factType a owl:DatatypeProperty ;
    rdfs:comment "A classification label identifying the category of tribal knowledge, such as 'BusinessRule', 'ObservedPattern', 'Heuristic', 'RegulatoryGuidance', or 'OperationalNorm'."@en ;
    rdfs:domain brain:TribalFact .

brain:informalDependency a owl:ObjectProperty ;
    rdfs:comment "Stores the target entity or relationship identifier representing an informal, non-contractual dependency between two entities, such as a shared service provider, common liquidity source, or operational reliance that has not been formally documented in agreements."@en ;
    rdfs:domain lpp:Entity ;
    rdfs:range lpp:Entity .

brain:knowledgeOwnerOf a owl:ObjectProperty ;
    rdfs:comment "Identifies the entity, domain, or knowledge asset for which the user holds primary ownership responsibility within the treasury and payments knowledge graph."@en ;
    rdfs:domain lpp:User ;
    rdfs:range lpp:CreditFacility,
        lpp:Hedge .

brain:narrative a owl:DatatypeProperty ;
    rdfs:comment "A free-text, human-readable explanation of the tribal knowledge fact, providing the full contextual description, rationale, or observed behavior being captured."@en ;
    rdfs:domain brain:TribalFact .

brain:negotiatingHistory a owl:ObjectProperty ;
    rdfs:comment "AI-enriched attribute capturing the historical context and outcomes of commercial negotiations with this company, used to inform procurement strategy and counterparty relationship management."@en ;
    rdfs:domain lpp:Company ;
    rdfs:range lpp:Bank .

brain:queryText a owl:DatatypeProperty ;
    rdfs:comment "Contains the original query text submitted by the user or system, which may be a natural language question or structured query related to treasury topics such as cash positions, FX hedging, or card acquiring."@en ;
    rdfs:domain brain:Evaluation .

brain:rmRelationship a owl:ObjectProperty ;
    rdfs:comment "Captures the relationship manager association between the user and a counterparty, bank, or financial entity, indicating which personnel manages the relationship for treasury or payments purposes."@en ;
    rdfs:domain lpp:User ;
    rdfs:range lpp:Bank .

brain:sharedParentInstitution a owl:ObjectProperty ;
    rdfs:comment "Identifies whether this bank shares a common parent institution with another bank in the system, supporting counterparty concentration risk analysis and group-level exposure aggregation."@en ;
    rdfs:domain lpp:Bank ;
    rdfs:range lpp:Bank,
        lpp:ThirdParty .

brain:status a owl:DatatypeProperty ;
    rdfs:comment "The current lifecycle status of this knowledge fact, such as 'Active', 'Deprecated', 'UnderReview', or 'Superseded', used to control which facts are surfaced in queries."@en ;
    rdfs:domain brain:TribalFact .

brain:strategicVendorTier a owl:ObjectProperty ;
    rdfs:comment "AI-enriched classification indicating the strategic importance tier of this company as a vendor or counterparty, used to prioritize treasury resources, credit exposure limits, and relationship investment."@en ;
    rdfs:domain lpp:Company ;
    rdfs:range lpp:ThirdParty .

brain:supersededBy a owl:ObjectProperty ;
    rdfs:comment "A reference to a newer or more authoritative TribalFact instance that replaces this record, enabling version chaining and knowledge evolution tracking."@en ;
    rdfs:domain brain:TribalFact ;
    rdfs:range lpp:Fact .

brain:supplierSubstitutionRisk a owl:ObjectProperty ;
    rdfs:comment "Indicates the assessed difficulty or risk level associated with replacing a given supplier should they become unavailable, used to prioritize contingency planning and working capital reserves for critical supply relationships."@en ;
    rdfs:domain lpp:ThirdParty ;
    rdfs:range lpp:ThirdParty .

brain:title a owl:DatatypeProperty ;
    rdfs:comment "A concise, descriptive label or headline summarizing the tribal knowledge fact for display and discovery purposes."@en ;
    rdfs:domain brain:TribalFact .

brain:topic a owl:DatatypeProperty ;
    rdfs:comment "The subject or domain area discussed during the feedback session, such as liquidity management, FX exposure, card acquiring reconciliation, or fraud threshold calibration."@en ;
    rdfs:domain prov:Activity .

brain:transcriptUri a owl:ObjectProperty ;
    rdfs:comment "A URI pointing to the stored transcript or recording of the feedback session, enabling retrieval of the full dialogue for audit, compliance, or ontology refinement purposes."@en ;
    rdfs:domain prov:Activity .

brain:triggerCondition a owl:DatatypeProperty ;
    rdfs:comment "A structured or natural-language expression defining the conditions or context under which this knowledge fact is relevant or should be applied, such as a threshold, event type, or market condition."@en ;
    rdfs:domain brain:TribalFact .

lpp:Authorization a owl:Class ;
    rdfs:label "Card Authorization"@en .

lpp:BusinessUnit a owl:Class ;
    rdfs:label "Business Unit"@en .

lpp:Channel a owl:Class ;
    rdfs:label "Channel"@en ;
    rdfs:comment "Sales/payment origination channel: in-warehouse, e-commerce, membership renewal, etc."@en .

lpp:ChargebackReason a owl:Class ;
    rdfs:subClassOf skos:Concept .

lpp:CovenantTest a owl:Class ;
    rdfs:comment "Periodic test of a covenant: status (pass/fail), headroom."@en .

lpp:Department a owl:Class ;
    rdfs:label "Department"@en .

lpp:EsgTarget a owl:Class .

lpp:IndustrySector a owl:Class ;
    rdfs:subClassOf skos:Concept .

lpp:LegalEntity rdfs:label "Legal Entity"@en ;
    rdfs:comment "Stores legal entity master data representing the corporate entities, subsidiaries, and counterparties involved in treasury and payments operations across the retail enterprise. This table supports business questions around jurisdictional exposure, regulatory compliance, and entity-level cash positioning by identifying where each legal entity is domiciled. It serves as a foundational reference for FX hedging strategies, intercompany settlements, and capital allocation decisions segmented by country."@en ;
    rdfs:subClassOf lpp:Company .

lpp:PaymentBatch a owl:Class .

lpp:RateCard a owl:Class ;
    rdfs:comment "Negotiated fee schedule with a bank or processor."@en .

lpp:VaRMetric a owl:Class ;
    rdfs:label "Value-at-Risk Metric"@en .

lpp:AchTransaction rdfs:comment "The AchTransaction class mapped to lpp.transfer represents Automated Clearing House (ACH) electronic fund transfers processed through the banking network, capturing debit and credit movements between bank accounts for payroll, vendor payments, and consumer transactions. This table supports treasury operations by enabling reconciliation of ACH settlements, monitoring payment float, and tracking high-volume batch payment activity. Business questions answered include ACH transaction volumes by counterparty, settlement timing analysis, and identifying failed or returned ACH entries."@en ;
    rdfs:subClassOf lpp:PaymentTransaction .

lpp:Branch a owl:Class ;
    rdfs:comment "The lpp.bank_branch table stores geographic hierarchy information for bank branches, linking each branch to its containing country and region. This table supports treasury operations by enabling analysts to group and filter bank branches by geographic location for cash position reporting, liquidity management, and regulatory compliance across different jurisdictions. It answers questions such as which branches operate within a specific country or region, supporting multi-entity treasury structures common in large retail organizations."@en .

lpp:Covenant a owl:Class ;
    rdfs:label "Covenant"@en .

lpp:Customer rdfs:comment "This table stores third-party entity records representing external counterparties, customers, vendors, or financial institutions involved in treasury and payment transactions. It serves as a reference registry for identifying and classifying non-internal parties across bank relationships, FX counterparties, card acquiring partners, and fraud monitoring. Business questions it answers include who are the external entities transacting with the organization and how are they classified for compliance, credit risk, and payment routing purposes."@en ;
    rdfs:subClassOf lpp:Counterparty .

lpp:Entity a owl:Class ;
    rdfs:comment "This table captures informal dependency relationships between entities within the treasury and payments knowledge graph, representing soft or undocumented linkages that exist outside formal contractual or hierarchical structures. It supports business questions around hidden exposure concentrations, counterparty risk adjacency, and operational interdependencies that may not surface through standard financial reporting. These relationships are critical for stress testing, contagion analysis, and understanding how disruptions to one entity may indirectly affect others across the treasury ecosystem."@en .

lpp:Fact a owl:Class ;
    rdfs:comment "This table stores linkage records that associate tribal knowledge entities — such as business rules, expert insights, calculations, or contextual notes — with specific data objects across the treasury and payments data warehouse. It enables the system to attach institutional knowledge directly to relevant entities like bank accounts, transactions, FX positions, or fraud cases, ensuring that domain expertise is discoverable and queryable alongside structured data. Business questions answered include: what expert knowledge or business rules apply to a given treasury entity, and which entities share common tribal knowledge annotations."@en .

lpp:Settlement a owl:Class ;
    rdfs:label "Card Settlement"@en .

lpp:Signatory a owl:Class ;
    rdfs:label "Bank Account Signatory"@en .

lpp:Vendor rdfs:comment "The lpp.third_party table serves as the master registry for external vendor and counterparty entities involved in treasury and payments operations, including suppliers, banking partners, card networks, and FX counterparties. It supports business questions around vendor payment obligations, counterparty risk exposure, and third-party relationship management across procurement, treasury, and finance functions. This table acts as the foundational reference for linking transactions, invoices, and financial instruments to the external parties that originate or receive them."@en ;
    rdfs:subClassOf lpp:Counterparty .

lpp:counterparty a owl:ObjectProperty ;
    rdfs:label "counterparty bank"@en ;
    rdfs:comment "The name or identifier of the external financial institution, broker, or trading partner to which the company has the recorded exposure. | The name or identifier of the financial institution or trading counterparty on the other side of the derivative contract, used to assess counterparty credit risk and exposure concentration. | The financial institution or bank on the other side of the forward contract, representing the company's credit and settlement exposure for this trade."@en ;
    rdfs:domain lpp:CounterpartyExposure,
        lpp:DerivativeMtm,
        lpp:FxForward ;
    rdfs:range lpp:Bank .

lpp:ApInvoice a owl:Class ;
    rdfs:comment "The ap_invoice table stores accounts payable invoice records within the treasury and payments system, capturing the timing and aging of outstanding or processed vendor invoices. It supports cash flow forecasting, working capital analysis, and payment obligation tracking by categorizing invoices into rolling time windows. This table answers business questions such as how many invoices are due or were processed within recent periods and how payable balances trend over short, medium, and long-term horizons."@en .

lpp:ArInvoice a owl:Class ;
    rdfs:comment "The ArInvoice table stores accounts receivable invoice records for the retail organization, capturing outstanding and settled customer or counterparty invoices relevant to cash flow forecasting and liquidity management. It supports treasury questions around receivables aging, expected cash inflows, and working capital optimization. The table enables analysis of invoice activity across rolling time windows to assess collection velocity and DSO (Days Sales Outstanding) trends."@en .

lpp:AuthenticationMethod a owl:Class ;
    rdfs:subClassOf skos:Concept .

lpp:Country a owl:Class ;
    rdfs:label "Country"@en ;
    rdfs:comment "This table stores the set of countries in which the company operates, identified by their ISO 3166-1 alpha-2 country codes. It serves as a reference dimension for treasury and payments analytics, enabling questions about geographic distribution of cash positions, FX exposure by country, card acquiring volumes, and regulatory jurisdiction for transactions. It underpins multi-currency hedging strategies and cross-border liquidity management across all operational regions."@en .

lpp:FeeServiceType a owl:Class ;
    rdfs:comment "This table is a reference catalog of standardized bank service fee types used to classify charges assessed by banking partners against corporate accounts. It provides a controlled vocabulary for categorizing fees related to account maintenance, transaction processing, wire transfers, ACH activity, and statement delivery. Treasury teams use this table to analyze bank fee structures, benchmark service costs across banking relationships, and support fee negotiation and allocation workflows."@en ;
    rdfs:subClassOf skos:Concept .

lpp:GlAccount a owl:Class ;
    rdfs:comment "The gl_account table defines the chart of accounts used in the treasury general ledger, mapping each bank account or cash pool to its corresponding GL code for accounting and reconciliation purposes. Each record represents a distinct GL account categorized by region, entity, and functional purpose (e.g., operating, payroll, tax, collections). This table supports business questions such as which GL accounts are associated with specific cash purposes or geographies, and how bank account balances map to ledger entries."@en .

lpp:InterestAccrual a owl:Class ;
    rdfs:comment "The InterestAccrual table records daily interest accrual amounts across multiple currencies for the company's treasury positions, capturing the accumulated interest earned or owed as of each valuation date. It supports treasury cash management by enabling tracking of interest income and expense across global bank accounts and investment instruments. This table answers business questions such as total accrued interest by currency, daily accrual trends, and multi-currency interest exposure as of any given date."@en .

lpp:Region a owl:Class ;
    rdfs:label "Region"@en ;
    rdfs:comment "This table stores the geographic regions used to classify and group bank branches, counterparties, and financial exposures across the global treasury and payments operation. It supports regional aggregation of cash positions, FX exposures, transaction volumes, and liquidity metrics. Business questions such as 'What is our total cash position in APAC?' or 'Which regions have the highest card acquiring fraud rates?' are anchored to these region codes."@en .

lpp:Scenario a owl:Class ;
    rdfs:label "Scenario"@en .

lpp:StressTest a owl:Class ;
    rdfs:label "Stress Test"@en ;
    rdfs:comment "Stores predefined treasury stress scenarios used to simulate adverse conditions across liquidity, FX, interest rate, counterparty credit, and banking relationship risk. Each scenario defines a named shock or disruption that can be applied to cash flow forecasts, FX positions, or counterparty exposures to assess the company's financial resilience. This table supports treasury risk management questions such as: what happens to the 30-day liquidity position if top wholesale customers default, or how does a 200bp rate shift affect net interest exposure?"@en ;
    rdfs:subClassOf lpp:Scenario .

lpp:SustainabilityLinkedInstrument rdfs:label "Sustainability-Linked Instrument"@en ;
    rdfs:subClassOf lpp:DebtInstrument .

lpp:BankBranch a owl:Class ;
    rdfs:label "Bank Branch"@en ;
    rdfs:comment "Stores individual bank branch locations for financial institutions used in the company's treasury and banking relationships, identifying specific branches by their institution and geographic location. This table enables treasury operations to route payments, manage cash pooling structures, and assign transactions to the correct physical or operational branch of a banking partner. It supports regulatory reporting, counterparty risk management, and FX hedging by pinpointing which branch of a bank holds accounts or executes transactions."@en .

lpp:CashFlow a owl:Class ;
    rdfs:comment "The lpp.cash_flow table stores aggregated inbound cash flow metrics for treasury liquidity monitoring, capturing the total cash received into accounts over rolling time windows. It supports short-term and medium-term liquidity analysis, enabling treasury teams to assess cash inflow trends, forecast funding needs, and evaluate whether incoming cash adequately supports operational and capital requirements. This table is typically used in conjunction with outflow and balance data to produce net cash position and liquidity coverage reports."@en .

lpp:CashForecast a owl:Class ;
    rdfs:label "Cash Forecast"@en ;
    rdfs:comment "The lpp.forecast_snapshot table stores point-in-time cash flow forecast snapshots used by treasury to project future liquidity positions across short-term and medium-term horizons. Each record represents a versioned forecast run identified by a reference date and a structured code, supporting both direct (cash-movement-based) and indirect (income-statement-based) forecasting methodologies. This table answers questions such as: what was the forecasted cash position as of a given date, how do forecast vintages compare over time, and which forecasting methodology was used for a given planning horizon."@en .

lpp:CounterpartyExposure a owl:Class ;
    rdfs:label "Counterparty Exposure (snapshot)"@en ;
    rdfs:comment "This table tracks the company's financial exposure to individual counterparties (such as banks, brokers, or trading partners) as of specific snapshot dates, capturing the monetary value at risk or outstanding with each party. It supports treasury risk management by enabling monitoring of concentration risk, counterparty credit limits, and compliance with internal or regulatory exposure thresholds. Business questions answered include: What is our total exposure to a given bank or counterparty on a specific date, and how has that exposure trended over time?"@en .

lpp:CreditRatingAgency a owl:Class ;
    rdfs:subClassOf skos:Concept .

lpp:FraudCategory a owl:Class ;
    rdfs:subClassOf skos:Concept .

lpp:FraudLossEvent a owl:Class ;
    rdfs:label "Fraud Loss Event"@en ;
    rdfs:comment "The lpp.fraud_detection_event table records individual fraud detection outcomes for payment transactions, capturing the system's classification and disposition of each event as it passes through fraud screening. Each record represents a single fraud evaluation result tied to a specific transaction, enabling treasury and payments teams to monitor fraud exposure, block rates, and review queue volumes. This table supports business questions around fraud loss quantification, transaction approval rates, and the effectiveness of fraud controls across payment channels."@en .

lpp:MacroIndicator a owl:Class ;
    rdfs:comment "Stores time-series observations of macroeconomic indicators relevant to treasury operations, such as central bank policy rates and other benchmark rates used for liquidity planning, FX hedging decisions, and cost-of-funds analysis. Each row represents a single indicator's value on a specific date for a given geographic region. This table supports business questions around interest rate exposure, hedging strategy alignment, and benchmarking internal funding costs against prevailing market conditions."@en .

lpp:PaymentTxn a owl:Class ;
    rdfs:comment "The lpp.payment_transaction table stores individual payment transactions processed through the company's payment infrastructure, capturing transactional details relevant to treasury and payments operations. It supports business questions around payment volumes, transaction trends, fraud exposure, and cash flow timing across various time horizons. The table enables treasury analysts to monitor recent payment activity and identify patterns in transaction velocity across short, medium, and long-term windows."@en .

lpp:PensionPlan a owl:Class ;
    rdfs:label "Pension Plan"@en ;
    rdfs:comment "Stores details about the company's sponsored pension plans across multiple countries, capturing plan structure and sponsorship arrangements. This table supports treasury and capital allocation decisions by providing visibility into defined benefit and hybrid pension obligations that may impact the company's long-term liability exposure and funding requirements. It enables finance and risk teams to assess cross-border pension commitments and their potential balance sheet implications."@en .

lpp:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "Stores the internal application users who access the treasury and payments data warehouse, identified by their functional role codes and given names. This table enables role-based access control, audit attribution, and workflow ownership across treasury operations including front office, accounts payable, accounts receivable, audit, and executive leadership. It supports questions such as 'which user is responsible for a given transaction approval?' or 'who holds the CFO or Treasury Head role for authorization purposes?'"@en .

lpp:RateCardLine a owl:Class ;
    rdfs:comment "This table stores the negotiated fee rate card lines that define the specific rates agreed upon with external service providers or banks for payment processing and treasury services. Each row represents a single line item on a fee schedule, capturing the currency, service type, and the contractually negotiated rate applicable to that service. It supports treasury cost analysis, vendor fee benchmarking, and validation of actual charges against agreed rate cards."@en .

prov:Activity a owl:Class ;
    rdfs:comment "Records structured feedback sessions conducted with small and medium enterprise (SME) stakeholders or subject matter experts as part of treasury and payments knowledge capture activities. Each session represents a discrete prov:Activity with a defined start and end time, capturing discussions on topics such as cash management, FX hedging strategies, card acquiring operations, or fraud controls. This table supports audit trails of knowledge elicitation sessions and enables traceability of business rules and ontology definitions back to their source conversations."@en .

lpp:AcquirerSlaMetric a owl:Class ;
    rdfs:comment "The acquirer_sla_metric table stores daily service-level agreement (SLA) performance metrics for each card acquirer, capturing operational reliability and processing quality over time. It enables treasury and payments teams to monitor acquirer performance against contractual obligations, identify underperforming acquirers, and support renegotiation or switching decisions. Business questions answered include: Which acquirers are consistently failing authorization rate or uptime thresholds? Are settlement obligations being met on time across all acquiring relationships?"@en .

lpp:CapitalAllocation a owl:Class ;
    rdfs:label "Capital Allocation"@en .

lpp:CapitalAllocationActual a owl:Class ;
    rdfs:comment "Stores actual capital allocation amounts by bucket for a given reporting period, tracking how the company has deployed its available capital across strategic priorities such as capital expenditures, mergers and acquisitions, dividends, debt reduction, and share buybacks. Each record captures the realized dollar amount allocated to a specific bucket alongside the framework target percentage, enabling treasury and finance teams to compare actual capital deployment against predefined strategic allocation targets. This table supports questions about capital discipline, shareholder return execution, and variance analysis between planned and actual capital allocation."@en .

lpp:CardRebateEarning a owl:Class ;
    rdfs:comment "The CardRebateEarning table tracks rebate income earned on corporate card spending by category and quarter, enabling treasury to monitor rebate program performance and optimize card usage to maximize cashback returns. It supports business questions such as which spend categories generate the most rebate value, how rebate yields trend across periods, and whether actual rebates align with program entitlements. This table is central to corporate card program management and working capital optimization."@en .

lpp:CardRebateProgram a owl:Class ;
    rdfs:comment "Stores the master definitions of card rebate programs negotiated between the company and its issuing bank partners, covering virtual cards, commercial cards, and purchasing cards. Each record represents a distinct rebate agreement identified by a program code, capturing the rebate rate (in basis points) the company earns when card spend meets the contractually defined target threshold. This table supports treasury questions around optimizing card program selection, benchmarking rebate yields across issuers, and projecting rebate income based on anticipated spend volumes."@en .

lpp:CashRollup a owl:Class ;
    rdfs:label "Cash Rollup"@en ;
    rdfs:comment "This table stores daily aggregated cash balances rolled up across multiple bank accounts for a specific legal entity and currency, derived from bank statement data. It provides a consolidated snapshot of total available cash on any given date, enabling treasury teams to monitor liquidity positions, track cash movements over time, and answer questions such as 'What was our total EUR cash balance across all accounts on a given date?' and 'How many accounts contributed to our cash position for a specific entity?'"@en .

lpp:Counterparty a owl:Class ;
    rdfs:label "Counterparty (non-bank)"@en ;
    rdfs:comment "Stores counterparty records representing third-party entities involved in treasury and payments operations, including retail partners, acquiring banks, and aggregated consumer groups. Each record identifies an external party that may be associated with transactions, FX exposures, card acquiring flows, or intercompany settlements. This table answers business questions such as which counterparties are generating transaction volumes, which retail partners are exposed to FX risk, and how to segment cash flows by external party."@en .

lpp:CrossBorderPaymentLeg a owl:Class ;
    rdfs:comment "Stores individual legs of cross-border payment transactions, capturing the routing, cost, and FX components of each international payment movement between originating and destination countries. Each record represents a distinct payment corridor with its associated FX spread and lifting fee costs, enabling treasury to analyze the total cost of cross-border fund movements, benchmark corridor efficiency, and optimize routing decisions. This table supports business questions around payment corridor cost analysis, FX spread monitoring, and lifting fee benchmarking across international payment lanes."@en .

lpp:DerivativeMtm a owl:Class ;
    rdfs:label "Derivative Mark-to-Market"@en ;
    rdfs:comment "The DerivativeMtm table stores mark-to-market (MTM) valuations of derivative financial instruments held by the company for FX hedging or other risk management purposes, recorded as of specific valuation dates. Each row captures the fair value gain or loss of a derivative position in a given currency as of a reporting date, enabling treasury to monitor unrealized gains and losses on open derivative contracts. This table supports questions such as current hedge effectiveness, counterparty exposure by instrument, and period-over-period MTM movements across the derivatives portfolio."@en .

lpp:FxRate a owl:Class ;
    rdfs:label "FX Rate"@en ;
    rdfs:comment "Stores foreign exchange rates used to convert between currency pairs as of a specific date, supporting treasury operations such as cash position consolidation, transaction valuation, and FX hedging analysis. Each record represents a directional exchange rate between a source and target currency at a given rate type (e.g., SPOT), enabling the company to express multi-currency balances and exposures in a common base currency. This table answers business questions such as 'What was the USD/MXN spot rate on a given date?' or 'What is the local-currency equivalent of a foreign cash position?'"@en .

lpp:InterestRateBenchmark a owl:Class ;
    rdfs:comment "Stores daily published benchmark interest rates for major global reference rate indices used in treasury operations, hedging valuations, and floating-rate instrument pricing. Each record captures a specific rate code for a given currency and tenor as of a particular business date, enabling treasury teams to answer questions such as current overnight and term funding costs, cross-currency rate comparisons, and historical rate trend analysis. This table supports FX hedging mark-to-market, interest rate risk management, and cash investment benchmarking across the company's multi-currency operations."@en ;
    rdfs:subClassOf skos:Concept .

lpp:LedgerEntry a owl:Class ;
    rdfs:label "ERP Ledger Entry"@en ;
    rdfs:comment "The lpp.gl_balance table stores end-of-period general ledger account balances across the company's international entities, capturing month-end closing positions for treasury-relevant GL accounts by currency. It supports business questions around regional cash and liability balances, multi-currency ledger reconciliation, and period-over-period balance trend analysis. This table is a key input for treasury reporting, cash flow forecasting, and cross-entity financial consolidation."@en .

lpp:PaymentHubThroughput a owl:Class ;
    rdfs:comment "The PaymentHubThroughput table captures daily operational metrics for each payment rail processed through the company's central payment hub, tracking transaction volumes, values, and automation efficiency. It enables treasury and payments teams to monitor straight-through processing (STP) performance, compare throughput across rails such as WIRE, ACH, SEPA_CT, and RTP, and identify automation gaps that may require manual intervention. Business questions answered include: which rails have the highest STP rates, how does daily payment volume and value vary by rail, and where are processing inefficiencies concentrated?"@en .

lpp:SettleBatch a owl:Class ;
    rdfs:comment "SettleBatch represents card settlement batches processed through the payment acquiring pipeline, capturing the aggregation of card transactions submitted to card networks for clearing and settlement. This table supports treasury and payments operations by providing time-windowed views of settlement activity, enabling analysis of settlement volume trends, batch reconciliation, and cash flow forecasting across recent time horizons. It answers business questions such as how many settlement batches have been processed in the last 7, 30, or 90 days, and what the year-to-date settlement batch activity looks like."@en .

lpp:ThirdParty a owl:Class ;
    rdfs:comment "This table stores relationship and risk intelligence data for third-party entities such as suppliers, banking counterparties, and payment processors within the treasury ecosystem. It captures qualitative and quantitative risk attributes that support treasury risk management, counterparty due diligence, and supply chain resilience assessments. Business questions answered include: which suppliers carry high substitution risk, how dependent is the organization on specific third parties, and where are concentration risks in the vendor or banking network?"@en .

lpp:Transfer a owl:Class ;
    rdfs:comment "The Transfer table tracks internal and external fund movement transactions processed through the treasury system, capturing activity summaries across rolling time windows. It supports liquidity monitoring and cash flow analysis by enabling treasury teams to assess transfer volumes and patterns over recent periods. This table answers business questions such as how many or how much in transfers has occurred in the past week, month, or quarter for cash positioning and reconciliation purposes."@en .

lpp:VendorPaymentRollup a owl:Class ;
    rdfs:label "Vendor Payment Rollup"@en ;
    rdfs:comment "VendorPaymentRollup aggregates accounts-payable invoice activity by vendor and calendar month, providing a summarized view of billed amounts, actual payments, and on-time payment performance. It supports treasury and procurement questions around vendor payment discipline, cash outflow planning, and early/late payment analytics. This table is sourced from the lpp.ap_invoice ledger and is a key input for working capital optimization and supplier relationship management."@en .

brain:Evaluation a owl:Class ;
    rdfs:comment "The brain:Evaluation table records the outcomes of AI-assisted query evaluations performed against the treasury and payments knowledge graph, capturing how user questions were interpreted, expanded, and answered. Each record represents a single evaluation event where a natural language or structured query was processed, potentially with graph traversal hops to enrich context. This table supports auditability and transparency of AI-generated insights used in treasury decision-making, such as cash position analysis, FX exposure queries, or fraud pattern investigations."@en .

lpp:AchReturn a owl:Class ;
    rdfs:comment "This table records ACH (Automated Clearing House) payment returns, capturing instances where ACH debits or credits initiated by the company were rejected and returned by the receiving or originating bank. It supports treasury operations by tracking return volumes, amounts, and reasons to monitor payment failure rates, identify problematic accounts or counterparties, and manage NACHA compliance and return rate thresholds. Business questions answered include return rate analysis by reason code, exposure from unauthorized transaction disputes, and operational health of the ACH payment channel."@en .

lpp:BalanceSnapshot a owl:Class ;
    rdfs:label "Balance Snapshot"@en ;
    rdfs:comment "The cash_balance table stores point-in-time snapshots of cash balances held across bank accounts, capturing the monetary position in a specific currency as of a given business date. It supports treasury liquidity monitoring, daily cash positioning, and multi-currency cash reporting for the organization. Business questions it answers include: What is the end-of-day cash balance for a given account on a specific date? What is the total cash position across all accounts in a given currency?"@en .

lpp:BankAccountSignatory a owl:Class ;
    rdfs:comment "The BankAccountSignatory table records the authorized individuals who have signing or releasing authority over specific bank accounts, defining their roles, spending limits, and recertification schedules. It supports treasury governance and controls by answering questions such as who is authorized to sign or release payments on a given account, up to what monetary threshold, and when their authorization must be reviewed and reconfirmed. This table is critical for segregation-of-duties enforcement, audit compliance, and bank mandate management across the organization."@en .

lpp:CardSettlementLine a owl:Class ;
    rdfs:comment "CardSettlementLine represents an individual line item within a card payment settlement batch, capturing the financial and geographic details of a single card transaction being settled. Each record links a settled transaction to its authorization and batch, enabling treasury teams to reconcile gross card receipts, calculate net interchange costs, and analyze cross-border transaction exposure by issuer geography. This table supports questions about interchange fee burdens, foreign-issued card volumes, and settlement-to-authorization matching."@en .

lpp:CardType a owl:Class ;
    rdfs:subClassOf skos:Concept .

lpp:Currency a owl:Class ;
    rdfs:label "Currency"@en ;
    rdfs:comment "The Currency table is a reference master that enumerates every currency recognized within the treasury and payments system, identified by its ISO 4217 alphabetic code. It supports multi-currency operations across bank accounts, FX hedging positions, card acquiring settlements, and cross-border transactions. Business users rely on this table to resolve currency codes into human-readable names and to validate that all financial instruments and cash positions are denominated in supported currencies."@en .

lpp:MembershipFee a owl:Class ;
    rdfs:comment "The MembershipFee table records individual membership fee transactions issued to retail club members, capturing the fee lifecycle from issuance through collection or failure. It supports treasury and revenue analytics around membership income streams, renewal performance, channel mix, and tier-based fee structures. Business questions it answers include: what is the collected vs. failed membership revenue by channel and tier, and which renewal pathways (auto-renew, in-warehouse, ecommerce) drive the most successful fee collections?"@en .

lpp:PaymentFile a owl:Class ;
    rdfs:comment "The payment_file table records outbound payment file submissions processed through the treasury payments infrastructure, capturing batch-level details for each file transmitted to banking partners or payment networks. Each record represents a discrete payment file dispatched for a specific currency, tracking the aggregate volume and value of transactions contained within. This table supports treasury operations monitoring, liquidity management, and payment throughput analysis across multi-currency settlement activities."@en .

lpp:PaymentMethodRollup a owl:Class ;
    rdfs:label "Payment Method Rollup"@en ;
    rdfs:comment "The PaymentMethodRollup class (lpp.transfer table) stores aggregated daily performance metrics for each payment method used across retail transactions, capturing volume, value, and processing quality indicators. It enables treasury and payments teams to monitor payment channel health, identify underperforming or high-failure payment methods, and track trends in transaction success and repair rates over time. Business questions answered include: which payment methods have the highest failure rates, what is the daily transaction throughput by payment method, and how does payment channel performance trend week-over-week?"@en .

lpp:PeerCompany a owl:Class ;
    rdfs:label "Peer Company"@en ;
    rdfs:comment "Stores reference data for peer companies used in treasury and financial benchmarking analyses, enabling comparison of liquidity ratios, working capital metrics, FX exposure, and capital allocation strategies against industry competitors. Each record represents a publicly traded retailer or e-commerce company selected as a relevant benchmark peer, grouped by retail format and market sector. This table supports peer benchmarking dashboards and competitive treasury KPI reporting by providing stable identifiers and classification attributes for each peer."@en .

lpp:ScenarioAssumption a owl:Class ;
    rdfs:comment "This table stores the results of liquidity stress test scenario runs, capturing the projected cash flow impacts for a specific legal entity under a defined stress scenario as of a particular date. It supports treasury risk management by enabling analysis of how various adverse market or operational scenarios affect the company's cash position across currencies. Business questions answered include: what is the projected cash flow impact under a given stress scenario, which entities are most exposed under specific conditions, and how do scenario outcomes compare across currencies and time periods."@en .

lpp:TransactionStatus a owl:Class ;
    rdfs:subClassOf skos:Concept .

lpp:User a owl:Class ;
    rdfs:comment "The lpp.kg_relationship table represents relationship mappings within the knowledge graph, linking users to the entities and knowledge domains they own or are responsible for. It supports treasury and payments governance by capturing which personnel have ownership accountability over specific financial knowledge areas, counterparties, or instruments. This table enables answering questions such as who is the designated owner of a particular treasury knowledge domain and what relationship manager is associated with a given entity or account."@en .

lpp:WorkingCapitalMetric a owl:Class ;
    rdfs:label "Working Capital Metric"@en ;
    rdfs:comment "The WorkingCapitalMetric table stores periodic working capital efficiency metrics for legal entities, capturing the three core cash conversion cycle components — Days Inventory Outstanding, Days Payables Outstanding, and Days Sales Outstanding — as of specific reporting dates. It enables treasury and finance teams to monitor liquidity efficiency, benchmark working capital performance over time, and assess how effectively the organization converts inventory and receivables into cash while managing supplier payment terms. This table supports cash flow forecasting, working capital optimization initiatives, and peer benchmarking analysis."@en .

lpp:AcquirerContract a owl:Class ;
    rdfs:comment "Stores the contractual terms negotiated between the retailer and its card acquirers, defining the commercial and operational conditions under which card payment processing services are provided. Each record represents a distinct acquirer contract period, capturing pricing, settlement timing, service-level commitments, and contract validity windows. This table supports treasury and payments questions around acquiring cost analysis, SLA compliance monitoring, contract renewal planning, and settlement liquidity forecasting."@en .

lpp:EquityAction a owl:Class ;
    rdfs:comment "The EquityAction table records corporate equity events including share buybacks and dividend distributions executed by the company over time. Each record captures the financial details of a single equity action on a specific settlement date, enabling treasury teams to track capital return programs, monitor shareholder distributions, and analyze the cost and scale of buyback activity across quarters. This table supports questions around total capital returned to shareholders, dividend yield trends, buyback pricing efficiency, and shares retired over time."@en .

lpp:ForecastLine a owl:Class ;
    rdfs:comment "The lpp.forecast_cash_flow table stores projected cash inflow and outflow amounts for each line of a treasury cash flow forecast, organized by entity, currency, and driver category as of a specific forecast date. It supports liquidity planning and funding decisions by allowing treasury teams to model expected cash movements across business units and currencies. This table answers questions such as 'What are the forecasted net cash positions by entity and currency for the upcoming period?' and 'How do projected inflows compare to outflows for a given forecast scenario?'"@en .

lpp:FraudLoss a owl:Class ;
    rdfs:comment "The FraudLoss table records confirmed fraud loss events across all payment channels and transaction types, capturing the financial impact, fraud mechanism, and authentication context of each incident. It supports treasury and payments risk questions such as: What is our total fraud loss exposure by channel or authentication method? How do true fraud losses compare to friendly fraud over time? Which fraud vectors are driving the highest losses? Each record represents a discrete fraud loss realization, optionally linked to the detection event that triggered it."@en .

lpp:FxExposure a owl:Class ;
    rdfs:label "FX Exposure"@en ;
    rdfs:comment "The fx_exposure_forecast table stores the company's projected foreign currency exposure positions as of specific reporting dates, capturing both long and short exposures across different tenors and currencies. It supports treasury hedging decisions by quantifying the gross currency risk the company faces over upcoming time horizons before hedging instruments are applied. Business questions answered include: what is our unhedged FX exposure by currency and tenor, are we net long or short in a given currency, and how has our exposure profile changed month over month."@en .

lpp:FxForward rdfs:label "FX Forward"@en ;
    rdfs:comment "The fx_forward table records FX forward contracts used by the treasury department to hedge foreign currency exposure, locking in exchange rates for future settlement dates. Each row represents a single forward contract capturing its full lifecycle from trade execution through settlement. This table supports business questions around hedge coverage, counterparty exposure, settlement scheduling, and trader activity across currency pairs."@en ;
    rdfs:subClassOf lpp:FinancialInstrument .

lpp:HedgePosition a owl:Class ;
    rdfs:label "Hedge Position"@en ;
    rdfs:comment "The lpp.hedge_relationship table records the company's active and historical FX hedge positions, each representing a designated hedging instrument used to manage foreign currency exposure across the retail business. Each row captures a specific hedge relationship including the hedged currency, notional size, and lifecycle status, enabling treasury teams to monitor hedge coverage, assess hedge accounting compliance, and report on open versus dedesignated positions. This table supports questions about total hedged notional by currency, hedge relationship status, and trader accountability."@en .

lpp:InvestmentInstrument rdfs:comment "Stores reference data for investment instruments used by the treasury function to deploy excess cash, primarily money market funds (MMFs) and similar short-duration securities. Each record represents a distinct investable instrument with its key financial characteristics such as credit rating, currency denomination, issuer, and maturity profile. This table supports treasury questions around eligible investment vehicles, counterparty credit quality, currency exposure of cash investments, and compliance with investment policy constraints."@en ;
    rdfs:subClassOf lpp:FinancialInstrument .

lpp:PensionValuation a owl:Class ;
    rdfs:comment "The PensionValuation table stores periodic actuarial valuations of the company's defined benefit pension plans, capturing the financial position of each plan at specific measurement dates. It tracks the projected benefit obligation, plan assets at fair value, funded status, and the impact on other comprehensive income, enabling treasury and finance teams to monitor pension funding levels, assess balance sheet exposure, and comply with accounting standards such as ASC 715 or IAS 19. This table supports questions around pension underfunding/overfunding trends, discount rate sensitivity, and the OCI volatility introduced by pension remeasurements."@en .

lpp:PosTransaction a owl:Class ;
    rdfs:comment "The pos_transaction table records individual point-of-sale and payment transactions across all retail channels, capturing the financial value, currency, location, and timing of each sale or membership event. It supports treasury and payments analysis including daily cash inflow monitoring, channel-level revenue reconciliation, card acquiring settlement validation, and multi-currency exposure tracking across warehouse locations."@en .

lpp:RiskCategory a owl:Class ;
    rdfs:subClassOf skos:Concept .

lpp:SweepRule a owl:Class ;
    rdfs:label "Sweep Rule"@en ;
    rdfs:comment "The lpp.sweep_instruction table defines automated cash sweep rules that govern how funds are transferred between bank accounts to optimize liquidity across the company's global treasury operations. Each record represents a configured sweep rule for a specific currency and operating account, specifying the conditions and targets for moving excess or deficit cash between source and destination accounts. This table answers business questions such as: what are the target zero-balance or notional pooling thresholds for each country operating account, and which accounts are linked in sweep relationships for automated intraday or end-of-day cash concentration?"@en .

lpp:Balance a owl:Class ;
    rdfs:comment "The lpp.bank_statement_balance table stores point-in-time balance snapshots for bank accounts, capturing opening, closing, and available balances alongside rolling inflow aggregates over multiple lookback windows. It supports treasury cash positioning, liquidity monitoring, and cash flow trend analysis across the retail organization. Business users can query this table to understand current and historical cash positions, identify liquidity trends, and reconcile bank statement balances against internal records."@en .

lpp:DebtInstrument rdfs:label "Debt Instrument"@en ;
    rdfs:subClassOf lpp:FinancialInstrument .

lpp:ForecastActual a owl:Class ;
    rdfs:label "Forecast vs Actual"@en ;
    rdfs:comment "This table stores period-end comparisons between forecasted and actual cash outflows across key treasury driver categories, enabling treasury teams to measure forecast accuracy and identify variance drivers. It supports cash forecasting governance, liquidity planning reviews, and variance attribution by category such as payroll, AP disbursements, taxes, and capital expenditures. It is used to answer questions such as which cash flow categories are most frequently over- or under-forecast, and how forecast accuracy trends over time by entity and currency."@en .

lpp:InstrumentType a owl:Class ;
    rdfs:subClassOf skos:Concept .

lpp:PaymentMethod a owl:Class ;
    rdfs:label "Payment Method"@en ;
    rdfs:subClassOf skos:Concept .

lpp:ReconciliationItem a owl:Class ;
    rdfs:label "Reconciliation Item"@en ;
    rdfs:comment "This table stores the results of general ledger reconciliation checks performed at the end of each accounting period, comparing internal ledger balances against external bank or system records to ensure consistency. It tracks whether ledger accounts are in balance, captures any discrepancies identified during the reconciliation process, and supports treasury operations in confirming the accuracy of cash and account positions. Business questions answered include: which GL accounts are out of balance, what is the magnitude of unreconciled discrepancies, and which periods or accounts require investigation or sign-off."@en .

lpp:Acquirer a owl:Class ;
    rdfs:label "Card Acquirer / Processor"@en ;
    rdfs:comment "Stores the reference data for card payment acquirers (merchant acquiring banks and payment processors) that process card transactions on behalf of the retail company across its operating regions. Each acquirer record represents a contractual acquiring relationship used to route, settle, and reconcile card-present and card-not-present payments. This table supports treasury questions around acquirer concentration risk, settlement account mapping, regional acquiring strategy, and affiliated banking relationships."@en .

lpp:CardNetwork a owl:Class ;
    rdfs:label "Card Network"@en ;
    rdfs:comment "Stores the reference catalog of payment card networks accepted or processed by the company, including both major global networks and proprietary private-label programs. This table supports treasury and payments analysis by classifying transaction volumes, interchange costs, fraud rates, and acceptance fees by network type. It enables reporting on network concentration risk, cost-of-acceptance benchmarking, and FX exposure segmentation across credit, charge, debit, and private-label rails."@en ;
    rdfs:subClassOf skos:Concept .

lpp:CardPaymentRollup a owl:Class ;
    rdfs:label "Card Payment Rollup"@en ;
    rdfs:comment "Stores daily rolled-up card payment settlement batches summarizing gross sales, fee components, and net settlement amounts processed through card acquiring channels. Each record represents an aggregated settlement batch for a specific date, enabling treasury to monitor daily card acceptance costs, calculate effective interchange rates, and reconcile net cash received from acquirers against point-of-sale gross sales. This table supports cost-of-acceptance analysis, acquirer fee auditing, and daily cash position forecasting for card-based revenue streams."@en .

lpp:CardTransaction rdfs:subClassOf lpp:PaymentTransaction .

lpp:CreditRating a owl:Class ;
    rdfs:label "Credit Rating"@en ;
    rdfs:comment "Stores credit ratings assigned by major rating agencies to companies tracked in the treasury system, capturing both historical and current ratings with their associated outlooks. This table supports treasury and capital allocation decisions by providing an up-to-date view of counterparty or corporate creditworthiness, enabling analysis of credit risk exposure across banking relationships, investment counterparties, and peer benchmarks. It answers questions such as which companies hold investment-grade ratings, which ratings are currently active, and how ratings have changed over time across agencies."@en .

lpp:DebtMaturity a owl:Class ;
    rdfs:comment "The lpp.borrowing table records the company's debt obligations and borrowing activity, capturing each loan or credit facility drawn down across currencies and legal entities. It supports treasury questions around debt maturity profiles, outstanding principal balances, all-in borrowing costs, and repayment status. This table is central to liquidity planning, debt scheduling, and interest expense analysis."@en .

lpp:FinancialInstrument a owl:Class ;
    rdfs:label "Financial Instrument"@en ;
    rdfs:comment "Abstract parent for anything that contributes to counterparty exposure."@en .

lpp:IntercompanyTransfer rdfs:label "Intercompany Transfer"@en ;
    rdfs:comment "This table records intercompany fund transfers between legal entities or subsidiaries within the retail group, capturing the movement of cash across internal accounts in multiple currencies. It supports treasury questions around intragroup liquidity management, intercompany settlement tracking, and internal funding flows. Business users can query outstanding or settled intercompany positions, identify funding sources and destinations, and reconcile internal cash movements across entities."@en ;
    rdfs:subClassOf lpp:Transaction .

lpp:InvestmentPosition a owl:Class ;
    rdfs:label "Investment Position"@en ;
    rdfs:comment "The InvestmentPosition table tracks the treasury department's short-term and money-market investment holdings on a weekly snapshot basis, capturing both cost-basis and fair-value metrics for each fixed-income instrument held. It supports liquidity management, portfolio performance monitoring, and duration risk reporting for the company's cash investment program. This table answers business questions such as unrealized gain/loss on the investment portfolio, weighted average duration of holdings, yield profiles, and which legal entity or fund holds each position."@en .

lpp:LetterOfCredit rdfs:comment "This table stores details of letters of credit (LCs) issued to support the company's trade finance and contractual obligations, covering both standby and commercial LC types. It tracks the full lifecycle of each LC from issuance through expiration, including the face value committed, amounts drawn against it, and current status. It answers treasury questions such as total contingent liability exposure, available LC capacity, utilization rates, upcoming expirations requiring renewal, and which banking facilities are being consumed."@en ;
    rdfs:subClassOf lpp:DebtInstrument .

lpp:Payable rdfs:comment "The ap_invoice table stores accounts payable invoice records representing amounts owed by the retail company to its suppliers and vendors across multiple currencies. Each record captures the full lifecycle of a payable from invoice receipt through payment, supporting treasury questions around outstanding obligations, cash outflow forecasting, payment terms compliance, and working capital management. This table feeds cash position planning, DPO (Days Payable Outstanding) analysis, and vendor payment scheduling."@en ;
    rdfs:subClassOf lpp:Invoice .

lpp:PaymentException a owl:Class ;
    rdfs:label "Payment Exception"@en ;
    rdfs:comment "The lpp.payment_exception table records anomalies, errors, and irregularities detected during payment processing, capturing details about each exception from detection through resolution. It supports operational monitoring of payment pipeline health, SLA compliance for exception resolution, and root cause analysis by exception type. Treasury and payments teams use this table to track resolution efficiency, identify recurring failure patterns (e.g., duplicate submissions, bank validation failures, file format errors), and measure remediation performance."@en .

lpp:Receivable rdfs:comment "The lpp.ar_invoice table stores accounts receivable invoices representing amounts owed to the company by customers or business counterparties, capturing the full lifecycle from invoice issuance through payment settlement. Each record tracks a single invoice with its amount, currency, payment terms, and status, supporting treasury cash flow forecasting, DSO (Days Sales Outstanding) analysis, and receivables aging. The table answers business questions such as outstanding receivables balances, on-time payment performance, and expected cash inflows by entity and currency."@en ;
    rdfs:subClassOf lpp:Invoice .

lpp:BankFee a owl:Class ;
    rdfs:label "Bank Fee"@en ;
    rdfs:comment "The BankFee table records individual fees charged by banking partners to the company's accounts, capturing the fee amount, currency, and service type for a given reporting date. It supports treasury operations by enabling analysis of bank service costs, contract compliance verification against negotiated rate cards, and fee optimization across banking relationships. Business questions answered include which banks are charging above contracted rates, total fee spend by service type or account, and period-over-period fee trends."@en .

lpp:CompanyFinancialMetric a owl:Class ;
    rdfs:comment "This table stores quarterly and annual financial performance metrics for peer companies used in benchmarking and capital allocation analysis within the treasury function. It captures profitability, leverage, cash generation, and valuation metrics that enable treasury to compare the company's financial health against industry peers. Business questions answered include: how does our leverage compare to peers, what is the peer median WACC for discount rate benchmarking, and how do free cash flow yields stack up across the competitive set?"@en .

lpp:Invoice a owl:Class ;
    rdfs:label "Invoice"@en ;
    rdfs:comment "This table stores working capital finance (WCF) invoice documents representing payables or receivables submitted for early payment programs, supply chain financing, or dynamic discounting arrangements. Each record tracks the lifecycle of an invoice from submission through approval to payment, supporting treasury questions around outstanding payables, cash flow forecasting, and working capital optimization. It enables analysis of invoice aging, payment timing relative to due dates, and counterparty financing activity."@en .

lpp:PeerCompanyMetric a owl:Class ;
    rdfs:comment "The lpp.peer_company_metric table stores periodic financial and operational benchmarking metrics for peer companies in the retail sector, enabling treasury and payments teams to compare their organization's performance against industry counterparts. Each record captures a snapshot of a peer company's capital structure, profitability, cash generation, shareholder returns, and payments cost efficiency for a given reporting period. This table supports benchmarking questions around fraud loss rates, payments cost as a percentage of revenue, leverage ratios, dividend and buyback yields, and free cash flow generation relative to peers."@en .

lpp:SweepEvent a owl:Class ;
    rdfs:label "Cash Sweep Event"@en ;
    rdfs:comment "The lpp.sweep_execution table records individual cash sweep events in which funds are automatically transferred between bank accounts according to predefined treasury rules, consolidating or redistributing liquidity across the organization. Each row captures a single sweep transaction, its monetary details, status, and the rule that triggered it. This table answers business questions about automated cash concentration activity, sweep frequency and volume over rolling time windows, and the effectiveness of liquidity management rules."@en .

lpp:CardSettlementBatch a owl:Class ;
    rdfs:comment "The card_settlement_batch table records the financial summary of each card payment settlement batch processed through the acquiring network, capturing gross sales, interchange, network assessment, processor margin, and net settlement amounts per batch cycle. It tracks the key timestamps in the settlement lifecycle—from batch close through processor settlement to bank deposit—enabling treasury to monitor daily cash conversion, SLA compliance, and the cost breakdown of card acceptance. This table answers business questions such as: what net funds were deposited to our bank accounts from card sales on a given day, are our acquirers meeting settlement SLAs, and what is the blended cost of card acceptance by acquirer or network?"@en .

lpp:Chargeback a owl:Class ;
    rdfs:label "Chargeback"@en ;
    rdfs:comment "The lpp.chargeback table records all payment disputes initiated against the company's merchant accounts, capturing the full lifecycle from initiation through resolution. It enables treasury and payments teams to monitor dispute volumes, track win/loss ratios, classify fraud versus merchant error, and analyze chargeback exposure by reason code and network. This table is central to fraud management reporting, acquiring cost control, and compliance with card network dispute rules."@en .

brain:TribalFact a owl:Class ;
    rdfs:comment "The lpp.tribal_knowledge_fact table stores curated, human-authored or AI-captured institutional knowledge about treasury and payments operations, including business rules, observed patterns, and contextual insights that are not formally codeled elsewhere in the data model. Each record represents a discrete piece of operational wisdom — such as a known FX hedging heuristic, a bank behavior pattern, or a seasonal cash positioning rule — that can be surfaced to analysts and AI query agents to enrich decision-making. This table answers questions such as: What implicit rules govern our liquidity buffers? What institutional context should inform interpretation of anomalous transactions or peer benchmark deviations?"@en .

lpp:CardAuthorization a owl:Class ;
    rdfs:comment "Stores individual card authorization events captured at the point of authorization request and response, representing the real-time approval or decline of card-based payment transactions across the company's acquiring network. Each record corresponds to a single authorization attempt, enabling treasury and payments teams to monitor approval rates, decline patterns, 3DS authentication behavior, and authorization response latency. This table supports operational KPIs such as authorization success rates, fraud exposure by transaction size band, and acquirer or network performance benchmarking."@en .

lpp:CreditFacility rdfs:comment "The lpp.credit_facility table records all corporate credit facilities available to the treasury, including revolving credit facilities, term loans, overdrafts, commercial paper programs, and intercompany lines. It captures the key economic and structural terms of each facility such as size, pricing, tenor, and counterparty, enabling treasury to monitor available liquidity headroom, upcoming maturities, borrowing costs, and lender exposure across currencies. This table supports questions about total committed credit capacity, weighted average cost of debt, facility utilization, and refinancing risk."@en ;
    rdfs:subClassOf lpp:DebtInstrument .

lpp:PaymentTransaction rdfs:label "Payment Transaction"@en ;
    rdfs:comment "The lpp.transfer table records individual payment transactions initiated by the treasury or accounts payable function, capturing outbound transfers such as rent payments and supplier invoice settlements across multiple currencies and geographies. Each row represents a single payment instruction with its lifecycle status, value date, and identifying reference, enabling treasury teams to track payment execution, monitor outstanding obligations, and reconcile bank settlements. This table supports business questions around payment status monitoring, cash flow forecasting by value date, currency exposure from pending transfers, and audit of rejected or failed payment instructions."@en ;
    rdfs:subClassOf lpp:Transaction .

lpp:Transaction a owl:Class ;
    rdfs:label "Transaction"@en ;
    rdfs:comment "The lpp.cash_flow table records confirmed and projected cash flow transactions representing the movement of funds out of or into company bank accounts, primarily capturing payroll disbursements, supplier payments, and other scheduled outflows. Each row represents a discrete financial transaction tied to a specific account, currency, and settlement date, enabling treasury teams to monitor liquidity positions, forecast cash requirements, and reconcile actual versus planned cash movements. This table is central to answering questions about when funds will leave or enter accounts, in what currency, and for what business purpose."@en .

lpp:Bank a owl:Class ;
    rdfs:label "Bank"@en ;
    rdfs:comment "Stores reference data for banking institutions that the company maintains relationships with, including counterparty banks, acquiring banks, FX dealing banks, and custodians. Each record represents a unique legal banking entity identified by global standards such as BIC and LEI. This table supports counterparty risk analysis, bank relationship management, and regulatory reporting by linking transactional data to formally identified financial institutions."@en .

lpp:BankAccount a owl:Class ;
    rdfs:label "Bank Account"@en ;
    rdfs:comment "Stores the master registry of bank accounts held by the retail organization across all financial institutions, branches, and currencies. Each record represents a distinct bank account used for treasury operations including cash concentration, disbursements, collections, FX settlements, and intercompany transfers. This table answers business questions such as: which accounts are held at which banks and branches, what currency is each account denominated in, and which legal entity or business unit owns each account."@en .

lpp:Company a owl:Class ;
    rdfs:label "Company"@en ;
    rdfs:comment "Stores master reference data for companies that interact with the treasury and payments ecosystem, including banks, payment processors, FX counterparties, card acquirers, and vendors. Each record represents a distinct legal or commercial entity identified by standard codes and legal entity identifiers. This table supports counterparty management, FX hedging relationship tracking, vendor negotiations, and peer benchmarking analyses."@en .

