@prefix rr:    <http://www.w3.org/ns/r2rml#> .
@prefix lpp:   <https://lpp.example/ontology#> .
@prefix brain: <https://lpp.example/ontology/brain#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix lppid: <https://lpp.example/id/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# R2RML mapping — LPP treasury + Brain layer
#
# Tested target: Apache Jena via the r2rml-loader CLI, with Ontop 5.x as an
# alternative for virtual SPARQL endpoints.
#
# Database dialect: Amazon Redshift (schema `lpp`, lowercase identifiers).
#   - All `rr:tableName` references use unquoted lowercase (`lpp.currency`).
#   - All `rr:column` references use uppercase per R2RML default; Redshift
#     returns column names case-insensitively so this works without quoting.
#   - SUPER columns (semi-structured) are not materialized as triples here;
#     project specific JSON paths via rr:sqlQuery when needed.
#
# Convention:
#   Subject IRI template uses the *business key* column (`code` or composite).
#   Object property targets reference the same business-key IRIs, so FK joins
#   line up without any explicit rr:joinCondition.
#
# Named graphs (loaded into Apache Jena):
#   - Triples from sections below default to <graph:treasury>.
#   - Brain-layer TriplesMaps explicitly target <graph:treasury:brain>
#     via rr:graph.
# =============================================================================

# -----------------------------------------------------------------------------
# CURRENCY
# -----------------------------------------------------------------------------
<#CurrencyMap>
    rr:logicalTable [ rr:tableName "LPP.CURRENCY" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/currency/{CODE}" ;
        rr:class    lpp:Currency
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code        ; rr:objectMap [ rr:column "CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:name        ; rr:objectMap [ rr:column "DESCRIPTION" ] ] .

# -----------------------------------------------------------------------------
# BANK
# -----------------------------------------------------------------------------
<#BankMap>
    rr:logicalTable [ rr:tableName "LPP.BANK" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/bank/{CODE}" ;
        rr:class    lpp:Bank
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code ; rr:objectMap [ rr:column "CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:name ; rr:objectMap [ rr:column "DESCRIPTION1" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:bic  ; rr:objectMap [ rr:column "BIC" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:lei  ; rr:objectMap [ rr:column "LEI" ] ] .

# -----------------------------------------------------------------------------
# COMPANY
# -----------------------------------------------------------------------------
<#CompanyMap>
    rr:logicalTable [ rr:tableName "LPP.COMPANY" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/company/{CODE}" ;
        rr:class    lpp:Company
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code        ; rr:objectMap [ rr:column "CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:name        ; rr:objectMap [ rr:column "NAME" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:countryCode ; rr:objectMap [ rr:column "COUNTRY" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:lei         ; rr:objectMap [ rr:column "LEI" ] ] .

# -----------------------------------------------------------------------------
# BANK_BRANCH (so BankAccount → Bank can be derived)
# -----------------------------------------------------------------------------
<#BankBranchMap>
    rr:logicalTable [ rr:tableName "LPP.BANK_BRANCH" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/branch/{CODE}" ;
        rr:class    lpp:BankBranch
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code ; rr:objectMap [ rr:column "CODE" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:branchOf ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank/{BANK_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:countryCode ; rr:objectMap [ rr:column "COUNTRY_CODE" ] ] .

# -----------------------------------------------------------------------------
# BANK_ACCOUNT — typed by ACCOUNT_PURPOSE so OperatingAccount, ConcentrationAccount,
# etc. become RDF classes via separate purpose-specific TriplesMaps.
# -----------------------------------------------------------------------------
<#BankAccountMap>
    rr:logicalTable [ rr:tableName "LPP.BANK_ACCOUNT" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/bank-account/{CODE}" ;
        rr:class    lpp:BankAccount
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code ; rr:objectMap [ rr:column "CODE" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:ownedBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{COMPANY_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:atBranch ;
        rr:objectMap [ rr:template "https://lpp.example/id/branch/{BRANCH_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:hasCurrency ;
        rr:objectMap [ rr:template "https://lpp.example/id/currency/{CURRENCY_REF}" ]
    ] .

# Materialize the BankAccount → Bank shortcut (lpp:heldAt) by joining through branch.
<#BankAccountHeldAtMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT a.CODE AS ACCOUNT_CODE, b.BANK_REF
        FROM LPP.BANK_ACCOUNT a
        JOIN LPP.BANK_BRANCH  b ON a.BRANCH_REF = b.CODE
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/bank-account/{ACCOUNT_CODE}" ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:heldAt ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank/{BANK_REF}" ]
    ] .

# Purpose subclasses — ConcentrationAccount, OperatingAccount, etc.
<#ConcentrationAccountMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT CODE FROM LPP.BANK_ACCOUNT WHERE ACCOUNT_PURPOSE = 'CONCENTRATION'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/bank-account/{CODE}" ;
        rr:class    lpp:ConcentrationAccount
    ] .

<#OperatingAccountMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT CODE FROM LPP.BANK_ACCOUNT WHERE ACCOUNT_PURPOSE = 'OPERATING'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/bank-account/{CODE}" ;
        rr:class    lpp:OperatingAccount
    ] .

# -----------------------------------------------------------------------------
# INVESTMENT_INSTRUMENT
# -----------------------------------------------------------------------------
<#InvestmentInstrumentMap>
    rr:logicalTable [ rr:tableName "LPP.INVESTMENT_INSTRUMENT" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/instrument/{CODE}" ;
        rr:class    lpp:InvestmentInstrument
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code         ; rr:objectMap [ rr:column "CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:rating       ; rr:objectMap [ rr:column "RATING" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:maturityDate ;
        rr:objectMap [ rr:column "MATURITY_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:issuerBank ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank/{ISSUER_BANK_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:hasCurrency ;
        rr:objectMap [ rr:template "https://lpp.example/id/currency/{CURRENCY_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:instrumentType ;
        rr:objectMap [ rr:template "https://lpp.example/id/instrument-type/{INSTRUMENT_TYPE}" ]
    ] .

# -----------------------------------------------------------------------------
# INVESTMENT_POSITION
# -----------------------------------------------------------------------------
<#InvestmentPositionMap>
    rr:logicalTable [ rr:tableName "LPP.INVESTMENT_POSITION" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/position/{UUID}" ;
        rr:class    lpp:InvestmentPosition
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "AS_OF_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:faceAmount ;
        rr:objectMap [ rr:column "FACE_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:marketValue ;
        rr:objectMap [ rr:column "MARKET_VALUE" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:bookValue ;
        rr:objectMap [ rr:column "BOOK_VALUE" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:yieldToMaturity ;
        rr:objectMap [ rr:column "YIELD_TO_MATURITY" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:durationDays ;
        rr:objectMap [ rr:column "DURATION_DAYS" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:hasInstrument ;
        rr:objectMap [ rr:template "https://lpp.example/id/instrument/{INSTRUMENT_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:heldBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{COMPANY_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:fundedBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank-account/{BANK_ACCOUNT_REF}" ]
    ] .

# -----------------------------------------------------------------------------
# FX_FORWARD
# -----------------------------------------------------------------------------
<#FxForwardMap>
    rr:logicalTable [ rr:tableName "LPP.FX_FORWARD" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/fx-forward/{DEAL_ID}" ;
        rr:class    lpp:FxForward
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code      ; rr:objectMap [ rr:column "DEAL_ID" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:tradeDate ;
        rr:objectMap [ rr:column "TRADE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:valueDate ;
        rr:objectMap [ rr:column "VALUE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status    ; rr:objectMap [ rr:column "STATUS" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:tradedBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{COMPANY_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:counterparty ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank/{COUNTERPARTY_BANK_REF}" ]
    ] .

# -----------------------------------------------------------------------------
# DERIVATIVE_MTM — links to the FxForward (or other derivative) it values
# -----------------------------------------------------------------------------
<#DerivativeMtmMap>
    rr:logicalTable [ rr:tableName "LPP.DERIVATIVE_MTM" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/mtm/{INSTRUMENT_REF}-{VALUATION_DATE}" ;
        rr:class    lpp:DerivativeMtm
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "VALUATION_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:mtmAmount ;
        rr:objectMap [ rr:column "MTM_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "MTM_CURRENCY" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:counterparty ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank/{COUNTERPARTY_BANK_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:valuesInstrument ;
        rr:objectMap [ rr:template "https://lpp.example/id/fx-forward/{INSTRUMENT_REF}" ]
    ] .

# =============================================================================
# BRAIN LAYER — Tribal knowledge, SME-taught KG edges, SME feedback sessions,
# brain evaluations. All triples below land in named graph <graph:treasury:brain>.
#
# IRI conventions:
#   brain:fact/{uuid}        — tribal facts
#   brain:edge/{uuid}        — SME-taught typed edges
#   brain:session/{uuid}     — SME feedback sessions (prov:Activity)
#   brain:eval/{uuid}        — per-query Brain evaluations
# =============================================================================

# -----------------------------------------------------------------------------
# TRIBAL_KNOWLEDGE_FACT — base mapping. Per-type subclasses follow.
# -----------------------------------------------------------------------------
<#TribalKnowledgeFactMap>
    rr:logicalTable [ rr:tableName "lpp.tribal_knowledge_fact" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/fact/{UUID}" ;
        rr:class    brain:TribalFact ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [ rr:predicate brain:factType         ; rr:objectMap [ rr:column "FACT_TYPE" ] ] ;
    rr:predicateObjectMap [ rr:predicate brain:narrative        ; rr:objectMap [ rr:column "NARRATIVE" ] ] ;
    rr:predicateObjectMap [ rr:predicate brain:title            ; rr:objectMap [ rr:column "TITLE" ] ] ;
    rr:predicateObjectMap [ rr:predicate brain:triggerCondition ; rr:objectMap [ rr:column "TRIGGER_CONDITION" ] ] ;
    rr:predicateObjectMap [ rr:predicate brain:confidence       ; rr:objectMap [ rr:column "CONFIDENCE" ] ] ;
    rr:predicateObjectMap [ rr:predicate brain:status           ; rr:objectMap [ rr:column "STATUS" ] ] ;
    rr:predicateObjectMap [ rr:predicate brain:effectiveFrom ;
        rr:objectMap [ rr:column "EFFECTIVE_FROM" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate brain:effectiveTo ;
        rr:objectMap [ rr:column "EFFECTIVE_TO" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [
        rr:predicate prov:wasGeneratedBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/brain/session/{SOURCE_SESSION}" ]
    ] ;
    rr:predicateObjectMap [ 
        rr:predicate prov:wasAttributedTo ;
        rr:objectMap [ rr:template "https://lpp.example/id/user/{CAPTURED_BY_USER}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate prov:generatedAtTime ;
        rr:objectMap [ rr:column "CAPTURED_AT" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [
        rr:predicate brain:supersededBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/brain/fact/{SUPERSEDED_BY}" ]
    ] .

# Per-fact-type RDF subclasses (VerbalCommitment, SideAgreement, etc.).
# One TriplesMap per type so SPARQL can filter by class without scanning FACT_TYPE.
<#VerbalCommitmentMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT uuid FROM lpp.tribal_knowledge_fact WHERE fact_type = 'VERBAL_COMMITMENT'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/fact/{UUID}" ;
        rr:class    brain:VerbalCommitment ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] .

<#SideAgreementMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT uuid FROM lpp.tribal_knowledge_fact WHERE fact_type = 'SIDE_AGREEMENT'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/fact/{UUID}" ;
        rr:class    brain:SideAgreement ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] .

<#BehavioralPatternMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT uuid FROM lpp.tribal_knowledge_fact WHERE fact_type = 'BEHAVIORAL_PATTERN'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/fact/{UUID}" ;
        rr:class    brain:BehavioralPattern ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] .

<#RMSignalMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT uuid FROM lpp.tribal_knowledge_fact WHERE fact_type = 'RM_SIGNAL'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/fact/{UUID}" ;
        rr:class    brain:RMSignal ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] .

<#StrategicPreferenceMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT uuid FROM lpp.tribal_knowledge_fact WHERE fact_type = 'STRATEGIC_PREFERENCE'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/fact/{UUID}" ;
        rr:class    brain:StrategicPreference ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] .

<#UndocumentedConstraintMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT uuid FROM lpp.tribal_knowledge_fact WHERE fact_type = 'UNDOCUMENTED_CONSTRAINT'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/fact/{UUID}" ;
        rr:class    brain:UndocumentedConstraint ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] .

# -----------------------------------------------------------------------------
# TRIBAL_KNOWLEDGE_ENTITY_LINK — brain:appliesTo edges from fact to domain entity.
# One TriplesMap per ENTITY_TYPE so the IRI template can resolve to the right
# treasury IRI namespace (company, bank, third-party, facility, account, user).
# -----------------------------------------------------------------------------
<#FactAppliesToCompanyMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT fact_uuid, entity_code FROM lpp.tribal_knowledge_entity_link WHERE entity_type = 'COMPANY'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/fact/{FACT_UUID}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:appliesTo ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{ENTITY_CODE}" ]
    ] .

<#FactAppliesToBankMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT fact_uuid, entity_code FROM lpp.tribal_knowledge_entity_link WHERE entity_type = 'BANK'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/fact/{FACT_UUID}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:appliesTo ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank/{ENTITY_CODE}" ]
    ] .

<#FactAppliesToThirdPartyMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT fact_uuid, entity_code FROM lpp.tribal_knowledge_entity_link WHERE entity_type = 'THIRD_PARTY'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/fact/{FACT_UUID}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:appliesTo ;
        rr:objectMap [ rr:template "https://lpp.example/id/third-party/{ENTITY_CODE}" ]
    ] .

<#FactAppliesToCreditFacilityMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT fact_uuid, entity_code FROM lpp.tribal_knowledge_entity_link WHERE entity_type = 'CREDIT_FACILITY'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/fact/{FACT_UUID}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:appliesTo ;
        rr:objectMap [ rr:template "https://lpp.example/id/credit-facility/{ENTITY_CODE}" ]
    ] .

<#FactAppliesToHedgeMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT fact_uuid, entity_code FROM lpp.tribal_knowledge_entity_link WHERE entity_type = 'HEDGE_RELATIONSHIP'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/fact/{FACT_UUID}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:appliesTo ;
        rr:objectMap [ rr:template "https://lpp.example/id/hedge/{ENTITY_CODE}" ]
    ] .

<#FactAppliesToBankAccountMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT fact_uuid, entity_code FROM lpp.tribal_knowledge_entity_link WHERE entity_type = 'BANK_ACCOUNT'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/fact/{FACT_UUID}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:appliesTo ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank-account/{ENTITY_CODE}" ]
    ] .

<#FactAppliesToUserMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT fact_uuid, entity_code FROM lpp.tribal_knowledge_entity_link WHERE entity_type = 'APP_USER'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/fact/{FACT_UUID}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:appliesTo ;
        rr:objectMap [ rr:template "https://lpp.example/id/user/{ENTITY_CODE}" ]
    ] .

<#FactAppliesToFxForwardMap>
    rr:logicalTable [ rr:sqlQuery
        "SELECT fact_uuid, entity_code FROM lpp.tribal_knowledge_entity_link WHERE entity_type = 'FX_FORWARD'" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/fact/{FACT_UUID}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:appliesTo ;
        rr:objectMap [ rr:template "https://lpp.example/id/fx-forward/{ENTITY_CODE}" ]
    ] .

# -----------------------------------------------------------------------------
# KG_RELATIONSHIP — SME-taught typed edges. One TriplesMap per relationship_type
# so each row becomes a triple using the matching object property. From/to IRI
# resolution branches by from_entity_type and to_entity_type — see the per-type
# SQL filters below.
# -----------------------------------------------------------------------------

# SHARED_PARENT_INSTITUTION: Bank ↔ Bank or Bank ↔ ThirdParty (counterparty).
<#KgSharedParentBankToBankMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT from_entity_code, to_entity_code
        FROM lpp.kg_relationship
        WHERE relationship_type = 'SHARED_PARENT_INSTITUTION'
          AND status = 'ACTIVE'
          AND from_entity_type = 'BANK' AND to_entity_type = 'BANK'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/bank/{FROM_ENTITY_CODE}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:sharedParentInstitution ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank/{TO_ENTITY_CODE}" ]
    ] .

<#KgSharedParentBankToCpMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT from_entity_code, to_entity_code
        FROM lpp.kg_relationship
        WHERE relationship_type = 'SHARED_PARENT_INSTITUTION'
          AND status = 'ACTIVE'
          AND from_entity_type = 'BANK' AND to_entity_type = 'THIRD_PARTY'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/bank/{FROM_ENTITY_CODE}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:sharedParentInstitution ;
        rr:objectMap [ rr:template "https://lpp.example/id/third-party/{TO_ENTITY_CODE}" ]
    ] .

# BOARD_MEMBER_OVERLAP: Bank ↔ Bank (symmetric, materialize both directions or
# rely on owl:SymmetricProperty inference in Jena).
<#KgBoardMemberOverlapMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT from_entity_code, to_entity_code
        FROM lpp.kg_relationship
        WHERE relationship_type = 'BOARD_MEMBER_OVERLAP' AND status = 'ACTIVE'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/bank/{FROM_ENTITY_CODE}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:boardMemberOverlap ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank/{TO_ENTITY_CODE}" ]
    ] .

# STRATEGIC_VENDOR_TIER: Company → ThirdParty (vendor).
<#KgStrategicVendorTierMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT from_entity_code, to_entity_code
        FROM lpp.kg_relationship
        WHERE relationship_type = 'STRATEGIC_VENDOR_TIER' AND status = 'ACTIVE'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/company/{FROM_ENTITY_CODE}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:strategicVendorTier ;
        rr:objectMap [ rr:template "https://lpp.example/id/third-party/{TO_ENTITY_CODE}" ]
    ] .

# KNOWLEDGE_OWNER_OF: User → Hedge/Facility/FxForward (person owns the context).
<#KgKnowledgeOwnerHedgeMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT from_entity_code, to_entity_code
        FROM lpp.kg_relationship
        WHERE relationship_type = 'KNOWLEDGE_OWNER_OF'
          AND from_entity_type = 'APP_USER' AND to_entity_type = 'HEDGE_RELATIONSHIP'
          AND status = 'ACTIVE'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/user/{FROM_ENTITY_CODE}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:knowledgeOwnerOf ;
        rr:objectMap [ rr:template "https://lpp.example/id/hedge/{TO_ENTITY_CODE}" ]
    ] .

<#KgKnowledgeOwnerFacilityMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT from_entity_code, to_entity_code
        FROM lpp.kg_relationship
        WHERE relationship_type = 'KNOWLEDGE_OWNER_OF'
          AND from_entity_type = 'APP_USER' AND to_entity_type = 'CREDIT_FACILITY'
          AND status = 'ACTIVE'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/user/{FROM_ENTITY_CODE}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:knowledgeOwnerOf ;
        rr:objectMap [ rr:template "https://lpp.example/id/credit-facility/{TO_ENTITY_CODE}" ]
    ] .

# INFORMAL_DEPENDENCY: arbitrary entity → entity. Use a generic IRI namespace
# qualified by entity_type so it resolves into the correct treasury IRI later
# via a downstream CONSTRUCT, if needed.
<#KgInformalDependencyMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT from_entity_type, from_entity_code, to_entity_type, to_entity_code
        FROM lpp.kg_relationship
        WHERE relationship_type = 'INFORMAL_DEPENDENCY' AND status = 'ACTIVE'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/entity/{FROM_ENTITY_TYPE}/{FROM_ENTITY_CODE}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:informalDependency ;
        rr:objectMap [ rr:template "https://lpp.example/id/entity/{TO_ENTITY_TYPE}/{TO_ENTITY_CODE}" ]
    ] .

# NEGOTIATING_HISTORY: Company → Bank.
<#KgNegotiatingHistoryMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT from_entity_code, to_entity_code
        FROM lpp.kg_relationship
        WHERE relationship_type = 'NEGOTIATING_HISTORY' AND status = 'ACTIVE'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/company/{FROM_ENTITY_CODE}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:negotiatingHistory ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank/{TO_ENTITY_CODE}" ]
    ] .

# RM_RELATIONSHIP: User (analyst/treasurer) ↔ Bank.
<#KgRmRelationshipMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT from_entity_code, to_entity_code
        FROM lpp.kg_relationship
        WHERE relationship_type = 'RM_RELATIONSHIP' AND status = 'ACTIVE'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/user/{FROM_ENTITY_CODE}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:rmRelationship ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank/{TO_ENTITY_CODE}" ]
    ] .

# SUPPLIER_SUBSTITUTION_RISK: ThirdParty → ThirdParty (no easy substitute).
<#KgSupplierSubstitutionRiskMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT from_entity_code, to_entity_code
        FROM lpp.kg_relationship
        WHERE relationship_type = 'SUPPLIER_SUBSTITUTION_RISK' AND status = 'ACTIVE'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/third-party/{FROM_ENTITY_CODE}" ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate brain:supplierSubstitutionRisk ;
        rr:objectMap [ rr:template "https://lpp.example/id/third-party/{TO_ENTITY_CODE}" ]
    ] .

# -----------------------------------------------------------------------------
# SME_FEEDBACK_SESSION — PROV-O activity describing when/who taught what.
# -----------------------------------------------------------------------------
<#SmeFeedbackSessionMap>
    rr:logicalTable [ rr:tableName "lpp.sme_feedback_session" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/session/{UUID}" ;
        rr:class    prov:Activity ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [
        rr:predicate prov:wasAssociatedWith ;
        rr:objectMap [ rr:template "https://lpp.example/id/user/{SME_USER}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate prov:startedAtTime ;
        rr:objectMap [ rr:column "STARTED_AT" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate prov:endedAtTime ;
        rr:objectMap [ rr:column "ENDED_AT" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate brain:topic ;
        rr:objectMap [ rr:column "TOPIC" ] ] ;
    rr:predicateObjectMap [ rr:predicate brain:transcriptUri ;
        rr:objectMap [ rr:column "TRANSCRIPT_URI" ; rr:termType rr:IRI ] ] .

# -----------------------------------------------------------------------------
# BRAIN_EVALUATION — observability surface. Per-query record of which tribal
# facts the Brain Retrieval agent surfaced and which edges it traversed.
# Materialize only the scalar fields; SUPER arrays (facts_applied, edges_traversed)
# are exposed through CONSTRUCT against the eval table when needed.
# -----------------------------------------------------------------------------
<#BrainEvaluationMap>
    rr:logicalTable [ rr:tableName "lpp.brain_evaluation" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/brain/eval/{UUID}" ;
        rr:class    brain:Evaluation ;
        rr:graph    <https://lpp.example/graph/treasury/brain>
    ] ;
    rr:predicateObjectMap [ rr:predicate brain:queryText ;
        rr:objectMap [ rr:column "QUERY_TEXT" ] ] ;
    rr:predicateObjectMap [ rr:predicate brain:evaluatedAt ;
        rr:objectMap [ rr:column "EVALUATED_AT" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate brain:expansionHops ;
        rr:objectMap [ rr:column "EXPANSION_HOPS" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate brain:answerSummary ;
        rr:objectMap [ rr:column "ANSWER_SUMMARY" ] ] ;
    rr:predicateObjectMap [
        rr:predicate prov:wasAssociatedWith ;
        rr:objectMap [ rr:template "https://lpp.example/id/user/{USER_CODE}" ]
    ] .

# =============================================================================
# EXTENSIONS #2 — Card acquiring, corporate finance, LCs, pension,
# peer benchmarks, signatory normalization. Backs lpp-schema-extensions-2-redshift.sql
# and unlocks the payments + senior-finance prompts in Prompts_Retail_v_0.1.
# All triples below land in <graph:treasury> unless explicitly graphed elsewhere.
# =============================================================================

# -----------------------------------------------------------------------------
# ACQUIRER & CARD NETWORK
# -----------------------------------------------------------------------------
<#AcquirerMap>
    rr:logicalTable [ rr:tableName "lpp.acquirer" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/acquirer/{CODE}" ;
        rr:class    lpp:Acquirer
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code ; rr:objectMap [ rr:column "CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:name ; rr:objectMap [ rr:column "NAME" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:region ; rr:objectMap [ rr:column "REGION" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:settlementAccount ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank-account/{SETTLEMENT_ACCOUNT_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:affiliatedBank ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank/{BANK_REF}" ]
    ] .

<#AcquirerContractMap>
    rr:logicalTable [ rr:tableName "lpp.acquirer_contract" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/acquirer-contract/{UUID}" ;
