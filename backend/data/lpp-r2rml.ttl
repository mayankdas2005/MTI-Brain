<#CashFlowInLast90Map>
    rr:logicalTable [ rr:sqlQuery """
        WITH maxd AS (SELECT MAX(value_date) AS d FROM lpp.cash_flow)
        SELECT c.uuid FROM lpp.cash_flow c, maxd
        WHERE c.value_date >= maxd.d - INTERVAL '90 days'
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/cash-flow/{UUID}" ] ;
    rr:predicateObjectMap [ rr:predicate lpp:inLast90Days ;
        rr:objectMap [ rr:constant "true" ; rr:datatype xsd:boolean ] ] .

