# =============================================================================
# v0.2 EXTENSIONS — mappings for treasury + payments ontology expansion
#
# Adds mappings for ontology sections A–S that have backing Redshift tables.
# Conventions match the rest of this file:
#   - rr:tableName "LPP.TABLE_NAME" (uppercase) for plain table mappings
#   - rr:sqlQuery """ ... """ (multiline) for filtered subclass mappings
#   - Subject IRIs follow https://lpp.example/id/{kind}/{CODE} (or composite)
#   - Object references use rr:template, not rr:joinCondition
#   - xsd:decimal / xsd:date / xsd:integer / xsd:boolean datatypes applied
# =============================================================================

# =============================================================================
# A. Geography & organization
#
# No standalone region/country/business_unit/department tables exist; the
# country/region attributes are denormalized on BANK_BRANCH and COMPANY. We
# emit lpp:inCountry / lpp:inRegion edges directly from those rows, and
# materialize Region / Country as IRIs derived from the literal codes so
# downstream SPARQL can pivot on them.
#
# LegalEntity is treated as a subclass of Company applied to every row in
# LPP.COMPANY (the schema does not distinguish operating from legal entities).
# =============================================================================

# -----------------------------------------------------------------------------
# COMPANY → inCountry (additive: extends existing CompanyMap)
# -----------------------------------------------------------------------------
<#CompanyGeographyMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT CODE, COUNTRY FROM LPP.COMPANY WHERE COUNTRY IS NOT NULL
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/company/{CODE}" ;
        rr:class    lpp:LegalEntity
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:inCountry ;
        rr:objectMap [ rr:template "https://lpp.example/id/country/{COUNTRY}" ]
    ] .

# -----------------------------------------------------------------------------
# BANK_BRANCH → inCountry + inRegion (extends existing BankBranchMap)
# -----------------------------------------------------------------------------
<#BankBranchGeographyMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT CODE, COUNTRY_CODE, REGION FROM LPP.BANK_BRANCH
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/branch/{CODE}" ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:inCountry ;
        rr:objectMap [ rr:template "https://lpp.example/id/country/{COUNTRY_CODE}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:inRegion ;
        rr:objectMap [ rr:template "https://lpp.example/id/region/{REGION}" ]
    ] .

# Region IRIs (materialized from distinct branch regions).
<#RegionMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT DISTINCT REGION FROM LPP.BANK_BRANCH WHERE REGION IS NOT NULL
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/region/{REGION}" ;
        rr:class    lpp:Region
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code ; rr:objectMap [ rr:column "REGION" ] ] .

# Country IRIs (materialized from distinct country codes seen on companies + branches).
<#CountryMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT DISTINCT COUNTRY AS COUNTRY_CODE FROM LPP.COMPANY
        WHERE COUNTRY IS NOT NULL
        UNION
        SELECT DISTINCT COUNTRY_CODE FROM LPP.BANK_BRANCH
        WHERE COUNTRY_CODE IS NOT NULL
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/country/{COUNTRY_CODE}" ;
        rr:class    lpp:Country
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:countryCode ; rr:objectMap [ rr:column "COUNTRY_CODE" ] ] .

# =============================================================================
# B. Cash balances, positions, sweeps
# =============================================================================

# -----------------------------------------------------------------------------
# BANK_STATEMENT_BALANCE → BalanceSnapshot
# -----------------------------------------------------------------------------
<#BankStatementBalanceMap>
    rr:logicalTable [ rr:tableName "LPP.BANK_STATEMENT_BALANCE" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/balance/{ACCOUNT_REF}-{STATEMENT_DATE}-{BALANCE_TYPE}" ;
        rr:class    lpp:BalanceSnapshot
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:forAccount ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank-account/{ACCOUNT_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "STATEMENT_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:amount ;
        rr:objectMap [ rr:column "AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "QUALITY_STATUS" ] ] .

# Closing / opening / average / available balance subtypes — emitted as the same
# subject so downstream queries can pivot on balance_type or pick the matching
# datatype property directly.
<#ClosingBalanceMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT ACCOUNT_REF, STATEMENT_DATE, BALANCE_TYPE, AMOUNT
        FROM LPP.BANK_STATEMENT_BALANCE WHERE BALANCE_TYPE = 'CLOSING'
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/balance/{ACCOUNT_REF}-{STATEMENT_DATE}-{BALANCE_TYPE}" ] ;
    rr:predicateObjectMap [ rr:predicate lpp:closingBalance ;
        rr:objectMap [ rr:column "AMOUNT" ; rr:datatype xsd:decimal ] ] .

<#OpeningBalanceMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT ACCOUNT_REF, STATEMENT_DATE, BALANCE_TYPE, AMOUNT
        FROM LPP.BANK_STATEMENT_BALANCE WHERE BALANCE_TYPE = 'OPENING'
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/balance/{ACCOUNT_REF}-{STATEMENT_DATE}-{BALANCE_TYPE}" ] ;
    rr:predicateObjectMap [ rr:predicate lpp:openingBalance ;
        rr:objectMap [ rr:column "AMOUNT" ; rr:datatype xsd:decimal ] ] .

<#AvailableBalanceMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT ACCOUNT_REF, STATEMENT_DATE, BALANCE_TYPE, AMOUNT
        FROM LPP.BANK_STATEMENT_BALANCE WHERE BALANCE_TYPE = 'AVAILABLE'
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/balance/{ACCOUNT_REF}-{STATEMENT_DATE}-{BALANCE_TYPE}" ] ;
    rr:predicateObjectMap [ rr:predicate lpp:availableBalance ;
        rr:objectMap [ rr:column "AMOUNT" ; rr:datatype xsd:decimal ] ] .

# -----------------------------------------------------------------------------
# CASH_BALANCE → BalanceSnapshot (rollup view; composite key)
# -----------------------------------------------------------------------------
<#CashBalanceMap>
    rr:logicalTable [ rr:tableName "LPP.CASH_BALANCE" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/cash-balance/{ACCOUNT_REF}-{BALANCE_DATE}-{DATE_BASIS}" ;
        rr:class    lpp:BalanceSnapshot
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:forAccount ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank-account/{ACCOUNT_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "BALANCE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:amount ;
        rr:objectMap [ rr:column "AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ;
        rr:objectMap [ rr:column "CURRENCY_CODE" ] ] .

# -----------------------------------------------------------------------------
# SWEEP_INSTRUCTION → SweepRule
# -----------------------------------------------------------------------------
<#SweepInstructionMap>
    rr:logicalTable [ rr:tableName "LPP.SWEEP_INSTRUCTION" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/sweep-rule/{CODE}" ;
        rr:class    lpp:SweepRule
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code ; rr:objectMap [ rr:column "CODE" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:sourceAccount ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank-account/{SOURCE_ACCOUNT_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:destinationAccount ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank-account/{TARGET_ACCOUNT_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:TargetBalance ;
        rr:objectMap [ rr:column "TARGET_BALANCE" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:minimumThreshold ;
        rr:objectMap [ rr:column "THRESHOLD_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ;
        rr:objectMap [ rr:column "TARGET_BALANCE_CCY" ] ] .

# -----------------------------------------------------------------------------
# SWEEP_EXECUTION → SweepEvent
# -----------------------------------------------------------------------------
<#SweepExecutionMap>
    rr:logicalTable [ rr:tableName "LPP.SWEEP_EXECUTION" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/sweep-event/{UUID}" ;
        rr:class    lpp:SweepEvent
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "EXECUTION_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:amount ;
        rr:objectMap [ rr:column "SWEPT_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "STATUS" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:sourceAccount ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank-account/{SOURCE_ACCOUNT_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:destinationAccount ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank-account/{TARGET_ACCOUNT_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:appliesRule ;
        rr:objectMap [ rr:template "https://lpp.example/id/sweep-rule/{INSTRUCTION_REF}" ]
    ] .

# =============================================================================
# C. Transactions — payments, receipts, intercompany
# =============================================================================

# -----------------------------------------------------------------------------
# CASH_FLOW → Transaction (Receipt / Disbursement subclass from signed_amount sign
# is materialized in two filtered TriplesMaps below)
# -----------------------------------------------------------------------------
<#CashFlowMap>
    rr:logicalTable [ rr:tableName "LPP.CASH_FLOW" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/cash-flow/{UUID}" ;
        rr:class    lpp:Transaction
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:amount ;
        rr:objectMap [ rr:column "FLOW_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ;
        rr:objectMap [ rr:column "FLOW_CURRENCY" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:valueDate ;
        rr:objectMap [ rr:column "VALUE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:tradeDate ;
        rr:objectMap [ rr:column "TRANSACTION_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "STATUS" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:reference ; rr:objectMap [ rr:column "REFERENCE" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:fromAccount ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank-account/{ACCOUNT_REF}" ]
    ] .

# Receipt — signed positive
<#ReceiptMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT UUID FROM LPP.CASH_FLOW WHERE SIGNED_AMOUNT > 0
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/cash-flow/{UUID}" ;
        rr:class    lpp:Receipt
    ] .

# Disbursement — signed negative
<#DisbursementMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT UUID FROM LPP.CASH_FLOW WHERE SIGNED_AMOUNT < 0
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/cash-flow/{UUID}" ;
        rr:class    lpp:Disbursement
    ] .

# -----------------------------------------------------------------------------
# PAYMENT_FILE → PaymentFile
# -----------------------------------------------------------------------------
<#PaymentFileMap>
    rr:logicalTable [ rr:tableName "LPP.PAYMENT_FILE" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/payment-file/{FILE_UUID}" ;
        rr:class    lpp:PaymentFile
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "STATUS" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:throughputCount ;
        rr:objectMap [ rr:column "TOTAL_COUNT" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:throughputValue ;
        rr:objectMap [ rr:column "TOTAL_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ;
        rr:objectMap [ rr:column "TOTAL_CURRENCY" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:originator ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{COMPANY_REF}" ]
    ] .

# -----------------------------------------------------------------------------
# TRANSFER → PaymentTransaction (one row per outbound transfer in a file)
# -----------------------------------------------------------------------------
<#TransferMap>
    rr:logicalTable [ rr:tableName "LPP.TRANSFER" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/transfer/{UUID}" ;
        rr:class    lpp:PaymentTransaction
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:reference ; rr:objectMap [ rr:column "REFERENCE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "STATUS" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:amount ;
        rr:objectMap [ rr:column "AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:valueDate ;
        rr:objectMap [ rr:column "VALUE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:paymentMethod ;
        rr:objectMap [ rr:template "https://lpp.example/id/payment-method/{PAYMENT_RAIL}" ]
    ] .

# Payment-rail subclass discrimination on TRANSFER.payment_rail
<#TransferWireMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT UUID FROM LPP.TRANSFER WHERE PAYMENT_RAIL = 'WIRE'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/transfer/{UUID}" ;
        rr:class    lpp:WireTransfer
    ] .

<#TransferAchMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT UUID FROM LPP.TRANSFER WHERE PAYMENT_RAIL IN ('ACH','SEPA_CT','SEPA_DD')
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/transfer/{UUID}" ;
        rr:class    lpp:AchTransaction
    ] .

<#TransferRtpMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT UUID FROM LPP.TRANSFER WHERE PAYMENT_RAIL = 'RTP'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/transfer/{UUID}" ;
        rr:class    lpp:RtpTransaction
    ] .

<#TransferFedNowMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT UUID FROM LPP.TRANSFER WHERE PAYMENT_RAIL = 'FEDNOW'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/transfer/{UUID}" ;
        rr:class    lpp:FedNowTransaction
    ] .

<#TransferCheckMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT UUID FROM LPP.TRANSFER WHERE PAYMENT_RAIL = 'CHECK'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/transfer/{UUID}" ;
        rr:class    lpp:CheckPayment
    ] .

# -----------------------------------------------------------------------------
# PAYMENT_TRANSACTION → PaymentTransaction (item-level inside a payment file)
# -----------------------------------------------------------------------------
<#PaymentTransactionMap>
    rr:logicalTable [ rr:tableName "LPP.PAYMENT_TRANSACTION" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/payment-txn/{UUID}" ;
        rr:class    lpp:PaymentTransaction
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:reference ; rr:objectMap [ rr:column "END_TO_END_ID" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "STATUS" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:amount ;
        rr:objectMap [ rr:column "AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:tradeDate ;
        rr:objectMap [ rr:column "TRANSACTION_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:valueDate ;
        rr:objectMap [ rr:column "EXECUTION_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:rejectionReason ; rr:objectMap [ rr:column "REASON_CODE" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:paymentMethod ;
        rr:objectMap [ rr:template "https://lpp.example/id/payment-method/{PAYMENT_RAIL}" ]
    ] .

# -----------------------------------------------------------------------------
# INTERCOMPANY_TRANSACTION → IntercompanyTransfer
# -----------------------------------------------------------------------------
<#IntercompanyTransactionMap>
    rr:logicalTable [ rr:tableName "LPP.INTERCOMPANY_TRANSACTION" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/intercompany/{UUID}" ;
        rr:class    lpp:IntercompanyTransfer
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:reference ; rr:objectMap [ rr:column "REFERENCE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:amount ;
        rr:objectMap [ rr:column "AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:tradeDate ;
        rr:objectMap [ rr:column "TRANSACTION_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:valueDate ;
        rr:objectMap [ rr:column "VALUE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "STATUS" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:originator ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{SOURCE_COMPANY_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:beneficiary ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{TARGET_COMPANY_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:fromAccount ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank-account/{SOURCE_ACCOUNT_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:toAccount ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank-account/{TARGET_ACCOUNT_REF}" ]
    ] .

# =============================================================================
# D. Forecasts, variance, scenarios, stress tests
# =============================================================================

# -----------------------------------------------------------------------------
# FORECAST_SNAPSHOT → CashForecast
# -----------------------------------------------------------------------------
<#ForecastSnapshotMap>
    rr:logicalTable [ rr:tableName "LPP.FORECAST_SNAPSHOT" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/forecast/{SNAPSHOT_ID}" ;
        rr:class    lpp:CashForecast
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code ; rr:objectMap [ rr:column "SNAPSHOT_ID" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "SNAPSHOT_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:name ; rr:objectMap [ rr:column "DESCRIPTION" ] ] .

# -----------------------------------------------------------------------------
# FORECAST_CASH_FLOW → ForecastLine
# -----------------------------------------------------------------------------
<#ForecastCashFlowMap>
    rr:logicalTable [ rr:tableName "LPP.FORECAST_CASH_FLOW" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/forecast-line/{UUID}" ;
        rr:class    lpp:ForecastLine
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:forForecast ;
        rr:objectMap [ rr:template "https://lpp.example/id/forecast/{SNAPSHOT_ID}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:forEntity ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{COMPANY_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "FORECAST_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:driverCategory ; rr:objectMap [ rr:column "FLOW_CATEGORY" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] .

# ForecastLine — inflow side
<#ForecastInflowMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT UUID, FORECAST_AMOUNT FROM LPP.FORECAST_CASH_FLOW WHERE DIRECTION = 'IN'
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/forecast-line/{UUID}" ] ;
    rr:predicateObjectMap [ rr:predicate lpp:forecastedInflow ;
        rr:objectMap [ rr:column "FORECAST_AMOUNT" ; rr:datatype xsd:decimal ] ] .

# ForecastLine — outflow side
<#ForecastOutflowMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT UUID, FORECAST_AMOUNT FROM LPP.FORECAST_CASH_FLOW WHERE DIRECTION = 'OUT'
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/forecast-line/{UUID}" ] ;
    rr:predicateObjectMap [ rr:predicate lpp:forecastedOutflow ;
        rr:objectMap [ rr:column "FORECAST_AMOUNT" ; rr:datatype xsd:decimal ] ] .

# -----------------------------------------------------------------------------
# FORECAST_VS_ACTUAL → ForecastActual
# -----------------------------------------------------------------------------
<#ForecastVsActualMap>
    rr:logicalTable [ rr:tableName "LPP.FORECAST_VS_ACTUAL" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/forecast-actual/{COMPANY_REF}-{PERIOD_DATE}-{FLOW_CATEGORY}" ;
        rr:class    lpp:ForecastActual
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:forEntity ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{COMPANY_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "PERIOD_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:driverCategory ; rr:objectMap [ rr:column "FLOW_CATEGORY" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:forecastedOutflow ;
        rr:objectMap [ rr:column "FORECAST_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:actualOutflow ;
        rr:objectMap [ rr:column "ACTUAL_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:varianceAmount ;
        rr:objectMap [ rr:column "VARIANCE_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:variancePct ;
        rr:objectMap [ rr:column "VARIANCE_PCT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ;
        rr:objectMap [ rr:column "CURRENCY_CODE" ] ] .

# -----------------------------------------------------------------------------
# STRESS_SCENARIO → StressTest
# -----------------------------------------------------------------------------
<#StressScenarioMap>
    rr:logicalTable [ rr:tableName "LPP.STRESS_SCENARIO" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/scenario/{CODE}" ;
        rr:class    lpp:StressTest
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code ; rr:objectMap [ rr:column "CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:name ; rr:objectMap [ rr:column "DESCRIPTION" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:scenarioType ; rr:objectMap [ rr:column "SCENARIO_TYPE" ] ] .

# -----------------------------------------------------------------------------
# STRESS_RUN_RESULT → ScenarioAssumption (run output rather than assumption,
# but conceptually closest match in ontology)
# -----------------------------------------------------------------------------
<#StressRunResultMap>
    rr:logicalTable [ rr:tableName "LPP.STRESS_RUN_RESULT" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/stress-run/{UUID}" ;
        rr:class    lpp:ScenarioAssumption
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:underScenario ;
        rr:objectMap [ rr:template "https://lpp.example/id/scenario/{SCENARIO_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:forEntity ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{COMPANY_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "BREACH_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:cashFlowImpact ;
        rr:objectMap [ rr:column "MIN_PROJECTED_CASH" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "BREACH_SEVERITY" ] ] .

# =============================================================================
# E. Debt, facilities, covenants, commercial paper
# =============================================================================

# -----------------------------------------------------------------------------
# CREDIT_FACILITY → CreditFacility (parent class)
# -----------------------------------------------------------------------------
<#CreditFacilityMap>
    rr:logicalTable [ rr:tableName "LPP.CREDIT_FACILITY" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/facility/{CODE}" ;
        rr:class    lpp:CreditFacility
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code ; rr:objectMap [ rr:column "CODE" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:tradedBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{COMPANY_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:lender ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank/{LENDER_BANK_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:hasCurrency ;
        rr:objectMap [ rr:template "https://lpp.example/id/currency/{CURRENCY_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:principalAmount ;
        rr:objectMap [ rr:column "COMMITMENT_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:tradeDate ;
        rr:objectMap [ rr:column "START_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:maturityDate ;
        rr:objectMap [ rr:column "MATURITY_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:expirationDate ;
        rr:objectMap [ rr:column "MATURITY_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:rateBenchmark ;
        rr:objectMap [ rr:column "BENCHMARK_CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:rateSpread ;
        rr:objectMap [ rr:column "SPREAD_BPS" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "STATUS" ] ] .

# Facility subclass discrimination on FACILITY_TYPE
<#RevolvingCreditFacilityMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT CODE FROM LPP.CREDIT_FACILITY WHERE FACILITY_TYPE = 'REVOLVER'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/facility/{CODE}" ;
        rr:class    lpp:RevolvingCreditFacility
    ] .

<#TermLoanMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT CODE FROM LPP.CREDIT_FACILITY WHERE FACILITY_TYPE = 'TERM_LOAN'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/facility/{CODE}" ;
        rr:class    lpp:TermLoan
    ] .

<#BondMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT CODE FROM LPP.CREDIT_FACILITY WHERE FACILITY_TYPE = 'BOND'
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/facility/{CODE}" ;
        rr:class    lpp:Bond
    ] .

<#CommercialPaperProgramMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT CODE FROM LPP.CREDIT_FACILITY WHERE FACILITY_TYPE IN ('CP_PROGRAM','COMMERCIAL_PAPER')
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/facility/{CODE}" ;
        rr:class    lpp:CommercialPaperProgram
    ] .

# -----------------------------------------------------------------------------
# BORROWING → DebtMaturity (each drawdown is a maturity-bearing leg)
# -----------------------------------------------------------------------------
<#BorrowingMap>
    rr:logicalTable [ rr:tableName "LPP.BORROWING" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/borrowing/{UUID}" ;
        rr:class    lpp:DebtMaturity
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:scheduledOn ;
        rr:objectMap [ rr:template "https://lpp.example/id/facility/{FACILITY_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:tradedBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{COMPANY_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:tradeDate ;
        rr:objectMap [ rr:column "DRAWDOWN_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:maturityDate ;
        rr:objectMap [ rr:column "REPAYMENT_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:principalAmount ;
        rr:objectMap [ rr:column "PRINCIPAL_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:drawnAmount ;
        rr:objectMap [ rr:column "PRINCIPAL_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:allInCost ;
        rr:objectMap [ rr:column "ALL_IN_RATE" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "STATUS" ] ] .

# -----------------------------------------------------------------------------
# INTEREST_ACCRUAL — no direct ontology class; surfaced as a debt-instrument
# attribute via the lpp:interestRate / amount properties on the parent borrowing.
# Emitted as a generic resource so downstream queries can correlate.
# -----------------------------------------------------------------------------
<#InterestAccrualMap>
    rr:logicalTable [ rr:tableName "LPP.INTEREST_ACCRUAL" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/interest-accrual/{UUID}"
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "ACCRUAL_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:amount ;
        rr:objectMap [ rr:column "AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] .

# =============================================================================
# F. Hedging, FX rates & exposures
# =============================================================================

# -----------------------------------------------------------------------------
# FX_RATE → FxRate (composite key)
# -----------------------------------------------------------------------------
<#FxRateMap>
    rr:logicalTable [ rr:tableName "LPP.FX_RATE" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/fx-rate/{BASE_CURRENCY}-{QUOTE_CURRENCY}-{RATE_DATE}-{RATE_TYPE}" ;
        rr:class    lpp:FxRate
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:fxRateFrom ;
        rr:objectMap [ rr:template "https://lpp.example/id/currency/{BASE_CURRENCY}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:fxRateTo ;
        rr:objectMap [ rr:template "https://lpp.example/id/currency/{QUOTE_CURRENCY}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "RATE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:fxRate ;
        rr:objectMap [ rr:column "RATE" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:rateType ; rr:objectMap [ rr:column "RATE_TYPE" ] ] .

# -----------------------------------------------------------------------------
# BENCHMARK_RATE → InterestRateBenchmark (skos-style concept, but valued)
# -----------------------------------------------------------------------------
<#BenchmarkRateMap>
    rr:logicalTable [ rr:tableName "LPP.BENCHMARK_RATE" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/benchmark/{BENCHMARK_CODE}-{RATE_DATE}-{TENOR}" ;
        rr:class    lpp:InterestRateBenchmark
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code ; rr:objectMap [ rr:column "BENCHMARK_CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "RATE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:tenor ; rr:objectMap [ rr:column "TENOR" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:interestRate ;
        rr:objectMap [ rr:column "RATE" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] .

# -----------------------------------------------------------------------------
# HEDGE_RELATIONSHIP → HedgePosition
# -----------------------------------------------------------------------------
<#HedgeRelationshipMap>
    rr:logicalTable [ rr:tableName "LPP.HEDGE_RELATIONSHIP" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/hedge/{CODE}" ;
        rr:class    lpp:HedgePosition
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code ; rr:objectMap [ rr:column "CODE" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:tradedBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{COMPANY_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:tradeDate ;
        rr:objectMap [ rr:column "DESIGNATION_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:notionalAmount ;
        rr:objectMap [ rr:column "NOTIONAL_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ;
        rr:objectMap [ rr:column "NOTIONAL_CURRENCY" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "STATUS" ] ] .

# -----------------------------------------------------------------------------
# FX_EXPOSURE_FORECAST → FxExposure
# -----------------------------------------------------------------------------
<#FxExposureForecastMap>
    rr:logicalTable [ rr:tableName "LPP.FX_EXPOSURE_FORECAST" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/fx-exposure/{UUID}" ;
        rr:class    lpp:FxExposure
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:tradedBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{COMPANY_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:exposureCurrency ;
        rr:objectMap [ rr:template "https://lpp.example/id/currency/{EXPOSURE_CURRENCY}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "FORECAST_PERIOD" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:tenor ; rr:objectMap [ rr:column "TENOR_BUCKET" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:grossExposure ;
        rr:objectMap [ rr:column "GROSS_EXPOSURE_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:exposureType ; rr:objectMap [ rr:column "DIRECTION" ] ] .

# -----------------------------------------------------------------------------
# COUNTERPARTY_EXPOSURE → CounterpartyExposure
# -----------------------------------------------------------------------------
<#CounterpartyExposureMap>
    rr:logicalTable [ rr:tableName "LPP.COUNTERPARTY_EXPOSURE" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/cp-exposure/{COUNTERPARTY_BANK_REF}-{AS_OF_DATE}" ;
        rr:class    lpp:CounterpartyExposure
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:counterparty ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank/{COUNTERPARTY_BANK_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "AS_OF_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:amount ;
        rr:objectMap [ rr:column "TOTAL_EXPOSURE" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ;
        rr:objectMap [ rr:column "REPORTING_CURRENCY" ] ] .

# =============================================================================
# G. ERP / ledger reconciliation
# =============================================================================

# -----------------------------------------------------------------------------
# GL_ACCOUNT → (no direct class; emit as ledger node) — minimal IRI mint
# -----------------------------------------------------------------------------
<#GlAccountMap>
    rr:logicalTable [ rr:tableName "LPP.GL_ACCOUNT" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/gl-account/{CODE}"
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code ; rr:objectMap [ rr:column "CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:name ; rr:objectMap [ rr:column "DESCRIPTION" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:ledgerAccount ; rr:objectMap [ rr:column "CODE" ] ] .

# -----------------------------------------------------------------------------
# GL_BALANCE → LedgerEntry (composite key)
# -----------------------------------------------------------------------------
<#GlBalanceMap>
    rr:logicalTable [ rr:tableName "LPP.GL_BALANCE" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/ledger-entry/{GL_ACCOUNT_REF}-{BALANCE_DATE}-{BALANCE_TYPE}" ;
        rr:class    lpp:LedgerEntry
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:ledgerAccount ;
        rr:objectMap [ rr:column "GL_ACCOUNT_REF" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "BALANCE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:amount ;
        rr:objectMap [ rr:column "AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] .

# -----------------------------------------------------------------------------
# GL_RECONCILIATION → ReconciliationItem
# -----------------------------------------------------------------------------
<#GlReconciliationMap>
    rr:logicalTable [ rr:tableName "LPP.GL_RECONCILIATION" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/recon-item/{UUID}" ;
        rr:class    lpp:ReconciliationItem
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "AS_OF_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:discrepancyAmount ;
        rr:objectMap [ rr:column "VARIANCE_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ;
        rr:objectMap [ rr:column "VARIANCE_CURRENCY" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:reconciliationStatus ; rr:objectMap [ rr:column "STATUS" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:ledgerAccount ;
        rr:objectMap [ rr:column "GL_ACCOUNT_REF" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:forAccount ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank-account/{BANK_ACCOUNT_REF}" ]
    ] .

# =============================================================================
# H. Working capital, invoices, vendors, customers
# =============================================================================

# -----------------------------------------------------------------------------
# THIRD_PARTY → Counterparty (with Vendor/Customer subclasses from boolean flags)
# -----------------------------------------------------------------------------
<#ThirdPartyMap>
    rr:logicalTable [ rr:tableName "LPP.THIRD_PARTY" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/third-party/{CODE}" ;
        rr:class    lpp:Counterparty
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code ; rr:objectMap [ rr:column "CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:name ; rr:objectMap [ rr:column "NAME" ] ] .

# Vendor — third_party.creditor = TRUE (we pay them)
<#VendorMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT CODE FROM LPP.THIRD_PARTY WHERE CREDITOR = TRUE
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/third-party/{CODE}" ;
        rr:class    lpp:Vendor
    ] .

# Customer — third_party.debtor = TRUE (they pay us)
<#CustomerMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT CODE FROM LPP.THIRD_PARTY WHERE DEBTOR = TRUE
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/third-party/{CODE}" ;
        rr:class    lpp:Customer
    ] .

# -----------------------------------------------------------------------------
# AR_INVOICE → Receivable
# -----------------------------------------------------------------------------
<#ArInvoiceMap>
    rr:logicalTable [ rr:tableName "LPP.AR_INVOICE" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/ar-invoice/{UUID}" ;
        rr:class    lpp:Receivable
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:reference ; rr:objectMap [ rr:column "INVOICE_NUMBER" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:tradedBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{COMPANY_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:billedTo ;
        rr:objectMap [ rr:template "https://lpp.example/id/third-party/{CUSTOMER_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:invoiceDate ;
        rr:objectMap [ rr:column "ISSUE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:dueDate ;
        rr:objectMap [ rr:column "DUE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:paidDate ;
        rr:objectMap [ rr:column "PAID_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:invoiceAmount ;
        rr:objectMap [ rr:column "INVOICE_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "STATUS" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:paymentTerms ; rr:objectMap [ rr:column "PAYMENT_TERMS" ] ] .

# -----------------------------------------------------------------------------
# AP_INVOICE → Payable
# -----------------------------------------------------------------------------
<#ApInvoiceMap>
    rr:logicalTable [ rr:tableName "LPP.AP_INVOICE" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/ap-invoice/{UUID}" ;
        rr:class    lpp:Payable
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:reference ; rr:objectMap [ rr:column "INVOICE_NUMBER" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:tradedBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{COMPANY_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:billedFrom ;
        rr:objectMap [ rr:template "https://lpp.example/id/third-party/{VENDOR_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:invoiceDate ;
        rr:objectMap [ rr:column "ISSUE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:dueDate ;
        rr:objectMap [ rr:column "DUE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:paidDate ;
        rr:objectMap [ rr:column "PAID_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:invoiceAmount ;
        rr:objectMap [ rr:column "INVOICE_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "STATUS" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:paymentTerms ; rr:objectMap [ rr:column "PAYMENT_TERMS" ] ] .

# -----------------------------------------------------------------------------
# WCF_DOCUMENT → Invoice (working-capital-finance ingested document, e.g.
# supply-chain finance program input)
# -----------------------------------------------------------------------------
<#WcfDocumentMap>
    rr:logicalTable [ rr:tableName "LPP.WCF_DOCUMENT" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/wcf-doc/{UUID}" ;
        rr:class    lpp:Invoice
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:reference ; rr:objectMap [ rr:column "DOCUMENT_NUMBER" ] ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:billedFrom ;
        rr:objectMap [ rr:template "https://lpp.example/id/third-party/{SUPPLIER_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:tradedBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{BUYER_COMPANY}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:invoiceDate ;
        rr:objectMap [ rr:column "ISSUE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:dueDate ;
        rr:objectMap [ rr:column "DUE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:invoiceAmount ;
        rr:objectMap [ rr:column "AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "STATUS" ] ] .

# -----------------------------------------------------------------------------
# WORKING_CAPITAL_METRIC → WorkingCapitalMetric
# -----------------------------------------------------------------------------
<#WorkingCapitalMetricMap>
    rr:logicalTable [ rr:tableName "LPP.WORKING_CAPITAL_METRIC" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/wcm/{COMPANY_REF}-{PERIOD_DATE}" ;
        rr:class    lpp:WorkingCapitalMetric
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:forEntity ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{COMPANY_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "PERIOD_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:dsoDays ;
        rr:objectMap [ rr:column "DSO_DAYS" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:dpoDays ;
        rr:objectMap [ rr:column "DPO_DAYS" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:dioDays ;
        rr:objectMap [ rr:column "DIO_DAYS" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] .

# =============================================================================
# I. Bank fees, rate cards
# =============================================================================

# -----------------------------------------------------------------------------
# BANK_SERVICE_TYPE → FeeServiceType
# -----------------------------------------------------------------------------
<#BankServiceTypeMap>
    rr:logicalTable [ rr:tableName "LPP.BANK_SERVICE_TYPE" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/fee-service/{CODE}" ;
        rr:class    lpp:FeeServiceType
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code ; rr:objectMap [ rr:column "CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:name ; rr:objectMap [ rr:column "DESCRIPTION" ] ] .

# -----------------------------------------------------------------------------
# FEE_RATE_CARD → RateCardLine (one row = one negotiated rate within a card)
# -----------------------------------------------------------------------------
<#FeeRateCardMap>
    rr:logicalTable [ rr:tableName "LPP.FEE_RATE_CARD" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/rate-card-line/{UUID}" ;
        rr:class    lpp:RateCardLine
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:chargedBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank/{BANK_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:feeServiceType ;
        rr:objectMap [ rr:template "https://lpp.example/id/fee-service/{SERVICE_CODE}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:negotiatedRate ;
        rr:objectMap [ rr:column "NEGOTIATED_RATE" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] .

# -----------------------------------------------------------------------------
# BANK_FEE → BankFee
# -----------------------------------------------------------------------------
<#BankFeeMap>
    rr:logicalTable [ rr:tableName "LPP.BANK_FEE" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/bank-fee/{UUID}" ;
        rr:class    lpp:BankFee
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:chargedBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank/{BANK_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:feeServiceType ;
        rr:objectMap [ rr:template "https://lpp.example/id/fee-service/{SERVICE_CODE}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:governedBy ;
        rr:objectMap [ rr:template "https://lpp.example/id/rate-card-line/{RATE_CARD_REF}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:forAccount ;
        rr:objectMap [ rr:template "https://lpp.example/id/bank-account/{BANK_ACCOUNT_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "CHARGE_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:feeAmount ;
        rr:objectMap [ rr:column "CHARGED_AMOUNT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ; rr:objectMap [ rr:column "CURRENCY_CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:exceedsRateCard ;
        rr:objectMap [ rr:column "FLAGGED" ; rr:datatype xsd:boolean ] ] .

# =============================================================================
# J. Payments hub, exceptions — FRAUD_DETECTION_EVENT (the base extension's
# fraud signal, distinct from M.10 FRAUD_LOSS).
# =============================================================================

<#FraudDetectionEventMap>
    rr:logicalTable [ rr:tableName "LPP.FRAUD_DETECTION_EVENT" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/fraud-detection/{UUID}" ;
        rr:class    lpp:FraudLossEvent
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:relatedToTransaction ;
        rr:objectMap [ rr:template "https://lpp.example/id/transfer/{TRANSFER_UUID}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "DECISION" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:fraudCategoryLabel ; rr:objectMap [ rr:column "DECISION" ] ] .

# =============================================================================
# M. Signatories (Person via APP_USER — base BankAccountSignatoryMap already
# emits signer edges; this map mints the Person resources they reference).
# =============================================================================

<#PersonMap>
    rr:logicalTable [ rr:tableName "LPP.APP_USER" ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/user/{CODE}" ;
        rr:class    lpp:Person
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:code ; rr:objectMap [ rr:column "CODE" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:name ; rr:objectMap [ rr:column "FIRST_NAME" ] ] .

# =============================================================================
# UNMAPPED ONTOLOGY CLASSES (no backing table in current schema)
#
# The following ontology classes from v0.2 have no corresponding Redshift table
# in lpp-schema-redshift.sql, lpp-schema-extensions-redshift.sql, or
# lpp-schema-extensions-2-redshift.sql. Leaving them unmapped is intentional —
# extend the schema first, then add TriplesMaps here.
#
# Section A — Geography & organization
#   lpp:BusinessUnit            no table (region/BU lives only as denormalized
#                               columns on BANK_BRANCH and ACQUIRER)
#   lpp:Department              no table
#   lpp:Channel                 no table (channel is a string column on
#                               POS_TRANSACTION/FRAUD_LOSS/MEMBERSHIP_FEE)
#
# Section B — Cash balances, positions, sweeps
#   lpp:CashPosition            no aggregated cash-position table (would need a
#                               new entity_or_region × date materialization)
#
# Section D — Forecasts, variance, scenarios
#   lpp:Scenario (root)         StressTest covered; no generic Scenario table
#   lpp:MacroScenario           covered partly by stress_scenario.scenario_type
#                               but no first-class macro-scenario entity
#
# Section E — Debt
#   lpp:Covenant                no table (covenant terms are not modeled)
#   lpp:CovenantTest            no table
#
# Section F — Hedging
#   lpp:FxOption                no table
#   lpp:InterestRateSwap        no table
#   lpp:CrossCurrencySwap       no table
#   lpp:CommodityHedge          no table
#   lpp:HedgeEffectiveness      no table (only effectiveness_method on
#                               HEDGE_RELATIONSHIP; per-test results not stored)
#   lpp:InterestRateScenario    no table
#
# Section G — ERP reconciliation
#   (all classes mapped: LedgerEntry, ReconciliationItem)
#
# Section H — Working capital
#   lpp:CashApplication         no table
#   lpp:EarlyPaymentDiscount    no table (WCF_DOCUMENT.early_payment_terms_ref
#                               references a non-existent table)
#   lpp:SupplyChainFinanceProgram no table
#   lpp:DynamicDiscountingProgram no table
#   lpp:RebateAgreement         partial: CARD_REBATE_PROGRAM is card-only
#
# Section I — Bank fees
#   lpp:RateCard (header)       only RateCardLine rows exist in FEE_RATE_CARD;
#                               no separate rate-card header
#
# Section J — Payments hub
#   lpp:PaymentBatch            no table (batch concept exists for cards only,
#                               via CARD_SETTLEMENT_BATCH)
#   lpp:PaymentHubEvent         no table
#   lpp:StpMetric               PAYMENT_HUB_THROUGHPUT covers the metric, but
#                               no dedicated StpMetric resource
#
# Section L — Fraud / incidents
#   lpp:OperationalLossEvent    no table
#   lpp:PaymentIncident         no table
#
# Section M — Signatories
#   lpp:Recertification         no table (recert is implicit in
#                               BANK_ACCOUNT_SIGNATORY.last_recertified_date)
#   lpp:AccessControlEvent      no table (audit_trail is generic, not modeled)
#
# Section N — Capital allocation
#   lpp:CapexProgram            no dedicated table (capex flows via
#                               CAPITAL_ALLOCATION_ACTUAL.bucket = 'CAPEX')
#   lpp:Acquisition             no table
#   lpp:ShareRepurchaseProgram  no table (only individual buyback transactions
#                               in EQUITY_ACTION)
#   lpp:DebtPaydown             no dedicated table (paydown rows live in
#                               CAPITAL_ALLOCATION_ACTUAL.bucket='DEBT_PAYDOWN')
#
# Section P — Pension
#   (all classes mapped: PensionPlan, PensionValuation)
#
# Section Q — Peers
#   lpp:Benchmark               no table (PEER_COMPANY_METRIC is metric-row level)
#   lpp:BenchmarkMetric         covered by PEER_COMPANY_METRIC
#   lpp:IndustrySector          no table (sector is a string column on
#                               PEER_COMPANY)
#
# Section R — Macro / risk
#   lpp:VaRMetric               no table
#   lpp:RiskCategory            no table (only fixed SKOS concepts in ontology)
#
# Section S — ESG
#   lpp:SustainabilityLinkedInstrument no table
#   lpp:GreenBond                       no table
#   lpp:SustainabilityLinkedLoan        no table
#   lpp:EsgTarget                       no table
# =============================================================================

# =============================================================================
# v0.3 ROLLUPS — pre-aggregated triples to eliminate query-time scans
#
# These TriplesMaps are *additive*. They do not modify any earlier map; they
# emit new subjects (one per rollup row) plus boolean flag triples on existing
# subjects (sections A.5 and A.6).
#
# Dialect note: Redshift dates use `DATE_TRUNC('month', d)` and `INTERVAL '7
# days'`. All `rr:tableName` values stay uppercase-but-unquoted to match the
# convention; raw `rr:sqlQuery` blocks use lowercase identifiers (Redshift is
# case-insensitive on unquoted identifiers).
#
# Recency window anchor: every "last N days" CTE uses
#   (SELECT MAX(<date_col>) FROM <table>)
# rather than CURRENT_DATE, because the synthetic dataset ends at a fixed
# point (currently 2026-05-04).
# =============================================================================

# -----------------------------------------------------------------------------
# A.1 CARD PAYMENT ROLLUP — (acquirer × network × deposit-date)
#      Source: lpp.card_settlement_batch
# -----------------------------------------------------------------------------
<#CardPaymentRollupMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT
            acquirer_ref                                AS ACQ_CODE,
            network_code                                AS NET_CODE,
            CAST(bank_deposit_ts AS DATE)               AS ROLLUP_DATE,
            SUM(gross_sales_amount)                     AS GROSS_SALES,
            SUM(net_settlement_amount)                  AS NET_SETTLEMENT,
            SUM(interchange_amount)                     AS INTERCHANGE,
            SUM(network_assessment_amount)              AS NETWORK_ASSESS,
            SUM(processor_margin_amount)                AS PROCESSOR_MARGIN,
            COUNT(*)                                    AS BATCH_COUNT
        FROM lpp.card_settlement_batch
        WHERE bank_deposit_ts IS NOT NULL
        GROUP BY 1, 2, 3
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/rollup/card/{ACQ_CODE}-{NET_CODE}-{ROLLUP_DATE}" ;
        rr:class    lpp:CardPaymentRollup
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:viaAcquirer ;
        rr:objectMap [ rr:template "https://lpp.example/id/acquirer/{ACQ_CODE}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:onNetwork ;
        rr:objectMap [ rr:template "https://lpp.example/id/card-network/{NET_CODE}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "ROLLUP_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:grossSalesAmount ;
        rr:objectMap [ rr:column "GROSS_SALES" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:netSettlementAmount ;
        rr:objectMap [ rr:column "NET_SETTLEMENT" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:interchangeAmount ;
        rr:objectMap [ rr:column "INTERCHANGE" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:networkAssessmentAmount ;
        rr:objectMap [ rr:column "NETWORK_ASSESS" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:processorMarginAmount ;
        rr:objectMap [ rr:column "PROCESSOR_MARGIN" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:batchCount ;
        rr:objectMap [ rr:column "BATCH_COUNT" ; rr:datatype xsd:integer ] ] .

# -----------------------------------------------------------------------------
# A.2 PAYMENT METHOD ROLLUP — (payment_rail × value-date)
#      Source: lpp.transfer (file-level outbound payments; carries
#      payment_rail + value_date + status). PAYMENT_TRANSACTION lacks
#      value_date and rail in a uniform way, so transfer is the canonical
#      throughput source per the existing TransferMap convention.
#      success = status IN ('SETTLED','COMPLETED','ACK')
#      repair  = status IN ('REPAIR','REPAIRED','MANUAL_REPAIR')
# -----------------------------------------------------------------------------
<#PaymentMethodRollupMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT
            payment_rail                                                AS METHOD,
            value_date                                                  AS ROLLUP_DATE,
            COUNT(*)                                                    AS TXN_COUNT,
            SUM(amount)                                                 AS TXN_VALUE,
            1.0 * SUM(CASE WHEN status IN ('SETTLED','COMPLETED','ACK')
                           THEN 1 ELSE 0 END) / NULLIF(COUNT(*),0)      AS SUCCESS_RATE,
            1.0 * SUM(CASE WHEN status IN ('REPAIR','REPAIRED','MANUAL_REPAIR')
                           THEN 1 ELSE 0 END) / NULLIF(COUNT(*),0)      AS REPAIR_RATE
        FROM lpp.transfer
        WHERE payment_rail IS NOT NULL AND value_date IS NOT NULL
        GROUP BY 1, 2
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/rollup/method/{METHOD}-{ROLLUP_DATE}" ;
        rr:class    lpp:PaymentMethodRollup
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:paymentMethod ;
        rr:objectMap [ rr:template "https://lpp.example/id/payment-method/{METHOD}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "ROLLUP_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:txnCount ;
        rr:objectMap [ rr:column "TXN_COUNT" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:txnValue ;
        rr:objectMap [ rr:column "TXN_VALUE" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:successRate ;
        rr:objectMap [ rr:column "SUCCESS_RATE" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:repairRate ;
        rr:objectMap [ rr:column "REPAIR_RATE" ; rr:datatype xsd:decimal ] ] .

# -----------------------------------------------------------------------------
# A.3 VENDOR PAYMENT ROLLUP — (vendor × invoice-month)
#      Source: lpp.ap_invoice (already mapped to lpp:Payable, vendor_ref →
#      billedFrom). period_month is rendered as a literal "YYYY-MM" string.
#      on_time = paid_date IS NOT NULL AND paid_date <= due_date
# -----------------------------------------------------------------------------
<#VendorPaymentRollupMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT
            vendor_ref                                              AS VENDOR_CODE,
            TO_CHAR(DATE_TRUNC('month', issue_date), 'YYYY-MM')     AS YEAR_MONTH,
            SUM(invoice_amount)                                     AS TOTAL_BILLED,
            SUM(COALESCE(paid_amount, 0))                           AS TOTAL_PAID,
            1.0 * SUM(CASE WHEN paid_date IS NOT NULL
                            AND paid_date <= due_date THEN 1 ELSE 0 END)
                  / NULLIF(COUNT(*), 0)                             AS ON_TIME_RATE
        FROM lpp.ap_invoice
        WHERE vendor_ref IS NOT NULL AND issue_date IS NOT NULL
        GROUP BY 1, 2
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/rollup/vendor/{VENDOR_CODE}-{YEAR_MONTH}" ;
        rr:class    lpp:VendorPaymentRollup
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:vendor ;
        rr:objectMap [ rr:template "https://lpp.example/id/third-party/{VENDOR_CODE}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:periodMonth ;
        rr:objectMap [ rr:column "YEAR_MONTH" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:totalBilled ;
        rr:objectMap [ rr:column "TOTAL_BILLED" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:totalPaid ;
        rr:objectMap [ rr:column "TOTAL_PAID" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:onTimeRate ;
        rr:objectMap [ rr:column "ON_TIME_RATE" ; rr:datatype xsd:decimal ] ] .

# -----------------------------------------------------------------------------
# A.4 CASH ROLLUP — (entity × currency × statement-date)
#      Source: bank_statement_balance b JOIN bank_account a (company_ref) →
#      company. Filter to BALANCE_TYPE='CLOSING' so we don't double-count
#      opening/available rows. "Entity" here is the bank-account-owning
#      Company (the LPP graph treats Company as the legal-entity stand-in).
#      NOTE: bank_statement_balance.statement_date is the recognised
#      as-of column (the spec used the alias "as_of_date").
# -----------------------------------------------------------------------------
<#CashRollupMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT
            a.company_ref           AS ENTITY_CODE,
            b.currency_code         AS CURRENCY,
            b.statement_date        AS ROLLUP_DATE,
            SUM(b.amount)           AS TOTAL_CASH,
            COUNT(DISTINCT b.account_ref) AS N_ACCOUNTS
        FROM lpp.bank_statement_balance b
        JOIN lpp.bank_account a ON b.account_ref = a.code
        WHERE b.balance_type = 'CLOSING'
        GROUP BY 1, 2, 3
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/rollup/cash/{ENTITY_CODE}-{CURRENCY}-{ROLLUP_DATE}" ;
        rr:class    lpp:CashRollup
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:forEntity ;
        rr:objectMap [ rr:template "https://lpp.example/id/company/{ENTITY_CODE}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:currencyCode ;
        rr:objectMap [ rr:column "CURRENCY" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:asOfDate ;
        rr:objectMap [ rr:column "ROLLUP_DATE" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:totalCash ;
        rr:objectMap [ rr:column "TOTAL_CASH" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:nAccounts ;
        rr:objectMap [ rr:column "N_ACCOUNTS" ; rr:datatype xsd:integer ] ] .

# -----------------------------------------------------------------------------
# A.5 isLatestSnapshot flag — tag the most recent BalanceSnapshot per account
#      Reuses the existing BankStatementBalance subject IRI so no new resource
#      is minted. One row per (account_ref, balance_type) at max date.
# -----------------------------------------------------------------------------
<#BalanceLatestFlagMap>
    rr:logicalTable [ rr:sqlQuery """
        SELECT b.account_ref, b.statement_date, b.balance_type
        FROM lpp.bank_statement_balance b
        JOIN (
            SELECT account_ref, balance_type, MAX(statement_date) AS maxd
            FROM lpp.bank_statement_balance
            GROUP BY 1, 2
        ) m
          ON  b.account_ref  = m.account_ref
          AND b.balance_type = m.balance_type
          AND b.statement_date = m.maxd
    """ ] ;
    rr:subjectMap [
        rr:template "https://lpp.example/id/balance/{ACCOUNT_REF}-{STATEMENT_DATE}-{BALANCE_TYPE}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:isLatestSnapshot ;
        rr:objectMap [ rr:constant "true" ; rr:datatype xsd:boolean ]
    ] .

# -----------------------------------------------------------------------------
# A.6 RECENCY FLAGS — inLast7Days / inLast30Days / inLast90Days / inLastYear
#      Booleans (constant true) emitted only on rows whose dated column falls
#      within the window measured from MAX(date) in the same table.
#      Applied per-table: bank_statement_balance, transfer, payment_transaction,
#      cash_flow, card_settlement_batch, sweep_execution, ar_invoice, ap_invoice.
# -----------------------------------------------------------------------------

# A.6.1 BalanceSnapshot recency
<#BalanceInLast7Map>
    rr:logicalTable [ rr:sqlQuery """
        WITH maxd AS (SELECT MAX(statement_date) AS d FROM lpp.bank_statement_balance)
        SELECT b.account_ref, b.statement_date, b.balance_type
        FROM lpp.bank_statement_balance b, maxd
        WHERE b.statement_date >= maxd.d - INTERVAL '7 days'
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/balance/{ACCOUNT_REF}-{STATEMENT_DATE}-{BALANCE_TYPE}" ] ;
    rr:predicateObjectMap [ rr:predicate lpp:inLast7Days ;
        rr:objectMap [ rr:constant "true" ; rr:datatype xsd:boolean ] ] .

<#BalanceInLast30Map>
    rr:logicalTable [ rr:sqlQuery """
        WITH maxd AS (SELECT MAX(statement_date) AS d FROM lpp.bank_statement_balance)
        SELECT b.account_ref, b.statement_date, b.balance_type
        FROM lpp.bank_statement_balance b, maxd
        WHERE b.statement_date >= maxd.d - INTERVAL '30 days'
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/balance/{ACCOUNT_REF}-{STATEMENT_DATE}-{BALANCE_TYPE}" ] ;
    rr:predicateObjectMap [ rr:predicate lpp:inLast30Days ;
        rr:objectMap [ rr:constant "true" ; rr:datatype xsd:boolean ] ] .

<#BalanceInLast90Map>
    rr:logicalTable [ rr:sqlQuery """
        WITH maxd AS (SELECT MAX(statement_date) AS d FROM lpp.bank_statement_balance)
        SELECT b.account_ref, b.statement_date, b.balance_type
        FROM lpp.bank_statement_balance b, maxd
        WHERE b.statement_date >= maxd.d - INTERVAL '90 days'
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/balance/{ACCOUNT_REF}-{STATEMENT_DATE}-{BALANCE_TYPE}" ] ;
    rr:predicateObjectMap [ rr:predicate lpp:inLast90Days ;
        rr:objectMap [ rr:constant "true" ; rr:datatype xsd:boolean ] ] .

<#BalanceInLastYearMap>
    rr:logicalTable [ rr:sqlQuery """
        WITH maxd AS (SELECT MAX(statement_date) AS d FROM lpp.bank_statement_balance)
        SELECT b.account_ref, b.statement_date, b.balance_type
        FROM lpp.bank_statement_balance b, maxd
        WHERE b.statement_date >= maxd.d - INTERVAL '365 days'
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/balance/{ACCOUNT_REF}-{STATEMENT_DATE}-{BALANCE_TYPE}" ] ;
    rr:predicateObjectMap [ rr:predicate lpp:inLastYear ;
        rr:objectMap [ rr:constant "true" ; rr:datatype xsd:boolean ] ] .

# A.6.2 Transfer recency (subject IRI: https://lpp.example/id/transfer/{UUID})
<#TransferInLast7Map>
    rr:logicalTable [ rr:sqlQuery """
        WITH maxd AS (SELECT MAX(value_date) AS d FROM lpp.transfer)
        SELECT t.uuid FROM lpp.transfer t, maxd
        WHERE t.value_date >= maxd.d - INTERVAL '7 days'
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/transfer/{UUID}" ] ;
    rr:predicateObjectMap [ rr:predicate lpp:inLast7Days ;
        rr:objectMap [ rr:constant "true" ; rr:datatype xsd:boolean ] ] .

<#TransferInLast30Map>
    rr:logicalTable [ rr:sqlQuery """
        WITH maxd AS (SELECT MAX(value_date) AS d FROM lpp.transfer)
        SELECT t.uuid FROM lpp.transfer t, maxd
        WHERE t.value_date >= maxd.d - INTERVAL '30 days'
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/transfer/{UUID}" ] ;
    rr:predicateObjectMap [ rr:predicate lpp:inLast30Days ;
        rr:objectMap [ rr:constant "true" ; rr:datatype xsd:boolean ] ] .

<#TransferInLast90Map>
    rr:logicalTable [ rr:sqlQuery """
        WITH maxd AS (SELECT MAX(value_date) AS d FROM lpp.transfer)
        SELECT t.uuid FROM lpp.transfer t, maxd
        WHERE t.value_date >= maxd.d - INTERVAL '90 days'
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/transfer/{UUID}" ] ;
    rr:predicateObjectMap [ rr:predicate lpp:inLast90Days ;
        rr:objectMap [ rr:constant "true" ; rr:datatype xsd:boolean ] ] .

<#TransferInLastYearMap>
    rr:logicalTable [ rr:sqlQuery """
        WITH maxd AS (SELECT MAX(value_date) AS d FROM lpp.transfer)
        SELECT t.uuid FROM lpp.transfer t, maxd
        WHERE t.value_date >= maxd.d - INTERVAL '365 days'
    """ ] ;
    rr:subjectMap [ rr:template "https://lpp.example/id/transfer/{UUID}" ] ;
    rr:predicateObjectMap [ rr:predicate lpp:inLastYear ;
        rr:objectMap [ rr:constant "true" ; rr:datatype xsd:boolean ] ] .

# A.6.3 PaymentTransaction recency (uses EXECUTION_DATE as the value-date analogue)
