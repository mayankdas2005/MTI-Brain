    ] ;
    rr:predicateObjectMap [
        rr:predicate lpp:withAcquirer ;
        rr:objectMap [ rr:template "https://lpp.example/id/acquirer/{ACQUIRER_REF}" ]
    ] ;
    rr:predicateObjectMap [ rr:predicate lpp:effectiveFrom ;
        rr:objectMap [ rr:column "EFFECTIVE_FROM" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:effectiveTo ;
        rr:objectMap [ rr:column "EFFECTIVE_TO" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:status ; rr:objectMap [ rr:column "CONTRACT_STATUS" ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:processorMarginBps ;
        rr:objectMap [ rr:column "PROCESSOR_MARGIN_BPS" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:settlementLagDays ;
        rr:objectMap [ rr:column "SETTLEMENT_LAG_BUSINESS_DAYS" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate lpp:uptimeSlaPct ;
        rr:objectMap [ rr:column "UPTIME_SLA_PCT" ; rr:datatype xsd:decimal ] ] .

<#CardNetworkMap>
