# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_DB=your_postgres_db

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate a secure secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production

# ─── AWS ───
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2
AWS_BEDROCK_SONNET_ARN=
AWS_BEDROCK_HAIKU_ARN=
AWS_BEDROCK_OPUS_ARN=
AWS_BEDROCK_COHERE_EMBED_V4_ARN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BOTO3_REGION_NAME=
AWS_BOTO3_BUCKET_NAME=

# ─── Fuseki / Knowledge Graph ────────────────────────────────────────────────
FUSEKI_URL=http://localhost:3030
FUSEKI_DATASET=lpp
TRIBAL_GRAPH_URL=http://localhost:3030
TRIBAL_GRAPH_DATASET=tribal