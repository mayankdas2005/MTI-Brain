# ─── .env.example ──────────────────────────────────────────────────────────────
# Secrets only. Copy to .env and fill in real values. NEVER commit .env to git.
#
# All non-secret configuration (timeouts, pool sizes, circuit breaker, log level,
# CORS origins, etc.) lives in config.yml alongside the source code.
#
# Any config.yml value can be overridden here by setting the matching env var.
# Example: uncomment CORS_ORIGINS below to override the config.yml default for
# this specific deployment without editing config.yml.
# ───────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_DB=your_postgres_db

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate a secure secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# ─── SSL (optional) ────────────────────────────────────────────────────────────
# Required when database.ssl_mode in config.yml is verify-ca or verify-full.
# DATABASE_SSL_ROOT_CERT=/path/to/ca.crt

# ─── Deployment overrides (optional) ──────────────────────────────────────────
# Uncomment to override a config.yml default for this deployment.
# ENVIRONMENT=production
# LOG_LEVEL=WARNING
# CORS_ORIGINS=["https://app.yourdomain.com"]
