# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_DB=your_postgres_db

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate a secure secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production

# ─── AWS ───
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2
AWS_BEDROCK_SONNET_ARN=
AWS_BEDROCK_HAIKU_ARN=
AWS_BEDROCK_OPUS_ARN=
AWS_BEDROCK_COHERE_EMBED_V4_ARN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BOTO3_REGION_NAME=
AWS_BOTO3_BUCKET_NAME=

# ─── Langfuse credentials (the LANGFUSE_ENABLED toggle is in config.yaml) ───
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=sk-lf
LANGFUSE_BASE_URL=http://localhost:3100

# ─── Neo4j ───
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DB=neo4j

# ─── AWS Redshift ───
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_HOST=
REDSHIFT_PORT=5433
REDSHIFT_DB=
REDSHIFT_SCHEMA=

# ─── AWS Redshift read-only (regular users — SELECT only) ───
REDSHIFT_READONLY_USER=
REDSHIFT_READONLY_PASSWORD=

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PASSWORD=change_me
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379