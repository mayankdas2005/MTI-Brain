# ─── App ───
ENVIRONMENT=development
LOG_LEVEL=DEBUG
DEBUG=false

# ─── CORS ───
# JSON array or comma-separated list of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000"]

# ─── PostgreSQL (app database) ───
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_postgres_db

# ─── Connection Pool ───
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ─── Circuit Breaker ───
CB_FAIL_MAX=5
CB_RESET_TIMEOUT=30

# ─── SSL ───
DATABASE_SSL_MODE=disable
# DATABASE_SSL_ROOT_CERT=         # path to CA cert when SSL mode is verify-ca or verify-full

# ─── Auth ───
JWT_SECRET=your_jwt_secret_key
