FROM stain/jena-fuseki:latest

ARG JENA_VERSION=5.1.0

USER root

# Install ARQ CLI from the same Jena distribution as Fuseki ships with.
# We re-use the pre-installed Jena under $JENA_HOME (set by base image)
# and only add the bin/ scripts from the full Jena distribution.
RUN apk add --no-cache curl tar

RUN curl -fSL \
  "https://archive.apache.org/dist/jena/binaries/apache-jena-${JENA_VERSION}.tar.gz" \
  -o /tmp/apache-jena-${JENA_VERSION}.tar.gz

RUN ls -lh /tmp/apache-jena-${JENA_VERSION}.tar.gz

RUN tar -xzf /tmp/apache-jena-${JENA_VERSION}.tar.gz -C /opt

RUN ln -s /opt/apache-jena-${JENA_VERSION} /opt/jena-arq

RUN chmod +x /opt/jena-arq/bin/arq

RUN rm -f /tmp/apache-jena-${JENA_VERSION}.tar.gz \
 && apk del curl tar

ENV PATH="/opt/jena-arq/bin:${PATH}"

# Drop back to the non-root user the base image uses
USER fuseki
