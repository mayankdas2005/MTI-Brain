# ─── Langfuse self-hosted — example secrets ───
# Copy to .env and fill in real values. DO NOT commit .env.

NEXTAUTH_SECRET=change_me
SALT=change_me
ENCRYPTION_KEY=change_me

# Public URL used by the UI (EC2 public DNS/IP if accessing remotely)
NEXTAUTH_URL=http://localhost:3100

# ─── Shared Postgres (from /database) — langfuse db credentials ───
LANGFUSE_DB_PASSWORD=change_me

# ─── Internal ClickHouse ───
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=change_me

# ─── Shared Redis (from /database) — must match REDIS_PASSWORD in database/.env ───
REDIS_PASSWORD=change_me

# ─── Internal MinIO ───
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=change_me

# ─── Bootstrap org / project / user (created on first boot only) ───
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# ─── Misc ───
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
