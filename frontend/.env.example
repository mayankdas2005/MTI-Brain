# ─── .env.example ──────────────────────────────────────────────────────────────
# Copy to .env and adjust for your local setup.
# NEXT_PUBLIC_* vars are baked into the browser bundle at build time.
# ───────────────────────────────────────────────────────────────────────────────

# ─── Required ──────────────────────────────────────────────────────────────────
# FastAPI backend base URL.
# Use 127.0.0.1 (not localhost) on Windows to avoid VS Code port forwarding
# intercepting the connection. See README → Known Dev Issues for details.
# If port 8000 is already taken, run the backend on --port 8001 and set this
# to http://127.0.0.1:8001.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ─── Optional ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base path for sub-path routing (e.g. behind a shared proxy at /mti-brain).
# Leave empty or omit for local development (app serves at /).
# NEXT_PUBLIC_BASE_PATH=/mti-brain

# PostHog analytics - omit entirely to disable analytics.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Extra origins for cross-machine HMR (Docker / SSH tunnel dev only).
# NEXT_DEV_ORIGINS=my-alias.local,10.0.0.42
