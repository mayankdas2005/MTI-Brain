# ─── Backend API URL ───
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── App URL ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Okta (planned — not yet active) ───
# These variables are scaffolded for the future Okta OIDC integration.
# The current login flow uses username/password directly against the backend.
NEXT_PUBLIC_OKTA_DOMAIN=your-org.okta.com
NEXT_PUBLIC_OKTA_CLIENT_ID=your-client-id
NEXT_PUBLIC_OKTA_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Dev-only: extra origins for cross-machine HMR ───
# Auto-detected LAN IPs cover most cases (see next.config.mjs).
# Set this only when running `next dev` inside Docker or behind an SSH
# tunnel and opening the page from a different host.
# NEXT_DEV_ORIGINS=my-alias.local,10.0.0.42
